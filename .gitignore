# Node.js dependencies
node_modules/

# Build output
dist/
build/

# Logs
logs/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output/

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-data)
.grunt/

# Bower dependency directory (https://bower.io/)
bower_components/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# MacOS files
.DS_Store

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Miscellaneous
*.log
*.swp
*.swo

# Temporary files
tmp/
temp/

# Yarn Integrity file
.yarn-integrity

# Parcel-bundler cache (https://parceljs.org/)
.cache/

# Next.js build output
.next/

# Nuxt.js build output
.nuxt/

# Gatsby files
.cache/
public/

# Expo files
.expo/

# React Native files
.expo-shared/ 
