@startuml
skinparam classAttributeIconSize 0

class ContractLiquidationScreen {
  fileLiquidation: FileUploader
  btnComplete: Button
  + Show()
  + LoadCalculation()
  + btnComplete_Click()
}

class Contract {
  ContractID: int
  RoomID: int
  Status: string
  DepositAmount: float
  StayDuration: int
  LiquidationFileUrl: string
  + <<static>> LiquidateContract(): bool
}

class ContractDB {
  + <<static>> UpdateStatus(status: string): bool
  + <<static>> UpdateLiquidationFile(path: string): bool
}

class Room {
  RoomID: int
  Status: string
  + <<static>> UpdateRoomStatus(): bool
}

class RoomDB {
  + <<static>> UpdateStatus(status: string): bool
}

class RefundCalculation {
  CalculationID: int
  RequestID: int
  DepositAmount: float
  DamageFee: float
  ExtraDebt: float
  FinalRefundAmount: float
  + <<static>> GetByRequestId(requestId: int): RefundCalculation
}

@enduml
