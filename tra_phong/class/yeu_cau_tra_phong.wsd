@startuml
skinparam classAttributeIconSize 0

class CheckoutRequestScreen {
  dtpCheckoutDate: DateTimePicker
  file: FileUploader
  btnSubmit: Button
  btnCancel: Button
  + Show()
  + btnSubmit_Click()
  + btnCancel_Click()
}

class CheckoutRequest {
  RequestID: int
  ExpectedDate: datetime
  DocumentUrl: string
  Status: string
  CreatedAt: datetime
  + <<static>> CreateRequest(): CheckoutRequest
  + <<static>> CancelRequest(): bool
}

class CheckoutRequestDB {
  + <<static>> Insert(): bool
  + <<static>> RemoveById(requestID: int): bool
}

class Contract {
  ContractID: int
  RoomID: int
  Status: string
  DepositAmount: float
  StayDuration: int
  + <<static>> GetActiveContractByCustomer(customerID: int): Contract
}

class ContractDB {
  + <<static>> GetActiveByCustomer(customerID: int): Contract
}

@enduml
