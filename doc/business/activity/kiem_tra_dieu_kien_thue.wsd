@startuml KiemTraDieuKienThue
title Activity Diagram: Kiểm tra điều kiện thuê

' --- STYLE CONFIGURATION ---
skinparam {
    ActivityBackgroundColor White
    ActivityBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 12
    Padding 5

    ' Swimlane styling
    SwimlaneBorderColor #2D3E50
    SwimlaneTitleBackgroundColor #F1F3F5
    SwimlaneTitleFontSize 13
    SwimlaneTitleFontColor #2D3E50
    
    ' Note styling
    NoteBackgroundColor #FFF9C4
    NoteBorderColor #FBC02D
    NoteFontSize 11
}

' --- SWIMLANES ---
|#D1E9FF|Nhân viên Sale|
|#D6FFD6|Nhân viên Quản lý|


|Nhân viên Sale|
start
:Kiểm tra thông tin khách hàng;

if (Thoả tiêu chí thuê?) then (Không)
    :Từ chối cho thuê;
    stop
else (Có)
endif

:Kiểm tra tình trạng phòng;
note right
    phòng (đọc)
    giường (đọc)
    trạng thái (đọc)
end note

|Nhân viên Quản lý|
:Kiểm tra điều kiện phòng;
note right
    phòng (đọc)
    giường (đọc)
    trạng thái (đọc)
end note

if (Phòng/giường đã được giữ chỗ hay đã đặt cọc?) then (Có)
    :Thông báo cho nhân viên sale không thể thuê phòng;
else (Không)
    :Thông báo cho nhân viên sale phòng/giường có thể được thuê;
endif


stop
@enduml