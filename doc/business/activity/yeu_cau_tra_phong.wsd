@startuml
title Activity Diagram: Yêu cầu trả phòng

' General config
skinparam activity {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
skinparam swimlane {
    BorderColor Black
}

' Swimlanes
|#LightBlue|Khách hàng|
|#OldLace|Nhân viên Sale|
|#LightBlue|Nhân viên Quản lý|
|#OldLace|Nhân viên Kế toán|
|#White|Others|

' Start
|Khách hàng|
start
:Yêu cầu trả phòng;

|Nhân viên Sale|
:Tiếp nhận yêu cầu trả phòng;

if (Khách đổi ý không trả phòng?) then (Có)
    :Ghi nhận hủy yêu cầu;
    stop
else (Không)
    :Đăng ký thời gian trả phòng;
endif

|Khách hàng|
:Cung cấp hợp đồng/phiếu đặt cọc;
note right
        Hợp đồng (ghi)
        Phiếu đặt cọc (ghi)
end note

|Nhân viên Sale|
if (Cung cấp được hợp đồng/phiếu cọc?) then (Không)
    :Yêu cầu cung cấp thông tin cá nhân;
    :Đối soát trên hệ thống;
    note right
        Hợp đồng (đọc)
        Phiếu đặt cọc (đọc)
    end note
    if (Tìm thấy dữ liệu?) then (Không)
        :Thông báo không đủ điều kiện;
        stop
    else (Có)
    endif
else (Có)
endif

|Others|
:Thực hiện nghiệp vụ \n"Tính khoản hoàn cọc và khấu trừ";
:Thực hiện nghiệp vụ \n"Thanh lý hợp đồng";

|Nhân viên Quản lý|
:Thu hồi chìa khóa/thẻ từ;
:Cập nhật thông tin bàn giao tài sản \nvà xác nhận kết thúc lưu trú;
:Ghi nhận phòng/giường là trống;
stop

@enduml
