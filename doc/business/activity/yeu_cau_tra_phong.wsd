@startuml Activity_YeuCauTraPhong
title Activity Diagram: Yêu cầu trả phòng

' --- STYLE CONFIGURATION ---
skinparam {
    ActivityBackgroundColor White
    ActivityBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5

    ' Swimlane styling
    SwimlaneBorderColor #2D3E50
    SwimlaneTitleBackgroundColor #F1F3F5
    SwimlaneTitleFontSize 24
    SwimlaneTitleFontColor #2D3E50
    
    ' Note styling
    NoteBackgroundColor #FFF9C4
    NoteBorderColor #FBC02D
    NoteFontSize 24
}

' --- SWIMLANES ---
|#FFE7D9|Khách hàng|
|#D1E9FF|Nhân viên Sale|
|#D6FFD6|Nhân viên Quản lý|
|#FFF5D1|Nhân viên Kế toán|
|#F0F0F0|Others|


' Start
|Khách hàng|
start
:Yêu cầu trả phòng;

|Nhân viên Sale|
:Tiếp nhận yêu cầu trả phòng;

if (Khách đổi ý không trả phòng?) then (Có)
    :Ghi nhận hủy yêu cầu;
    stop
else (Không)
    :Đăng ký thời gian trả phòng;
endif

|Khách hàng|
:Cung cấp hợp đồng/phiếu đặt cọc;

|Nhân viên Sale|
if (Cung cấp được hợp đồng/phiếu cọc?) then (Không)
    :Đối soát trên hệ thống;
    note right
        Hợp đồng (đọc)
        Phiếu đặt cọc (đọc)
    end note
    if (Tìm thấy dữ liệu?) then (Không)
        :Thông báo không đủ điều kiện;
        stop
    else (Có)
    endif
else (Có)
endif

|Others|
:Thực hiện nghiệp vụ \n"Tính khoản hoàn cọc và khấu trừ";
:Thực hiện nghiệp vụ \n"Thanh lý hợp đồng";

|Nhân viên Quản lý|
:Thu hồi chìa khóa/thẻ từ;
:Cập nhật thông tin bàn giao tài sản \nvà xác nhận kết thúc lưu trú;
note right
  Hợp đồng (ghi)
end note
:Ghi nhận phòng/giường là trống;
note right
  Phòng/giường (ghi)
end note
stop

@enduml