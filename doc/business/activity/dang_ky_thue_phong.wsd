@startuml Activity_DangKyThuePhong
title UC: Đăng ký thuê phòng

' --- STYLE CONFIGURATION ---
skinparam {
    ActivityBackgroundColor White
    ActivityBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 12
    Padding 5

    ' Swimlane styling
    SwimlaneBorderColor #2D3E50
    SwimlaneTitleBackgroundColor #F1F3F5
    SwimlaneTitleFontSize 13
    SwimlaneTitleFontColor #2D3E50
    
    ' Note styling
    NoteBackgroundColor #FFF9C4
    NoteBorderColor #FBC02D
    NoteFontSize 11
}

' --- SWIMLANES ---
|#FFE7D9|Khách hàng|
|#D1E9FF|Nhân viên Sale|
|#F0F0F0|Others|


|Nhân viên Sale|
start
:1. Tiếp nhận khách hàng;

repeat
    :2. Yêu cầu cung cấp thông tin cá nhân (CCCD, SĐT,...);
    |Khách hàng|
    :Cung cấp thông tin cá nhân;
    note right #LightYellow: **[Ghi]**\nThông tin cá nhân
    
    |Nhân viên Sale|
    :3. Nhận và kiểm tra thông tin;
    if (Thông tin hợp lệ?) then (Không - A3)
        if (Nhiều lần không hợp lệ?) then (Có)
            :Thông báo hủy và kết thúc;
            stop
        else (Không)
        endif
    else (Có)
    endif
repeat while (Thông tin hợp lệ?) is (Không)
-> [Có];

repeat
    |Nhân viên Sale|
    :4. Yêu cầu cung cấp các yêu cầu cơ bản về phòng;
    |Khách hàng|
    :5. Nhập và cung cấp yêu cầu cơ bản;
    note right #LightYellow: **[Ghi]**\nPhiếu yêu cầu thuê phòng (Draft)

    repeat
        |Others|
        :6. << Thực hiện UC: Xác định và lựa chọn phòng >>;

        |Nhân viên Sale|
        if (Kết quả xác định phòng? - A6) then (Thất bại)
            :Thông báo lý do thất bại;
            stop
        else (Thành công)
        endif

        :7. Ghi nhận lại thông tin đăng ký;
        note right #LightYellow: **[Ghi]**\nHồ sơ đăng ký thuê phòng

        if (Khách có ý định xem phòng? - A8) then (Không)
            :Thông báo thành công và kết thúc;
            stop
        else (Có)
        endif

        :8. Sắp xếp lịch xem phòng;
        :9. Thông báo lịch hẹn xem phòng (Email/SĐT);
        note right #LightYellow: **[Ghi]**\nLịch hẹn xem phòng

        |Others|
        :10. << Thực hiện UC: Xem phòng >>;

        |Nhân viên Sale|
        if (Kết quả xem phòng? - A10) then (Thất bại lý do khác - A10c)
            :Thông báo hủy và kết thúc;
            stop
        elseif (Không đồng ý thông tin cơ bản - A10a) then (Có)
            :Thêm điều kiện đó vào yêu cầu của khách;
        elseif (Muốn điều chỉnh yêu cầu - A10b) then (Có)
            ' Bỏ qua để vòng lặp ngoài bắt điều kiện
        else (Thành công)
            :11. Kết thúc Usecase;
            stop
        endif

    |Nhân viên Sales|
    backward: Thực hiện lại Bước 6;
    repeat while (Không ưng ý thông tin cơ bản (A10a)?) is (Có)
    -> [Không];

|Nhân viên Sales|
backward: Thực hiện lại Bước 4;
repeat while (Khách muốn điều chỉnh yêu cầu (A10b)?) is (Có)
-> [Không];
stop
@enduml