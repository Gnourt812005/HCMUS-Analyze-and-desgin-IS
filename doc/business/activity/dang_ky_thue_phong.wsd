@startuml Activity Diagram: Quy trình Đăng ký & Lựa chọn Thuê phòng
title Activity Diagram: Quy trình Đăng ký Thuê phòng

' --- CẤU HÌNH GIAO DIỆN ---
skinparam activity {
    BackgroundColor LightSkyBlue
    BorderColor RoyalBlue
    ArrowColor DimGray
}
skinparam swimlane {
    BorderColor RoyalBlue
    TitleBackgroundColor LightSteelBlue
}

' --- KHAI BÁO SWIMLANES ---
|#HoneyDew|Khách hàng|
|#WhiteSmoke|Nhân viên Sales|

' --- BẮT ĐẦU QUY TRÌNH ---
|Khách hàng|
start
:Liên hệ đăng ký thuê phòng; 

|Nhân viên Sales|
:Tiếp nhận khách hàng; 

' --- VALIDATION LOOP (A3) ---
repeat
    :Yêu cầu cung cấp thông tin cá nhân; 
    |Khách hàng|
    :Cung cấp CCCD, SĐT...; 
    |Nhân viên Sales|
    :Kiểm tra thông tin; 
repeat while (Thông tin hợp lệ?) is (Không)
-> [Có];

' --- LABEL: ĐIỂM QUAY LẠI KHI THAY ĐỔI YÊU CẦU (A10.b) ---
label lab_ChangeReq

:Yêu cầu cung cấp tiêu chí phòng; 
|Khách hàng|
:Cung cấp yêu cầu (Giá, khu vực...); 

' --- LABEL: ĐIỂM QUAY LẠI KHI KHÔNG ƯNG THÔNG TIN PHÒNG (A10.a) ---
label lab_SelectRoom

' --- SUB-PROCESS: XÁC ĐỊNH & LỰA CHỌN PHÒNG ---
partition "UC: Xác định và lựa chọn phòng" {
    |Nhân viên Sales|
    :Lấy danh sách phòng trống;
    :Đối chiếu điều kiện bắt buộc & ưu tiên;
    
    if (Tìm được phòng phù hợp?) then (Không)
        :Thông báo thất bại;
        stop
    else (Có)
        :Tổng hợp và Trình bày danh sách;
    endif
    
    |Khách hàng|
    :Chọn phòng/giường muốn thuê;
    
    |Nhân viên Sales|
    if (Khách chốt chọn phòng?) then (Không)
        :Tư vấn hoặc Kết thúc;
        stop
    else (Có)
        :Xác nhận lựa chọn tạm thời;
    endif
}

' --- QUY TRÌNH CHÍNH TIẾP TỤC ---
:Ghi nhận thông tin đăng ký; 

if (Khách có nhu cầu xem phòng?) then (Không)
    :Thông báo thành công; 
    stop
else (Có)
    :Sắp xếp lịch xem phòng; 
    :Thông báo lịch hẹn (Email/SĐT); 
endif

' --- SUB-PROCESS: XEM PHÒNG ---
partition "UC: Xem phòng" {
    |Nhân viên Sales|
    :Tiếp đón tại điểm hẹn;
    :Giới thiệu thông tin, nội quy, hình thức thuê;
    :Xác nhận ý định thuê;
}

' --- XỬ LÝ KẾT QUẢ SAU KHI XEM (A10) ---
|Khách hàng|
if (Quyết định thuê?) then (Đồng ý)
    stop
else (Không đồng ý / Điều chỉnh)
    |Nhân viên Sales|
    ' A10.a: Không đồng ý thông tin cơ bản -> Quay lại chọn phòng
    if (Lý do: Không ưng thông tin cơ bản?) then (Đúng)
        :Thêm điều kiện vào yêu cầu; 
        goto lab_SelectRoom
    ' A10.b: Muốn điều chỉnh yêu cầu -> Quay lại bước nhập yêu cầu
    elseif (Lý do: Muốn điều chỉnh yêu cầu?) then (Đúng)
        goto lab_ChangeReq
    else (Lý do khác/Huỷ)
        :Thông báo hủy đăng ký; 
        stop
    endif
endif

@enduml