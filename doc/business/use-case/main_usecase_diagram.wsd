@startuml BusinessUsecase
title HomeStay Dorm Business Use Case Diagram
skinparam packageStyle rectangle

' Direction
left to right direction

' Define B.Actors
actor/ "Khách hàng" as customer

rectangle "Hệ thống Homestay Dorm" {
	rectangle "Quy trình đăng ký thuê phòng" {
		usecase/ "Đăng ký thuê phòng" as UC_DangKyThuePhong <<UC01>>
		usecase/ "Xác định và chọn phòng" as UC_XacDinhVaChonPhong <<UC02>>
		usecase/ "Xem phòng" as UC_XemPhong <<UC03>>

		' Use Case Relationships
		UC_DangKyThuePhong ..> UC_XacDinhVaChonPhong : <<include>>
		UC_DangKyThuePhong <.. UC_XemPhong : <<extend>>
	}

	rectangle "Quy trình thuê phòng" {
		usecase/ "Xác nhận thuê" as UC_XacNhanThue <<UC04>>
		usecase/ "Kiểm tra điều kiện thuê" as UC_KiemTraDieuKienThue <<UC05>>
		usecase/ "Thực hiện đặt cọc" as UC_ThucHienDatCoc <<UC06>>

		' Use Case Relationships
		UC_XacNhanThue ..> UC_KiemTraDieuKienThue : <<include>>
		UC_XacNhanThue ..> UC_ThucHienDatCoc : <<include>>
	}

	rectangle "Quy trình nhận phòng, ký thoả thuận thuê và bàn giao phòng" {
		usecase/ "Xử lý nhận phòng" as UC_XuLyNhanPhong <<UC07>>
		usecase/ "Lập hợp đồng" as UC_KyHopDong <<UC08>>
		usecase/ "Bàn giao phòng" as UC_BanGiaoPhong <<UC09>>

		' Use Case Relationships
		UC_XuLyNhanPhong ..> UC_KyHopDong : <<include>>
		UC_XuLyNhanPhong ..> UC_BanGiaoPhong : <<include>>
	}

	rectangle "Quy trình trả phòng và hoàn cọc" {
		usecase/ "Yêu cầu trả phòng" as UC_YeuCauTraPhong <<UC10>>
		usecase/ "Tính khoản hoàn cọc và khấu trừ" as UC_TinhHoanCocKhauTru <<UC11>>
		usecase/ "Thanh lý hợp đồng" as UC_ThanhLyHopDong <<UC12>>

		' Use Case Relationships
		UC_YeuCauTraPhong ..> UC_TinhHoanCocKhauTru : <<include>>
		UC_YeuCauTraPhong ..> UC_ThanhLyHopDong : <<include>>
	}
}


' Actor - Main Use Cases Associations
customer -- UC_DangKyThuePhong
customer -- UC_XacNhanThue
customer -- UC_XuLyNhanPhong
customer -- UC_YeuCauTraPhong

@enduml
