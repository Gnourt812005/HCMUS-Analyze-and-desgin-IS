@startuml HomeStay Dorm
title HomeStay Dorm Business Use Case Diagram
skinparam packageStyle rectangle

' Direction
left to right direction

' Define B.Actors
actor/ "Khách hàng" as customer


rectangle "Quy trình đăng ký thuê phòng" {
	usecase/ "Đăng ký thuê phòng" as UC_DangKyThuePhong
	usecase/ "Xác định và chọn phòng" as UC_XacDinhVaChonPhong
	usecase/ "Xem phòng" as UC_XemPhong

	' Use Case Relationships
	UC_DangKyThuePhong ..> UC_XacDinhVaChonPhong : <<include>>
	UC_XemPhong ..> UC_DangKyThuePhong : <<extend>>
}

rectangle "Quy trình thuê phòng" {
	usecase/ "Xác nhận thuê" as UC_XacNhanThue
	usecase/ "Kiểm tra điều kiện thuê" as UC_KiemTraDieuKienThue
	usecase/ "Thực hiện đặt cọc" as UC_ThucHienDatCoc

	' Use Case Relationships
	UC_XacNhanThue ..> UC_KiemTraDieuKienThue : <<include>>
	UC_XacNhanThue ..> UC_ThucHienDatCoc : <<include>>
}

rectangle "Quy trình trả phòng và hoàn cọc" {
	usecase/ "Yêu cầu trả phòng" as UC_YeuCauTraPhong
	usecase/ "Tính khoản hoàn cọc và khấu trừ" as UC_TinhHoanCocKhauTru
	usecase/ "Thanh lý hợp đồng" as UC_ThanhLyHopDong

	' Use Case Relationships
	UC_YeuCauTraPhong ..> UC_TinhHoanCocKhauTru : <<include>>
	UC_YeuCauTraPhong ..> UC_ThanhLyHopDong : <<include>>
}

' Actor - Main Use Cases Associations
customer -- UC_DangKyThuePhong
customer -- UC_XacNhanThue
customer -- UC_YeuCauTraPhong

@enduml
