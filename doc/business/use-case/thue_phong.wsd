@startuml BusinessUsecase
skinparam packageStyle rectangle

' Direction
left to right direction

' Define B.Actors
actor/ "Khách hàng" as customer

rectangle "Quy trình thuê phòng" {
  usecase/ "Xác nhận thuê" as UC_XacNhanThue <<UC04>>
  usecase/ "Kiểm tra điều kiện thuê" as UC_KiemTraDieuKienThue <<UC05>>
  usecase/ "Thực hiện đặt cọc" as UC_ThucHienDatCoc <<UC06>>

  ' Use Case Relationships
  UC_XacNhanThue ..> UC_KiemTraDieuKienThue : <<include>>
  UC_XacNhanThue ..> UC_ThucHienDatCoc : <<include>>
}

' Actor - Main Use Cases Associations
customer -- UC_XacNhanThue

@enduml
