@startuml Main_UseCaseDiagram
title HomeStay Dorm Business Use Case Diagram
skinparam packageStyle rectangle

' --- SETUP LAYOUT ---
' skinparam linetype ortho
' skinparam nodesep 60
' skinparam ranksep 80
' skinparam wrapWidth 200
' --- STYLE CONFIGURATION ---
skinparam {
    DefaultFontSize 24
}


skinparam nodesep 50
skinparam ranksep 60
skinparam wrapWidth 200

' Direction
left to right direction

' Define B.Actors
actor "Khách hàng" as customer #B2EBF2
actor "Nhân viên sale" as employee_sale #C8E6C9
actor "Nhân viên quản lý chi nhánh" as employee_manager #FFE082
actor "Admin" as admin #FFCDD2
actor "User" as user #F2F2F2

customer -|> user
employee_sale -|> user
employee_manager -|> user
admin -|> user

' Entity Managment Use-case'Họ và tên
' Admin Use-case'

rectangle "Màn hình chung" #F2F2F2 {
  usecase "Đăng nhập" as UC_DangNhap <<UC12>> #F2F2F2;line:gray
  usecase "Đăng xuất" as UC_DangXuat <<UC13>> #F2F2F2;line:gray
  usecase "Quản lý thông tin cá nhân" as UC_QuanLyThongTinCaNhan <<UC27>> #F2F2F2;line:gray
  usecase "Xem danh sách phòng" as UC_XemDanhSachPhong <<UC1>> #F2F2F2;line:gray
  usecase "Xem chi tiết phòng" as UC_XemChiTietPhong <<UC2>> #F2F2F2;line:gray

  user -- UC_DangNhap
  UC_DangNhap <.. UC_DangXuat: <<extend>>
  UC_DangNhap <.. UC_QuanLyThongTinCaNhan: <<extend>>
  user -- UC_XemDanhSachPhong
  UC_XemDanhSachPhong <.. UC_XemChiTietPhong: <<extend>>
}

rectangle "Màn hình của nhân viên quản lý chi nhánh và admin " #FFE082 {
  usecase "Lập biên bản bàn giao phòng" as UC_LapBienBanBanGiaoPhong <<UC21>> #FFE082;line:Orange
  usecase "Xem yêu cầu trả phòng" as UC_XemYeuCauTraPhong <<UC23>> #FFE082;line:Orange
  usecase "Thanh lý hợp đồng" as UC_ThanhLyHopDong <<UC25>> #FFE082;line:Orange
  usecase "Quản lý hợp đồng khách hàng" as UC_QuanLyHopDongKH <<UC30>> #FFE082;line:Orange
  usecase "Quản lý phòng" as UC_QuanLyPhong <<UC19>> #FFE082;line:Orange


  UC_DangNhap <.. UC_LapBienBanBanGiaoPhong: <<extend>>
  UC_LapBienBanBanGiaoPhong <.. UC_XemYeuCauTraPhong: <<extend>>
  UC_XemYeuCauTraPhong <.. UC_ThanhLyHopDong: <<extend>>
  UC_DangNhap <.. UC_QuanLyHopDongKH: <<extend>>
}

rectangle "Màn hình của nhân viên sale" #C8E6C9 {
  usecase "Quản lý đơn đăng ký xem phòng" as UC_QuanLyDonDangKyXemPhong <<UC8>> #C8E6C9;line:Green
  usecase "Dời đơn đăng ký xem phòng" as UC_DoiDonDangKyXemPhong <<UC10>> #C8E6C9;line:Green
  usecase "Tạo đơn đăng ký xem phòng" as UC_TaoDonDangKyXemPhong <<UC9>> #C8E6C9;line:Green

  UC_DangNhap <.. UC_QuanLyDonDangKyXemPhong: <<extend>>
  UC_QuanLyDonDangKyXemPhong <.. UC_DoiDonDangKyXemPhong: <<extend>>
  UC_QuanLyDonDangKyXemPhong <.. UC_TaoDonDangKyXemPhong: <<extend>>
  UC_DangNhap <.. UC_QuanLyPhong: <<extend>>
}

' Customer sub-system'
rectangle "Màn hình của khách hàng" #B2EBF2 {
  usecase "Đăng ký tài khoản" as UC_DangKy <<UC11>> #B2EBF2;line:CadetBlue
  usecase "Đăng ký xem phòng" as UC_DangKyXemPhong <<UC3>> #B2EBF2;line:CadetBlue
  usecase "Đặt cọc" as UC_DatCoc <<UC14>> #B2EBF2;line:CadetBlue
  usecase "Kiểm tra điều kiện thuê" as UC_KiemTraDieuKienThue <<UC15>> #B2EBF2;line:CadetBlue

  usecase "Yêu cầu trả phòng" as UC_YeuCauTraPhong <<UC22>> #B2EBF2;line:CadetBlue
  usecase "Thanh toán" as UC_ThanhToan <<UC16>> #B2EBF2;line:CadetBlue

  usecase "Thuê" as UC_Thue <<UC28>> #B2EBF2;line:CadetBlue
  usecase "Quản lý hợp đồng" as UC_QuanLyHopDong <<UC20>> #B2EBF2;line:CadetBlue
  usecase "Quản lý phòng đã quan tâm" as UC_QuanLyPhongDaQuanTam <<UC7>> #B2EBF2;line:CadetBlue
  usecase "Quản lý lịch xem phòng" as UC_QuanLyLichXemPhong <<UC4>> #B2EBF2;line:CadetBlue
  usecase "Quan tâm phòng" as UC_QuanTamPhong <<UC6>> #B2EBF2;line:CadetBlue

  customer -- UC_DangKy

  UC_DangNhap <.. UC_DatCoc: <<extend>>
  UC_DatCoc <.. UC_KiemTraDieuKienThue: <<include>>
  UC_DatCoc <.. UC_ThanhToan: <<include>>

  UC_DangNhap <.. UC_Thue: <<extend>>
  UC_Thue <.. UC_ThanhToan: <<include>>
  UC_Thue <.. UC_KiemTraDieuKienThue: <<include>>

  UC_DangNhap <.. UC_YeuCauTraPhong: <<extend>>
  UC_DangNhap <.. UC_QuanLyHopDong: <<extend>>
  UC_DangNhap <.. UC_QuanLyPhongDaQuanTam: <<extend>>
  UC_DangNhap <.. UC_QuanLyLichXemPhong: <<extend>>
  UC_DangNhap <.. UC_DangKyXemPhong: <<extend>>
  UC_DangNhap <.. UC_QuanTamPhong: <<extend>>
  UC_XemChiTietPhong <.. UC_QuanTamPhong: <<extend>>
}

' usecase "Xử lý nhận phòng" as UC_XuLyNhanPhong

' usecase "Tính khoản hoàn cọc và khấu trừ" as UC_TinhHoanCocKhauTru

' Actor - Main Use Cases Associations

rectangle "Màn hình ADMIN quản lý" #FFCDD2 {
  usecase "Quản lý ký túc xá" as UC_QuanLyKyTucXa <<UC18>> #FFCDD2;line:Red
  usecase "Quản lý nhân viên" as UC_QuanLyNhanVien <<UC17>> #FFCDD2;line:Red
  usecase "Quản lý tiện ích" as UC_QuanLyTienIch <<UC29>> #FFCDD2;line:Red

  UC_DangNhap <.. UC_QuanLyKyTucXa: <<extend>>
  UC_DangNhap <.. UC_QuanLyNhanVien: <<extend>>
  UC_DangNhap <.. UC_QuanLyTienIch: <<extend>>
}

@enduml
