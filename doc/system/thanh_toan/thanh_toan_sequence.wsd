@startuml ThanhToan_SequenceDiagram

title Sequence Diagram - Thanh toán (UC15)

autonumber

actor "Customer" as Actor
boundary "ScreenPayment" as GUI <<boundary>>
control "Payment" as BUS <<control>>
database "PaymentDB" as DB <<database>>

Actor -> GUI : Nhấn nút thanh toán
GUI -> BUS : getPaymentDetails()
BUS --> GUI : Hiển thị tiền cọc & tiền phòng

Actor -> GUI : Chọn phương thức thanh toán (Ngân hàng/Ví điện tử)
GUI -> BUS : createPaymentCode(method)

alt Lỗi khởi tạo mã
    BUS --> GUI : Lỗi hệ thống
    GUI --> Actor : Thông báo lỗi & Thử lại
else Thành công
    BUS --> GUI : Hiển thị mã QR
    
    alt Khách hàng hủy/không quét mã
        Actor -> GUI : Không có hành động thanh toán
        GUI --> Actor : Hiển thị thông báo "Thử lại?"
    else Quét mã QR
        Actor -> GUI : Quét mã và hoàn tất trên App Ngân hàng
        GUI -> BUS : verifyTransaction()
        
        alt Không nhận được phản hồi từ Ngân hàng
            BUS --> GUI : Hết thời gian chờ (timeout)
            GUI --> Actor : Thông báo lỗi kết nối
        else Thành công
            BUS -> DB : saveInvoice(invoiceId, date)
            DB --> BUS : Thành công
            BUS -> BUS : generateElectronicInvoice()
            BUS --> GUI : showSuccess(Invoice)
            GUI --> Actor : Thông báo thành công & Gửi hóa đơn
        end
    end
end

@enduml