@startuml ThanhToan_SequenceDiagram

title Sequence Diagram - Thanh toán (UC16)

autonumber

actor "Customer" as Actor
boundary "ScreenPayment" as GUI <<boundary>>
control "Payment" as BUS <<control>>
database "PaymentDB" as DB <<database>>
database "RentalDB" as RDB <<database>>

Actor -> GUI : Nhấn nút thanh toán
GUI -> BUS : createPaymentCode(registrationId, method, action)

alt Lỗi khởi tạo mã
    BUS --> GUI : Lỗi hệ thống
    GUI --> Actor : Thông báo lỗi & Thử lại
else Thành công
    BUS --> GUI : Trả về PaymentSessionDTO (Mã QR)
    GUI --> Actor : Hiển thị mã QR
    
    Actor -> GUI : Quét mã trên App Ngân hàng
    GUI -> BUS : verifyTransaction(sessionId)
    
    alt Không nhận được phản hồi (Timeout / Cancel)
        BUS --> GUI : Trạng thái TIMEOUT / FAILED
        GUI --> Actor : Thông báo lỗi kết nối / Đã hủy
    else Thành công
        BUS --> GUI : Trạng thái SUCCESS
        
        GUI -> BUS : finalizePayment(sessionId)
        
        alt Nếu action == 'DEPOSIT'
            BUS -> DB : createInvoice(amount)
            BUS -> RDB : markDeposited (Cập nhật giường -> DEPOSITED)
        else Nếu action == 'FULL_PAYMENT'
            alt Nếu chưa đặt cọc
                BUS -> DB : createInvoice(depositAmount, 'DEPOSIT')
                BUS -> RDB : markDeposited()
            end
            BUS -> RDB : markFullyPaid() (Tạo rental_form type 'FULL' & payment SUCCESS)
            BUS -> RDB : markBooked (Cập nhật giường -> BOOKED)
        end
        
        BUS --> GUI : Hoàn tất thanh toán
        GUI --> Actor : Thông báo thành công & Gửi hóa đơn
    end
end

@enduml