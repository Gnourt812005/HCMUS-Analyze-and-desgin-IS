@startuml
title Class Diagram - UC26: Quản lý yêu cầu trả phòng

skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 14
}

class "ManageCheckoutRequestScreen" <<boundary>> {
  - dgvRequests: DataGridView
  + show(): void
  + loadRequests(): void
}

class "CreateCheckoutRequestScreen" <<boundary>> {
  - cbUsers: ComboBox
  - dtpExpectedDate: DateTimePicker
  - btnSave: Button
  + show(): void
  + btnSaveClick(): void
}

class "CheckoutRequestDetailScreen" <<boundary>> {
  - lblContractInfo: Label
  - lblRefundInfo: Label
  - btnProcess: Button
  - btnReject: Button
  + show(requestID: int): void
  + displayDetail(): void
}

class "CheckoutRequest" <<control>> {
  - requestID: int
  - userCCCD: string
  - expectedDate: DateTime
  - status: string
  - createdAt: DateTime
  - documentUrl: string
  - reason: string
  + <<static>> getList(): CheckoutRequest[]
  + <<static>> getById(id: int): CheckoutRequest
  + <<static>> create(data: CheckoutRequest): bool
  + <<static>> updateStatus(id: int, status: string, reason: string = ""): bool
}

class "User" <<control>> {
  - userCCCD: string
  - fullName: string
  + <<static>> getUsersWithActiveContract(): User[]
}

class "Contract" <<control>> {
  - contractID: int
  - userCCCD: string
  - depositAmount: float
  - liquidationDocUrl: string
  - status: string
  + <<static>> getByUserId(userId: int): Contract
}

class "RefundCalculation" <<control>> {
  - calculationID: int
  - requestID: int
  - depositAmount: float
  - damageFee: float
  - extraDebt: float
  - finalRefundAmount: float
  + <<static>> getByRequestId(requestId: int): RefundCalculation
}

class "CheckoutRequestDB" <<entity>> {
  + <<static>> getAll(): CheckoutRequest[]
  + <<static>> getById(id: int): CheckoutRequest
  + <<static>> insert(data: CheckoutRequest): bool
  + <<static>> updateStatus(id: int, status: string): bool
}

class "UserDB" <<entity>> {
  + <<static>> getByActiveContract(): User[]
}

class "ContractDB" <<entity>> {
  + <<static>> getByUserId(id: int): Contract
}

class "RefundDB" <<entity>> {
  + <<static>> getByRequestId(id: int): RefundCalculation
}

ManageCheckoutRequestScreen --> CheckoutRequest
CreateCheckoutRequestScreen --> CheckoutRequest
CreateCheckoutRequestScreen --> User
CheckoutRequestDetailScreen --> CheckoutRequest
CheckoutRequestDetailScreen --> Contract
CheckoutRequestDetailScreen --> RefundCalculation

CheckoutRequest --> CheckoutRequestDB
User --> UserDB
Contract --> ContractDB
RefundCalculation --> RefundDB

@enduml
