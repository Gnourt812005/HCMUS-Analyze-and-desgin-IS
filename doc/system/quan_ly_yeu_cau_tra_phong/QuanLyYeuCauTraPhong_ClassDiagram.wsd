@startuml
title Class Diagram - UC26: Quản lý yêu cầu trả phòng

skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ClassBorderThickness 2
    StereotypeFontColor #2D3E50
    Padding 5
}

class "ManageCheckoutRequestScreen" <<boundary>> {
  - dgvRequests: DataGridView
  + loadRequests(): void
}

class "CreateCheckoutRequestScreen" <<boundary>> {
  - txtSearchUser: TextBox
  - cbbContractList: ComboBox
  - dtpExpectedDate: DateTimePicker
  - btnSave: Button
  - btnSearch: Button
  - btnBack: Button
  + show(): void
  + btnSaveClick(): void
}

class "CheckoutRequestDetailScreen" <<boundary>> {
  - lblContractInfo: Label
  - lblRefundInfo: Label
  - btnProcess: Button
  - btnReject: Button
  - btnBack: Button
  + show(requestId: string): void
  + displayDetail(): void
}

class "CheckoutRequest" <<control>> {
  - requestId: string
  - userEmail: string
  - userFullName: string
  - contractId: string
  - dormName: string
  - roomName: string
  - floor: number
  - bedNumbers: string
  - expectedDate: string 
  - status: CheckoutStatus
  - createdAt: string
  + <<static>> getList(): CheckoutRequest[]
  + <<static>> getById(requestId: string): CheckoutRequest 
  + <<static>> create(data: CheckoutRequest): CheckoutRequest
  + <<static>> createWithDuplicateCheck(data: CheckoutRequest): {success: bool, request: CheckoutRequest}
  + <<static>> updateStatus(requestId: string, status: CheckoutStatus, expectedStatus: CheckoutStatus): bool
}

class "Contract" <<control>> {
  - contractId: string
  - contractCode: string
  - userEmail: string
  - roomName: string
  - dormName: string
  - floor: number
  - bedNumbers: string
  - startDate: string
  - stayDuration: number
  - rentalFormId: string
  - status: ContractStatus
  - depositAmount: number
  - signatureUrl: string
  - createdAt: string
  + <<static>> getByUserEmail(userEmail: string): Contract 
  + <<static>> getByContractId(contractId: string): Contract 
  + <<static>> getActiveByUserEmail(userEmail: string): Contract[]
  + <<static>> updateStatus(contractId: string, status: ContractStatus): bool
  + <<static>> getBedsInfoByContractId(contractId: string): {roomId: string, bedIds: string[]} 
}

class "RefundCalculation" <<control>> {
  - calculationId: string
  - requestId: string
  - contractId: string
  - depositAmount: number
  - damageFee: number
  - extraFee: number
  - finalRefundAmount: number
  - notes: string
  - createdAt: string
  + <<static>> getByRequestId(requestId: string): RefundCalculation 
  + <<static>> getById(calculationId: string): RefundCalculation 
  + <<static>> create(data: RefundCalculation): RefundCalculation
  + <<static>> update(calculationId: string, data: RefundCalculation): RefundCalculation 
}

class "CheckoutRequestDB" <<entity>> {
  + <<static>> getAll(): CheckoutRequest[]
  + <<static>> getById(requestId: string): CheckoutRequest
  + <<static>> insert(request: CheckoutRequest): string 
  + <<static>> insertIfNoActiveRequest(request: CheckoutRequest, contractId: string, userEmail: string): {success: bool, error: string, requestId: string}
}

class "ContractDB" <<entity>> {
  + <<static>> getByUserEmail(userEmail: string): Contract 
  + <<static>> getByContractId(contractId: string): Contract 
  + <<static>> getActiveByUserEmail(userEmail: string): Contract[]
  + <<static>> updateStatus(contractId: string, status: ContractStatus): bool
  + <<static>> getBedsInfoByContractId(contractId: string): {roomId: string, bedIds: string[]} 
}

class "RefundCalculationDB" as RefundCalculationDB <<entity>> {
  + <<static>> getByRequestId(requestId: string): RefundCalculation 
  + <<static>> getById(calculationId: string): RefundCalculation 
  + <<static>> create(data: RefundCalculation): RefundCalculation
  + <<static>> update(calculationId: string, data: RefundCalculation): RefundCalculation 
}

ManageCheckoutRequestScreen --> CheckoutRequest
CreateCheckoutRequestScreen --> CheckoutRequest
CheckoutRequestDetailScreen --> CheckoutRequest
CheckoutRequestDetailScreen --> Contract
CheckoutRequestDetailScreen --> RefundCalculation

CheckoutRequest --> CheckoutRequestDB
Contract --> ContractDB
RefundCalculation --> RefundCalculationDB

@enduml
