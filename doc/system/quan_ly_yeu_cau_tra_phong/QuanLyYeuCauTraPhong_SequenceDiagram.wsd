@startuml QuanLyYeuCauTraPhong_SequenceDiagram
title Sequence Diagram - UC26: Quản lý yêu cầu trả phòng

skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
    MaxMessageSize 200
}

autonumber

actor "Nhân viên" as nv
boundary "ManageCheckoutRequestScreen" as guiManage
boundary "CreateCheckoutRequestScreen" as guiCreate
boundary "CheckoutRequestDetailScreen" as guiDetail
control "CheckoutRequest" as reqCtrl
control "Rental" as rentalCtrl
control "Contract" as conCtrl
control "RefundCalculation" as refCtrl
database "CheckoutRequestDB" as reqDB
database "RentalDB" as rentalDB
database "ContractDB" as conDB
database "RefundCalculationDB" as refDB

== Kịch bản 1: Xem danh sách yêu cầu ==
nv -> guiManage: loadRequests()
activate nv
activate guiManage

guiManage -> reqCtrl: getList()
activate reqCtrl
reqCtrl -> reqDB: getAll()
activate reqDB
reqDB --> reqCtrl: CheckoutRequest[]
deactivate reqDB
reqCtrl --> guiManage: CheckoutRequest[]
deactivate reqCtrl
guiManage --> nv: Hiển thị danh sách yêu cầu
deactivate guiManage
deactivate nv

== Kịch bản 2: Xem chi tiết yêu cầu ==
nv -> guiManage: Chọn yêu cầu để xem chi tiết
activate nv
activate guiManage
guiManage -> guiDetail: show(requestId)
activate guiDetail
deactivate guiManage
guiDetail -> reqCtrl: getById(requestId)
activate reqCtrl
reqCtrl -> reqDB: getById(requestId)
activate reqDB
reqDB --> reqCtrl: CheckoutRequest
deactivate reqDB
reqCtrl --> guiDetail: CheckoutRequest
deactivate reqCtrl

guiDetail -> rentalCtrl: getRentalFormById(rentalFormId)
activate rentalCtrl
rentalCtrl -> rentalDB: getRentalFormById(rentalFormId)
activate rentalDB
rentalDB --> rentalCtrl: Rental
deactivate rentalDB
rentalCtrl --> guiDetail: Rental
deactivate rentalCtrl

guiDetail -> conCtrl: getByRentalFormId(rentalFormId)
activate conCtrl
conCtrl -> conDB: getByRentalFormId(rentalFormId)
activate conDB
conDB --> conCtrl: Contract | null
deactivate conDB
conCtrl --> guiDetail: Contract | null
deactivate conCtrl

guiDetail -> refCtrl: getByRequestId(requestId)
activate refCtrl
refCtrl -> refDB: getByRequestId(requestId)
activate refDB
refDB --> refCtrl: RefundCalculation | null
deactivate refDB
refCtrl --> guiDetail: RefundCalculation | null
deactivate refCtrl

guiDetail --> nv: Hiển thị chi tiết yêu cầu
deactivate guiDetail
deactivate nv

== Kịch bản 3: Tạo yêu cầu trả phòng ==
nv -> guiManage: Nhấn "Tạo yêu cầu mới"
activate nv
activate guiManage
guiManage -> guiCreate: show()
activate guiCreate
deactivate guiManage

guiCreate -> rentalCtrl: getActiveRentalFormsForCheckout(userEmail)
activate rentalCtrl
rentalCtrl -> rentalDB: getActiveRentalFormsForCheckout(userEmail)
activate rentalDB
rentalDB --> rentalCtrl: Rental[]
deactivate rentalDB
rentalCtrl --> guiCreate: Rental[]
deactivate rentalCtrl

guiCreate --> nv: Hiển thị form và danh sách form thuê

nv -> guiCreate: Chọn form thuê và Nhấn "Lưu"
guiCreate -> reqCtrl: createWithDuplicateCheck(data)
activate reqCtrl
reqCtrl -> reqDB: insertIfNoActiveRequest(data)
activate reqDB
reqDB --> reqCtrl: {success: bool, requestId?: string}
deactivate reqDB
reqCtrl --> guiCreate: {success: bool, request?: CheckoutRequest}
deactivate reqCtrl

guiCreate --> nv: Thông báo thành công
deactivate guiCreate
deactivate nv

nv -> guiDetail: Chọn yêu cầu và Nhấn "Tiếp nhận"
activate guiDetail
activate nv

guiDetail -> reqCtrl: updateStatus(requestId, CheckoutStatus.PROCESSING)
activate reqCtrl
reqCtrl -> reqDB: updateStatus(requestId, CheckoutStatus.PROCESSING)
activate reqDB
reqDB --> reqCtrl: bool (true)
deactivate reqDB
reqCtrl --> guiDetail: bool (true)
deactivate reqCtrl

guiDetail --> nv: Hiện các nút chức năng tiếp theo\nvà thông báo thành công
deactivate guiDetail
deactivate nv

== Kịch bản 4: Hủy yêu cầu / Từ chối yêu cầu ==
nv -> guiDetail: Nhấn "Hủy yêu cầu" / "Từ chối"
activate guiDetail
activate nv
guiDetail -> reqCtrl: updateStatus(requestId, CheckoutStatus.CANCELLED)
activate reqCtrl
reqCtrl -> reqDB: updateStatus(requestId, CheckoutStatus.CANCELLED)
activate reqDB
reqDB --> reqCtrl: bool (true)
deactivate reqDB
reqCtrl --> guiDetail: bool (true)
deactivate reqCtrl

guiDetail --> nv: Thông báo thành công và cập nhật trạng thái
deactivate guiDetail
deactivate nv

@enduml
