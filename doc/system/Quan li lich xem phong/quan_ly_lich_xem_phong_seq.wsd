@startuml QuanLyLichXemPhong_SequenceDiagram
title Sequence Diagram: Quản lý lịch xem phòng

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    ParticipantPadding 20
    BoxPadding 10
}

actor "Khách hàng" as Actor
boundary "ClientPreviewScheduleManagementScreen" as GUI_List <<boundary>>
boundary "ScreenPreviewScheduleDetailsView" as GUI_Details <<boundary>>

control "PreviewForm" as BUS_Preview <<control>>
control "Room" as BUS_Room <<control>>

database "PreviewFormDB" as DAO_Preview <<database>>
database "RoomDB" as DAO_Room <<database>>
database "UtilitiesDB" as DAO_Utils <<database>>
database "BedDB" as DAO_Bed <<database>>

autonumber

== Xem danh sách lịch xem phòng ==

Actor -> GUI_List: showClientPreviewSchedules(userID)
activate GUI_List

GUI_List -> BUS_Preview: getPreviewFormsByUserID(userID)
activate BUS_Preview

BUS_Preview -> DAO_Preview: getPreviewFormsByUserID(userID)
activate DAO_Preview
deactivate DAO_Preview
deactivate BUS_Preview

GUI_List -> BUS_Room: getRoomsList(roomIDs)
activate BUS_Room

BUS_Room -> DAO_Room: getRoomsList(roomIDs)
activate DAO_Room

loop roomID in roomIDs
    DAO_Room -> DAO_Utils: getUtilitiesByRoomID(roomID)
    activate DAO_Utils
    deactivate DAO_Utils

    DAO_Room -> DAO_Bed: getBedPrice(roomID)
    activate DAO_Bed
    deactivate DAO_Bed
end

deactivate DAO_Room
deactivate BUS_Room
deactivate GUI_List


== Chọn xem chi tiết lịch ==

Actor -> GUI_List: listPreviewSchedules_ItemClick()
activate GUI_List

GUI_List -> GUI_Details: showPreviewScheduleDetails(previewFormID)
activate GUI_Details
deactivate GUI_List

GUI_Details -> BUS_Preview: getPreviewFormDetails(previewFormID)
activate BUS_Preview
deactivate BUS_Preview

deactivate GUI_Details


== Hủy lịch xem phòng ==

Actor -> GUI_Details: btnCancelPreviewSchedule_Click()
activate GUI_Details

GUI_Details -> BUS_Preview: cancelPreviewSchedule(previewFormID)
activate BUS_Preview

BUS_Preview -> DAO_Preview: cancelPreviewSchedule(previewFormID)
activate DAO_Preview
deactivate DAO_Preview

deactivate BUS_Preview
deactivate GUI_Details

@enduml
