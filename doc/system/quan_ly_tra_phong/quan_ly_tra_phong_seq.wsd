@startuml
title Sequence Diagram - UC26: Quản lý yêu cầu trả phòng
actor "Nhân viên" as NV
boundary ": ManageCheckoutRequestScreen" as ListScreen
boundary ": CreateCheckoutRequestScreen" as CreateScreen
boundary ": CheckoutRequestDetailScreen" as DetailScreen
entity ": Customer" as Customer
entity ": CheckoutRequest" as Request
database ": CheckoutRequestDB" as DB

== Xem danh sách yêu cầu ==
NV -> ListScreen: 1: Show()
activate ListScreen
activate NV
ListScreen -> Request: 2: GetList()
activate Request
Request -> DB: 3: GetList()
activate DB
deactivate DB
deactivate Request
deactivate ListScreen
deactivate NV

== Tạo yêu cầu trả phòng ==
NV -> ListScreen: 4: btnCreateNew_Click()
activate NV
activate ListScreen
ListScreen -> CreateScreen: 5: Show()
deactivate ListScreen
activate CreateScreen

CreateScreen -> Customer: 6: GetActiveCustomers()
activate Customer
deactivate Customer

NV -> CreateScreen: 7: Chọn khách hàng, ngày giờ và tải giấy tờ
NV -> CreateScreen: 8: btnSave_Click()
CreateScreen -> Request: 9: Create()
activate Request
Request -> DB: 10: Insert()
activate DB
deactivate DB
deactivate Request
deactivate CreateScreen
deactivate NV

== Xem chi tiết và Xử lý ==
NV -> ListScreen: 11: btnViewDetail_Click()
activate NV
activate ListScreen
ListScreen -> DetailScreen: 12: Show()
deactivate ListScreen
activate DetailScreen
DetailScreen -> Request: 13: GetById()
activate Request
Request -> DB: 14: GetById()
activate DB
deactivate DB
deactivate Request
deactivate DetailScreen
deactivate NV

alt Tiếp nhận yêu cầu
    NV -> DetailScreen: 15: btnProcess_Click()
    activate NV
    activate DetailScreen
    DetailScreen -> Request: 16: UpdateStatus("Đang xử lý")
    activate Request
    Request -> DB: 17: UpdateStatus()
    activate DB
    deactivate DB
    deactivate Request
    deactivate DetailScreen
    deactivate NV
else Từ chối / Hủy yêu cầu
    NV -> DetailScreen: 18: Nhập lý do và btnReject_Click()
    activate DetailScreen
    activate NV
    DetailScreen -> Request: 19: UpdateStatus("Từ chối/Đã hủy")
    activate Request
    Request -> DB: 20: UpdateStatus()
    activate DB
    deactivate DB
    deactivate Request
    deactivate DetailScreen
    deactivate NV
end
@enduml
