@startuml YeuCauTraPhong_SequenceDiagram
title Sequence Diagram - UC22: Tạo yêu cầu trả phòng

skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
}

autonumber

actor "Khách hàng" as customer
boundary "ScreenCheckoutRequest" as screen
control "Contract" as contract
control "CheckoutRequest" as request
database "ContractDB" as contractDb
database "CheckoutRequestDB" as requestDb

customer -> screen: show()
activate customer
activate screen
screen -> contract: getActiveByUserEmail(userEmail)
activate contract
contract -> contractDb: getActiveByUserEmail(userEmail)
activate contractDb
contractDb --> contract: Contract[]
deactivate contractDb
contract --> screen: Contract[]
deactivate contract

screen --> customer: Hiển thị danh sách hợp đồng
deactivate screen
deactivate customer

customer -> screen: Chọn hợp đồng
activate customer
activate screen
customer -> screen: Điền ngày dự kiến
deactivate customer
deactivate screen

customer -> screen: Nhấn "Gửi yêu cầu"
activate customer
activate screen
alt Thông tin hợp lệ
    screen -> request: createWithDuplicateCheck(data)
    activate request
    request -> requestDb: insertIfNoActiveRequest(data)
    activate requestDb
    requestDb --> request: {success: bool, requestId?: string}
    deactivate requestDb
    request --> screen: {success: bool, request?: CheckoutRequest}
    deactivate request
    screen --> customer: Thông báo thành công
else Yêu cầu đã tồn tại
    screen --> customer: Thông báo lỗi
end

deactivate customer
deactivate screen

@enduml
