@startuml YeuCauTraPhong_SequenceDiagram
title Sequence Diagram - UC22: Tạo yêu cầu trả phòng

skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
}

autonumber

actor "Khách hàng" as customer
boundary "ScreenCheckoutRequest" as screen
control "Rental" as rental
control "CheckoutRequest" as request
database "RentalDB" as rentalDb
database "CheckoutRequestDB" as requestDb

customer -> screen: show()
activate customer
activate screen
screen -> rental: getActiveRentalFormsForCheckout(userEmail)
activate rental
rental -> rentalDb: getActiveRentalFormsForCheckout(userEmail)
activate rentalDb
rentalDb --> rental: Rental[]
deactivate rentalDb
rental --> screen: Rental[]
deactivate rental

screen --> customer: Hiển thị danh sách form thuê
deactivate screen
deactivate customer

customer -> screen: Chọn form thuê
activate customer
activate screen
customer -> screen: Điền ngày dự kiến
deactivate customer
deactivate screen

customer -> screen: Nhấn "Gửi yêu cầu"
activate customer
activate screen
alt Thông tin hợp lệ
    screen -> request: createWithDuplicateCheck(data)
    activate request
    request -> requestDb: insertIfNoActiveRequest(data)
    activate requestDb
    requestDb --> request: {success: bool, requestId?: string}
    deactivate requestDb
    request --> screen: {success: bool, request?: CheckoutRequest}
    deactivate request
    screen --> customer: Thông báo thành công
else Yêu cầu đã tồn tại
    screen --> customer: Thông báo lỗi
end

deactivate customer
deactivate screen

@enduml
