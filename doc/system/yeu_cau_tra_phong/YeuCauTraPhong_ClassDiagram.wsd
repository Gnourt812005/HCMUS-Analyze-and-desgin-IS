@startuml YeuCauTraPhong_ClassDiagram
title Class Diagram - UC22: Tạo yêu cầu trả phòng

skinparam {
    ClassBackgroundColor White
    ArrowColor #2D3E50
    ClassBorderColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ClassBorderThickness 2
    StereotypeFontColor #2D3E50
    Padding 5
}

class "ScreenCheckoutRequest" as CheckoutRequestScreen <<boundary>> {
  - cbbContractList: ComboBox
  - dtpCheckoutDate: DateTimePicker
  - btnSubmit: Button
  - btnBack: Button
  + show(): void
  + btnSubmitClick(): void
  + btnCancelClick(): void
}

class "CheckoutRequest" as CheckoutRequest <<control>> {
  - requestId: string
  - userEmail: string
  - userFullName: string
  - contractId: string
  - dormName: string
  - roomName: string
  - floor: number
  - bedNumbers: string
  - expectedDate: string
  - status: CheckoutStatus
  - createdAt: string
  + <<static>> create(data: Partial<CheckoutRequestDTO>): CheckoutRequestDTO
  + <<static>> createWithDuplicateCheck(data: Partial<CheckoutRequestDTO>): {success: bool, request?: CheckoutRequestDTO, error?: string}
}

class "CheckoutRequestDB" as CheckoutRequestDB <<entity>> {
  + <<static>> insert(request: CheckoutRequest): string | null
  + <<static>> insertIfNoActiveRequest(request: CheckoutRequest, contractId: string, userEmail: string): {success: bool, error?: string, requestId?: string}
}

class "Contract" as Contract <<control>> {
  - contractId: string
  - contractCode: string
  - userEmail: string
  - roomName: string
  - dormName: string
  - floor: number
  - bedNumbers: string
  - startDate: string
  - stayDuration: number
  - rentalFormId: string
  - status: ContractStatus
  - depositAmount: number
  - signatureUrl: string
  - createdAt: string
  + <<static>> getActiveByUserEmail(userEmail: string): ContractDTO[]
}

class "ContractDB" as ContractDB <<entity>> {
  + <<static>> getActiveByUserEmail(userEmail: string): Partial<Contract>[]
}

CheckoutRequestScreen --> CheckoutRequest
CheckoutRequest --> CheckoutRequestDB
CheckoutRequestScreen --> Contract
Contract --> ContractDB

@enduml
