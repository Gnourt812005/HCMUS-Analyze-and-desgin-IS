@startuml YeuCauTraPhong_ClassDiagram
title Class Diagram - UC22: Tạo yêu cầu trả phòng

skinparam {
    ClassBackgroundColor White
    ArrowColor #2D3E50
    ClassBorderColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ClassBorderThickness 2
    StereotypeFontColor #2D3E50
    Padding 5
}

class "ScreenCheckoutRequest" as CheckoutRequestScreen <<boundary>> {
  - cbbContractList: ComboBox
  - dtpCheckoutDate: DateTimePicker
  - btnSubmit: Button
  - btnBack: Button
  + show(): void
  + btnSubmitClick(): void
  + btnCancelClick(): void
}

class "CheckoutRequest" as CheckoutRequest <<control>> {
  - requestId: string
  - userEmail: string
  - userFullName: string
  - rentalFormId: string
  - dormName: string
  - roomName: string
  - floor: number
  - bedNumbers: string
  - expectedDate: string
  - status: CheckoutStatus
  - createdAt: string
  + <<static>> createWithDuplicateCheck(data: CheckoutRequest): {success: bool, request?: CheckoutRequest, error?: string}
}

class "CheckoutRequestDB" as CheckoutRequestDB <<entity>> {
  + <<static>> insertIfNoActiveRequest(request: CheckoutRequest, rentalFormId: string, userEmail: string): {success: bool, error?: string, requestId?: string}
}

class "Rental" as Rental <<control>> {
  - rentalFormId: string
  - userEmail: string
  - roomName: string
  - dormName: string
  - floor: number
  - bedNumbers: string
  - type: string
  - totalAmount: number
  - createdAt: string
  + <<static>> getActiveRentalFormsForCheckout(userEmail: string): Rental[]
}

class "RentalDB" as RentalDB <<entity>> {
  + <<static>> getActiveRentalFormsForCheckout(userEmail: string): Rental[]
}

CheckoutRequestScreen --> CheckoutRequest
CheckoutRequest --> CheckoutRequestDB
CheckoutRequestScreen --> Rental
Rental --> RentalDB

@enduml
