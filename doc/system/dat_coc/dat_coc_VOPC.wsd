@startuml
skinparam style strictuml
header VOPC - UC13: Đặt cọc

actor "Khách hàng" as Actor

boundary "MH_DatCoc" as Boundary1 <<boundary>>
boundary "MH_ThongBao" as Boundary2 <<boundary>>

control "XuLyDatCoc" as Control <<control>>

entity "KhachHang" as EntityKH <<entity>>
entity "Phong" as EntityP <<entity>>
entity "Giuong" as EntityG <<entity>>
entity "HopDong" as EntityHD <<entity>>

' Relationships based on template
Actor -- Boundary1 : 1..*
Boundary1 -- Control : 1
Control -- Boundary2 : 1
Control -- EntityKH : 1..*
Control -- EntityP : 1..*
Control -- EntityG : 1..*
Control -- EntityHD : 1..*
@enduml