@startuml DatCoc_ClassDiagram
skinparam classAttributeIconSize 0
skinparam style strictuml
title Class Diagram - UC14: Đặt cọc

' --- BOUNDARY LAYER ---
class "ScreenDeposit" as ScreenDeposit <<boundary>> {
    + showRooms()
    + inputCustomerInfo()
    + showTotalAmount(amount)
}

' --- BUSINESS LAYER ---
class "Customer" as Customer <<control>> {
    - idCard: String
    - fullName: String
    - birthday: Date
    - phone: String
}

class "Room" as Room <<control>> {
    - roomId: String
    - roomType: String
    - price: Double
}

class "Bed" as Bed <<control>> {
    - bedId: String
    - status: String
}

class "Deposit" as Deposit <<control>> {
    - roomId: String
    - depositAmount: Double
    + <<static>> validateInfo(data)
    + <<static>> calculateDeposit()
    + <<static>> createTempInvoice()
}

class "RoomDB" as RoomDB <<entity>> {
    + <<static>> getPrice()
    + <<static>> updateStatus()
}

class "BedDB" as BedDB <<entity>> {
    + <<static>> checkAvailable()
}

"ScreenDeposit" ..> "Deposit"
"Deposit" ..> "Customer"
"Deposit" ..> "Room"
"Deposit" ..> "Bed"
"Customer" ..> "CustomerDB"
"Room" ..> "RoomDB"
"Bed" ..> "BedDB"

@enduml