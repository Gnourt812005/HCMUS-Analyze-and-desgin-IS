@startuml DatCoc_ClassDiagram
skinparam classAttributeIconSize 0
skinparam style strictuml
title Class Diagram - UC14: Đặt cọc

' --- BOUNDARY LAYER ---
class "ScreenRoomList" as ScreenRoomList <<boundary>> {
    + inputCustomerInfo()
    + showTotalAmount(amount)
}

' --- BUSINESS LAYER ---
class "Rental" as Rental <<control>> {
    + <<static>> register(payload)
    + <<static>> checkEligibility(payload)
    + <<static>> previewPayment(payload)
}

class "RentalDB" as RentalDB <<entity>> {
    + <<static>> createRegistration(record, action)
    + <<static>> getRegistration(registrationId)
    + <<static>> hasDeposit(roomId, idCard)
}

"ScreenRoomList" ..> "Rental"
"Rental" ..> "RentalDB"

@enduml