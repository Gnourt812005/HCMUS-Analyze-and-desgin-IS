@startuml QuanLyPhongDaQuanTam_BCE_Complete
title Class Diagram - UC7: Quản lý phòng đã quan tâm (Đầy đủ thành phần)

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 18
    Padding 5
    Nodesep 60
    Ranksep 80
}

' ==========================================
' 1. SHARED LAYER (DTOs)
' ==========================================
package "Data Transfer Objects" <<Rectangle>> {
    class "DormDTO" as DormDTO <<DTO>> {
        + id: string
        + name: string
        + address: string
        + phone: string
        + status: string
        + totalRooms: number
        + availableRooms: number
    }

    class "RoomBriefDTO" as RoomBriefDTO <<DTO>> {
        + id: string
        + name: string
        + block: string
        + price: number
        + totalBeds: number
        + availableBeds: number
        + amenities: string[]
        + imageUrl: string
    }

    class "RoomDetailDTO" as RoomDetailDTO <<DTO>> {
        - id: string;
        - name: string;
        - block: string;
        - floor: number;
        - price: number;
        - totalBeds: number;
        - availableBeds: number;
        - amenities: string[];
        - imageUrl: string;
        - favoriteCount: number;
        - isFavorite: boolean;
    }

' ==========================================
' 2. BOUNDARY LAYER (FRONTEND)
' ==========================================
class "ScreenFavoriteRooms" as ScreenFavoriteRooms <<boundary>> {
    - gridFavoriteRooms: GridView
    + showFavoriteRooms(): void
    + gridRoomsCellClick(roomId: string): void
}

class "ScreenRoomDetailsView" as ScreenRoomDetailsView <<boundary>> {
    - imgRoom: PictureBox
    - lblRoomName: Label
    - btnRemoveFavorite: IconButton
    + btnRemoveFavoriteClick(): void
}

' ==========================================
' 3. CONTROL LAYER (BUSINESS)
' ==========================================
class "Favourites" as Favourites <<control>> {
    - userId: string
    - favouriteRooms: List<Room>

    + <<static>> getFavouritesByUserId(userId: string): List<Room>
    + <<static>> deleteFavourite(userId: string, roomId: string): int
}

class "Dorm" as Dorm <<control>> {
    + id: string
    + name: string
    + address: string
    + phone: string
    + status: string
    + totalRooms: number
    + availableRooms: number
    
    + <<static>> getAll(query: GetDormsDto): {dorms: DormDTO[], total: int}
    + <<static>> getById(id: string): DormDTO
}

class "Room" as Room <<control>> {
    - id: string;
    - name: string;
    - block: string;
    - floor: number;
    - price: number;
    - totalBeds: number;
    - availableBeds: number;
    - amenities: string[];
    - imageUrl: string;
    - favoriteCount: number;
    - isFavorite: boolean;
    
    + <<static>> fetchAll(query: GetRoomDto): {rooms: RoomDTO[], total: int}
    + <<static>> getById(id: string): RoomDTO
}

' ==========================================
' 4. ENTITY LAYER (DATABASE)
' ==========================================
class "DormDB" as DormDB <<entity>> {
    + <<static>> getAll(): List<Dorm>
    + <<static>> fetchAll(query: any): {dorms: Dorm[], total: int}
    + <<static>> fetchById(id: string): Dorm
}

class "RoomDB" as RoomDB <<entity>> {
    + <<static>> fetchAll(query: GetRoomDto): {rooms: RoomDTO[], total: int}
    + <<static>> fetchById(id: string): any
}

class "FavouriteRoomsDB" as FavouriteRoomsDB <<entity>> {
    + <<static>> getRoomIdsByUserId(userId: string): List<string>
    + <<static>> delete(userId: string, roomId: string): boolean
}

' ==========================================
' RELATIONSHIPS
' ==========================================

' Boundary to Control
ScreenFavoriteRooms "1" --> "1" Favourites
ScreenRoomDetailsView "1" --> "1" Favourites

' Control to Control
Favourites "1" --> "1" Room : "lấy dữ liệu phòng chi tiết"
Favourites "1" --> "1" Dorm : "lấy dữ liệu ký túc xá"

' Control to Entity
Favourites "1" --> "1" FavouriteRoomsDB
Room "1" --> "1" RoomDB
Dorm "1" --> "1" DormDB

' DTO mapping
Dorm ..> DormDTO : "returns"
Room ..> RoomBriefDTO : "maps to"
Room ..> RoomDetailDTO : "maps to"

@enduml