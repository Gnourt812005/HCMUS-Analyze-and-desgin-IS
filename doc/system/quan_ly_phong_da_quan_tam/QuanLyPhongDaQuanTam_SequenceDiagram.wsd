@startuml QuanLyPhongDaQuanTam_SequenceDiagram_SrcCode
title Sequence Diagram - UC7: Quản lý phòng đã quan tâm (Strict Source Code)

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
    BoxPadding 10
}

autonumber

actor "Khách hàng" as Actor
boundary "FavoriteManagementScreen" as GUI_Favorite <<boundary>>
boundary "ScreenRoomDetailsView" as GUI_Details <<boundary>>
boundary "ScreenPreviewRequestView" as GUI_Preview <<boundary>>

control "Favourites" as BUS_Fav <<control>>
control "Room" as BUS_Room <<control>>
control "Dorm" as BUS_Dorm <<control>>
control "PreviewForm" as BUS_Preview <<control>>

database "FavouriteRoomsDB" as DAO_Fav <<entity>>
database "RoomDB" as DAO_Room <<entity>>
database "DormDB" as DAO_Dorm <<entity>>
database "PreviewFormDB" as DAO_Preview <<entity>>
database "UserDB" as DAO_User <<entity>>

== Mở danh sách phòng đã quan tâm ==
Actor -> GUI_Favorite: Mở trang Quản lý yêu thích
activate GUI_Favorite
    GUI_Favorite -> GUI_Favorite: fetchRooms()
    note right of GUI_Favorite: Component mount gọi ApiClient.get('/favourites')
    
    GUI_Favorite -> BUS_Fav: getFavouritesByUserId(userId)
    activate BUS_Fav
        
        BUS_Fav -> DAO_Fav: getRoomIdsByUserId(userId)
        activate DAO_Fav
        deactivate DAO_Fav

        BUS_Fav -> BUS_Room: fetchAll({ limit: 1000 })
        activate BUS_Room
            BUS_Room -> DAO_Room: fetchAll({ limit: 1000 })
            activate DAO_Room
            deactivate DAO_Room
        deactivate BUS_Room

        BUS_Fav -> BUS_Dorm: getAll()
        activate BUS_Dorm
            BUS_Dorm -> DAO_Dorm: getAll()
            activate DAO_Dorm
            deactivate DAO_Dorm
        deactivate BUS_Dorm
        
        BUS_Fav -> BUS_Fav: Lọc phòng & Map dữ liệu (dormName)
    deactivate BUS_Fav
    note right of GUI_Favorite: Hiển thị danh sách bằng RoomBriefDTO
deactivate GUI_Favorite

== Xem chi tiết phòng ==
Actor -> GUI_Favorite: Bấm chọn 1 phòng trên grid
activate GUI_Favorite
    GUI_Favorite -> GUI_Details: setSelectedRoomId(roomId)
    activate GUI_Details
        note right of GUI_Details: Hiển thị Modal chi tiết bằng RoomDetailDTO
    deactivate GUI_Details
deactivate GUI_Favorite

== Thao tác: Bỏ quan tâm phòng ==
Actor -> GUI_Details: Bấm nút "Bỏ thích"
activate GUI_Details
    GUI_Details -> GUI_Details: handleToggleFavorite(roomId)
    
    GUI_Details -> GUI_Favorite: setSelectedRoomId(null)
    note right of GUI_Details: Optimistic UI: Lập tức đóng Modal chi tiết
    
    GUI_Details -> BUS_Fav: deleteFavourite(userId, roomId)
    activate BUS_Fav
        BUS_Fav -> DAO_Fav: delete(userId, roomId)
        activate DAO_Fav
        deactivate DAO_Fav
    deactivate BUS_Fav
deactivate GUI_Details

== Thao tác: Đăng ký xem phòng ==
Actor -> GUI_Details: Bấm "Đăng ký xem phòng"
activate GUI_Details
    GUI_Details -> GUI_Preview: handleRegisterViewing()
    activate GUI_Preview
        note right of GUI_Preview: Mở Modal Form chọn thời gian
    deactivate GUI_Preview
deactivate GUI_Details

Actor -> GUI_Preview: Chọn ngày/giờ & Bấm "Xác nhận đăng ký"
activate GUI_Preview
    GUI_Preview -> GUI_Preview: submitPreviewForm()
    
    GUI_Preview -> BUS_Preview: createPreviewForm(userId, roomId, previewDatetime)
    activate BUS_Preview
        
        BUS_Preview -> DAO_Preview: getAll()
        activate DAO_Preview
        deactivate DAO_Preview

        BUS_Preview -> BUS_Preview: Kiểm tra trùng lịch phòng (roomConflict)
        BUS_Preview -> BUS_Preview: Kiểm tra trùng lịch khách (userConflict)

        BUS_Preview -> DAO_User: fetchEmployeesByRole("SALE_STAFF")
        activate DAO_User
        deactivate DAO_User

        BUS_Preview -> BUS_Preview: Tìm nhân viên Sale rảnh rỗi (staffConflict)

        opt Nếu có nhân viên Sale rảnh rỗi
            BUS_Preview -> DAO_Preview: insert(newForm)
            activate DAO_Preview
            deactivate DAO_Preview
        end

    deactivate BUS_Preview
    
    note right of GUI_Preview: Hiển thị màn hình Success và đóng sau 2s
deactivate GUI_Preview
@enduml