@startuml system_login_sequence

title System Sequence Diagram - Login (3-Tier)

autonumber

actor "User" as ActorUser
boundary "UI: Login Page" as LoginUI
control "Business: User Service" as UserService
database "Database: User" as UserDB

ActorUser -> LoginUI : Enter username/password
ActorUser -> LoginUI : Click "Login"

LoginUI -> UserService : login(username, password)

alt Missing input
  UserService --> LoginUI : Validation error
  LoginUI --> ActorUser : Show message "Please fill all fields"
else Input valid
  UserService -> UserDB : findByUsername(username)S
  UserDB --> UserService : userRecord / null

  alt User not found
    UserService --> LoginUI : Login failed
    LoginUI --> ActorUser : Show message "Invalid credentials"
  else User found
    UserService -> UserService : verifyPassword(password, hash)

    alt Wrong password
      UserService --> LoginUI : Login failed
      LoginUI --> ActorUser : Show message "Invalid credentials"
    else Correct password
      UserService -> UserService : createSession(userId)
      UserService --> LoginUI : Login success + session token
      LoginUI --> ActorUser : Redirect to dashboard
    end
  end
end

@enduml
