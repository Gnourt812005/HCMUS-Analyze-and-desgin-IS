@startuml QuanLyKyTucXa_ClassDiagram
title Class Diagram - UC18: Quản lý ký túc xá

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenDormManagement" as ScreenDM <<boundary>> {
    - dgvDorm: GridView
    - txtSearch: TextBox
    - btnAddNew: Button
    + dgvDormLoad(): void
    + btnSearchClick(): void
    + btnAddNewClick(): void
}

class "ScreenDormDetail" as ScreenDD <<boundary>> {
    - lblName: Label
    - lblAddress: Label
    - dgvRoom: GridView
    - btnUpdate: Button
    - btnHide: Button
    - btnAddNewRoom: Button
    + screenDormDetailLoad(): void
    + btnUpdateClick(): void
    + btnHideClick(): void
    + btnAddNewRoomClick(): void
}

class "FormDorm" as FormDorm <<boundary>> {
    - txtId: TextBox
    - txtName: TextBox
    - txtAddress: TextBox
    - txtHotline: TextBox
    - clbUtilities: CheckedListBox
    - btnSave: Button
    - btnCancel: Button
    + btnSaveClick(): void
}

' --- BUSINESS LAYER ---
class "Dorm" as Dorm <<control>> {
    - id: string
    - name: string
    - address: string
    - status: string
    - managerId: string
    - description: string
    + <<static>> getDorms(keyword: string): List<Dorm>
    + <<static>> getDormDetail(id: string): Dorm
    + <<static>> createDorm(data: Dorm): boolean
    + <<static>> updateDorm(id: string, data: Dorm): boolean
    + <<static>> deleteDorm(id: string): boolean
}

' --- DATABASE LAYER ---
class "DormDB" as DormDB <<entity>> {
    + <<static>> fetchAll(): List
    + <<static>> fetchByKeyword(keyword: string): List
    + <<static>> fetchById(id: string): Dorm
    + <<static>> insert(data: Dorm): boolean
    + <<static>> update(id: string, data: Dorm): boolean
    + <<static>> delete(id: string): boolean
    + updateStatus(id: string, status: string): boolean
    + checkIdExists(id: string): boolean
}

' --- RELATIONSHIPS ---
ScreenDM "1" --> "1" Dorm
ScreenDD "1" --> "1" Dorm
FormDorm "1" --> "1" Dorm
Dorm "1" --> "1" DormDB
ScreenDM ..> ScreenDD : Mở Chi tiết 
ScreenDM ..> FormDorm : Mở Form Thêm 
ScreenDD ..> FormDorm : Mở Form Sửa 

@enduml
