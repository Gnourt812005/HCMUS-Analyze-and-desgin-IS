@startuml QuanLyKyTucXa_ClassDiagram
title Class Diagram - UC18: Quản lý ký túc xá

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "AdminDorm" <<boundary>> {
    - dorms: DormDTO[]
    - setDorms: void
    - loading: boolean
    - setLoading: void
    - page: number
    - setPage: void
    - limit: number
    - setLimit: void
    - total: number
    - setTotal: void
    - searchQuery: string
    - setSearchQuery: void
    + btnAddDorm: Button
    + txtSearch: Input
    + tblDorms: Table
    + btnEdit: Button
    + btnDelete: Button
    + lblPaginationInfo: Label
    + btnPrevPage: Button
    + btnNextPage: Button
    + fetchDorms(): void
    + handleDelete(id: string): void
}

class "AdminDormDetail" <<boundary>> {
    - dorm: DormDTO | null
    - dormFee: DormFeeDTO | null
    - rooms: RoomDTO[]
    - setRooms: void
    - availableUtilities: UtilityDTO[]
    - setAvailableUtilities: void
    - loading: boolean
    - setLoading: void
    - isEditing: boolean
    - setIsEditing: void
    - isEditingFees: boolean
    - setIsEditingFees: void
    - formData: CreateDormDTO | UpdateDormDTO
    - setFormData: void
    - feeFormData: UpdateDormFeeDTO
    - setFeeFormData: void
    + lblDormName: Input
    + btnEditMode: Button
    + btnBack: Button
    + txtDormName: Input
    + txtAddress: Input
    + txtPhone: Input
    + txtTotalRooms: Label
    + selStatus: Select
    + txtManagerEmail: Input
    + tblUtilities: Table
    + selAddUtility: Select
    + btnSaveDorm: Button
    + btnEditFees: Button
    + txtWaterFee: Input
    + txtElectricityFee: Input
    + txtWifiFee: Input
    + txtCleaningFee: Input
    + btnSaveFees: Button
    + tblRooms: Table
    + fetchData(): void
    + handleSave(): void
    + handleSaveFees(): void
}

' --- DTO LAYER ---
interface "DormDTO" <<dto>> {
    + id: string
    + name: string
    + address: string
    + phone: string
    + status: string
    + totalRooms: number
    + availableRooms: number
    + managerId: string
    + utilityIds: string[]
    + utilities: { id: string, title: string, status: string }[]
}

interface "RoomDTO" <<dto>> {
    + id: string
    + name: string
    + type: string
    + price: number
    + status: string
}

interface "UtilityDTO" <<dto>> {
    + id: string
    + title: string
    + type: string
    + status?: string
}

interface "DormFeeDTO" <<dto>> {
    + dormId: string
    + waterFee: number
    + electricityFee: number
    + wifiFee: number
    + cleaningFee: number
}


interface "GetDormsDto" <<dto>> {
    + page: number
    + limit: number
    + keyword?: string
}

interface "GetRoomDto" <<dto>> {
    + page: number
    + limit: number
    + dormId?: string
}

interface "GetUtilityDto" <<dto>> {
    + page: number
    + limit: number
    + type?: string
}

' --- BUSINESS LAYER ---
class "Dorm" <<control>> {
    - id: string
    - name: string
    - address: string
    - phone: string
    - status: string
    - totalRooms: number
    - availableRooms: number
    - managerId: string
    - utilityIds: string[]
    + <<static>> getAll(query: GetDormsDto): { dorms: DormDTO[], total: number }
    + <<static>> getById(id: string): DormDTO
    + <<static>> create(data: CreateDormDTO): boolean
    + <<static>> update(id: string, data: UpdateDormDTO): boolean
    + <<static>> delete(id: string): boolean
    + toDTO(): DormDTO
}

class "DormFee" <<control>> {
    - dormId: string
    - waterFee: number
    - electricityFee: number
    - wifiFee: number
    - cleaningFee: number
    + <<static>> getByDormId(dormId: string): DormFee
    + <<static>> update(dormId: string, data: UpdateDormFeeDTO): boolean
    + toDTO(): DormFeeDTO
}

class "Room" <<control>> {
    + <<static>> fetchAll(query: GetRoomDto): { rooms: RoomDTO[], total: number }
    + <<static>> getByDormId(dormId: string): RoomDTO[]
    + <<static>> deleteByDormId(dormId: string): boolean
}

class "Utility" <<control>> {
    + <<static>> fetchAll(query: GetUtilityDto): { utilities: UtilityDTO[], total: number }
}


' --- DATABASE LAYER ---
class "DormDB" <<database>> {
    + <<static>> fetchAll(query: GetDormsDto): { dorms: Dorm[], total: number }
    + <<static>> fetchById(id: string): Dorm
    + <<static>> insert(data: Dorm): string
    + <<static>> update(id: string, data: any): boolean
    + <<static>> delete(id: string): boolean
}

class "DormFeeDB" <<database>> {
    + <<static>> fetchByDormId(dormId: string): DormFeeDTO
    + <<static>> create(data: CreateDormFeeDTO): DormFeeDTO
    + <<static>> update(dormId: string, data: UpdateDormFeeDTO): boolean
    + <<static>> delete(dormId: string): boolean
}

class "RoomDB" <<database>> {
    + <<static>> getByDormId(dormId: string): Room[]
    + <<static>> deleteByDormId(dormId: string): boolean
}


' --- RELATIONSHIPS ---
AdminDorm --> Dorm
AdminDormDetail --> Dorm
AdminDormDetail --> Room
AdminDormDetail --> Utility
AdminDormDetail --> DormFee
Dorm --> DormDB

Dorm --> DormFeeDB
DormFee --> DormFeeDB
AdminDorm ..> AdminDormDetail
Room --> RoomDB
Dorm --> Room
Dorm --> DormFee

@enduml
