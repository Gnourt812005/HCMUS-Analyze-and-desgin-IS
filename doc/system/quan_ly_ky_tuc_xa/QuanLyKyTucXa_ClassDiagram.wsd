@startuml QuanLyKyTucXa_ClassDiagram
title Class Diagram - UC18: Quản lý ký túc xá

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "AdminDorm" as ScreenDM <<boundary>> {
    ' --- React States ---
    - dorms: DormDTO[]
    - loading: boolean
    - searchQuery: string
    ' --- State Setters ---
    + setDorms(data: DormDTO[]): void
    + setLoading(status: boolean): void
    + setSearchQuery(query: string): void
    ' --- Methods ---
    + fetchDorms(): Promise<void>
    + handleDelete(id: string): Promise<void>
}

class "AdminDormDetail" as ScreenDD <<boundary>> {
    - dorm: DormDTO | null
    - rooms: RoomDTO[]
    - loading: boolean
    - isEditing: boolean
    - formData: CreateDormDTO | UpdateDormDTO
    + setDorm(data: DormDTO): void
    + setRooms(data: RoomDTO[]): void
    + setIsEditing(edit: boolean): void
    + setFormData(data: any): void
    + screenDormDetailLoad(): Promise<void>
    + handleSave(): Promise<void>
}

' --- BUSINESS LAYER ---
class "Dorm" as Dorm <<control>> {
    - id: string
    - name: string
    - address: string
    - phone: string
    - status: string
    - totalRooms: number
    - availableRooms: number
    - managerId: string
    + <<static>> getAll(keyword?: string): Promise<DormDTO[]>
    + <<static>> getById(id: string): Promise<DormDTO>
    + <<static>> create(data: CreateDormDTO): Promise<boolean>
    + <<static>> update(id: string, data: UpdateDormDTO): Promise<boolean>
    + <<static>> delete(id: string): Promise<boolean>
}

' --- DATABASE LAYER ---
class "DormDB" as DormDB <<entity>> {
    + <<static>> fetchAll(): Promise<Dorm[]>
    + <<static>> fetchByKeyword(keyword: string): Promise<Dorm[]>
    + <<static>> fetchById(id: string): Promise<Dorm | null>
    + <<static>> insert(data: Dorm): Promise<boolean>
    + <<static>> update(id: string, data: any): Promise<boolean>
    + <<static>> delete(id: string): Promise<boolean>
    + <<static>> updateStatus(id: string, status: string): Promise<boolean>
    + <<static>> checkIdExists(id: string): Promise<boolean>
}

' --- RELATIONSHIPS ---
ScreenDM "1" --> "1" Dorm : Gọi xử lý
ScreenDD "1" --> "1" Dorm : Gọi xử lý
Dorm "1" --> "1" DormDB : Truy cập dữ liệu
ScreenDM ..> ScreenDD : Điều hướng (Chi tiết/Thêm mới)

@enduml
