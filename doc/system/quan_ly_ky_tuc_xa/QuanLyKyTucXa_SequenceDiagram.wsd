@startuml QuanLyKyTucXa_SequenceDiagram
title Sequence Diagram - UC18: Quản lý ký túc xá

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    ParticipantPadding 20
    BoxPadding 10
}

actor "Nhân viên quản lý" as Actor
boundary "ScreenDormManagement" as MainGUI <<boundary>>
boundary "ScreenDormDetail" as DetailGUI <<boundary>>
boundary "FormDorm" as FormGUI <<boundary>>
control "Dorm" as BUS <<control>>
database "DormDB" as DB <<database>>

autonumber

== Kịch bản 1 & 2: Xem danh sách và chi tiết KTX ==
Actor -> MainGUI: Chọn tab "Ký túc xá"
MainGUI -> BUS: getDorms()
BUS -> DB: fetchAll()
DB --> BUS: Kết quả
BUS --> MainGUI: Kết quả
MainGUI --> Actor: Hiển thị danh sách

Actor -> MainGUI: Nhấn chọn 1 KTX
MainGUI -> DetailGUI: showDetails(id)
DetailGUI -> BUS: getDormDetail(id)
BUS -> DB: fetchById(id)
DB --> BUS: Chi tiết và danh sách phòng
BUS --> DetailGUI: Kết quả
DetailGUI --> Actor: Hiển thị thông tin

== Kịch bản 3: Thêm mới KTX ==
Actor -> MainGUI: Nhấn "Thêm mới"
MainGUI -> FormGUI: showForm("Thêm mới")

Actor -> FormGUI: Nhập dữ liệu và Lưu
FormGUI -> FormGUI: validate()
alt Hợp lệ
    FormGUI -> BUS: createDorm(data)
    BUS -> DB: checkIdExists(id)
    alt ID đã tồn tại
        DB --> BUS: Trả về true
        BUS --> FormGUI: Thông báo lỗi ("ID đã tồn tại")
    else Hợp lệ
        DB --> BUS: Trả về false
        BUS -> DB: insert(data)
        DB --> BUS: Thành công
        BUS --> FormGUI: Trả về kết quả (Thành công)
        FormGUI --> Actor: Thông báo thành công
        FormGUI -> MainGUI: refreshList()
    end
end

== Kịch bản 4: Cập nhật thông tin cơ bản ==
Actor -> DetailGUI: Nhấn "Cập nhật"
DetailGUI -> DetailGUI: unlockFields()

Actor -> DetailGUI: Chỉnh sửa và Nhấn "Lưu thay đổi"
DetailGUI -> DetailGUI: validate()

alt Hợp lệ
    DetailGUI -> BUS: updateDorm(id, data)
    BUS -> DB: update(id, data)
    DB --> BUS: Thành công
    BUS --> DetailGUI: Thành công
    DetailGUI --> Actor: Thông báo thành công
    DetailGUI -> DetailGUI: lockFields()
end

== Kịch bản 5: Thêm phòng (Gắn với KTX hiện tại) ==
Actor -> DetailGUI: Nhấn "Thêm phòng"
DetailGUI -> FormGUI: showPopup("Thêm phòng mới")

Actor -> FormGUI: Nhập dữ liệu phòng và Lưu
FormGUI -> BUS: addRoomToDorm(dormId, roomData)
BUS -> DB: updateRoom(dormId, roomData)
DB --> BUS: Thành công
BUS --> FormGUI: Trả về kết quả
FormGUI --> Actor: Thông báo thành công
FormGUI -> DetailGUI: refreshRoomList()

== Kịch bản 6: Ẩn KTX (Xóa mềm) ==
Actor -> DetailGUI: Nhấn "Ẩn KTX"
DetailGUI -> DetailGUI: showConfirmPopup()
Actor -> DetailGUI: Xác nhận
DetailGUI -> BUS: hideDorm(id)
BUS -> DB: updateStatus(id, "Hidden")
DB --> BUS: Thành công
BUS --> DetailGUI: Thành công
DetailGUI --> Actor: Thông báo thành công
DetailGUI -> DetailGUI: updateStatusBadge()

@enduml
