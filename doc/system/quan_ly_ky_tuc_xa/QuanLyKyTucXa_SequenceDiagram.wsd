@startuml QuanLyKyTucXa_SequenceDiagram
title Sequence Diagram - UC18: Quản lý ký túc xá

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    ParticipantPadding 20
    BoxPadding 10
}

actor "Nhân viên quản lý" as Actor
boundary "AdminDorm" as MainGUI <<boundary>>
boundary "AdminDormDetail" as DetailGUI <<boundary>>
control "Dorm" as BUS <<control>>
control "Room" as ROOM <<control>>
control "Utility" as UTIL <<control>>
control "DormFee" as FEE <<control>>
database "DormDB" as DB <<database>>
database "DormFeeDB" as FDB <<database>>
database "RoomDB" as RDB <<database>>
database "UtilityDB" as UDB <<database>>

autonumber


== Kịch bản 1: Xem danh sách KTX ==
Actor -> MainGUI: Mở trang Quản lý KTX / Tìm kiếm
MainGUI -> MainGUI: fetchDorms()
MainGUI -> BUS: getAll(query)
BUS -> DB: fetchAll(query)
DB --> BUS: { dorms, total }
BUS --> MainGUI: { dorms, total }

== Kịch bản 2: Xem chi tiết KTX ==
Actor -> MainGUI: Chọn 1 KTX
MainGUI -> DetailGUI: Chuyển hướng (/admin/dorms/:id)
DetailGUI -> DetailGUI: fetchData()
DetailGUI -> BUS: getById(id)
BUS -> DB: fetchById(id)
DetailGUI -> ROOM: fetchAll(query)
ROOM -> RDB: fetchAll(query)
DetailGUI -> UTIL: fetchAll(query)
UTIL -> UDB: fetchAll(query)
DetailGUI -> FEE: getByDormId(id)
FEE -> FDB: fetchByDormId(id)

== Kịch bản 3: Thêm mới KTX ==
Actor -> MainGUI: Nhấn "Thêm cơ sở mới"
MainGUI -> DetailGUI: Mở trang (/admin/dorms/new)
Actor -> DetailGUI: Nhập thông tin & Nhấn Lưu
DetailGUI -> DetailGUI: handleSave()
DetailGUI -> BUS: create(formData)
BUS -> DB: insert(dormModel)
DB --> BUS: newDormId
BUS -> FDB: create(defaultFees)

== Kịch bản 4: Cập nhật KTX ==
Actor -> DetailGUI: Chỉnh sửa & Nhấn Lưu
DetailGUI -> DetailGUI: handleSave()
DetailGUI -> BUS: update(id, formData)
BUS -> DB: update(id, data)

== Kịch bản 5: Xóa KTX ==
Actor -> MainGUI: Nhấn nút Xóa & Xác nhận
MainGUI -> MainGUI: handleDelete(id)
MainGUI -> BUS: delete(id)
BUS -> DB: fetchById(id)
BUS -> RDB: getByDormId(id)
alt Có phòng đang có người ở (availableBeds < totalBeds)
    BUS --> MainGUI: Ném lỗi (Không thể xóa)
    MainGUI --> Actor: Hiển thị thông báo lỗi
else Tất cả phòng trống hoặc không có phòng
    BUS -> FDB: delete(id)
    BUS -> ROOM: deleteByDormId(id)
    ROOM -> RDB: deleteByDormId(id)
    BUS -> DB: delete(id)
    DB --> BUS: Thành công
    BUS --> MainGUI: Thành công
end


== Kịch bản 6: Cập nhật chi phí KTX ==
Actor -> DetailGUI: Chỉnh sửa phí & Nhấn Lưu
DetailGUI -> DetailGUI: handleSaveFees()
DetailGUI -> FEE: update(id, feeFormData)
FEE -> FDB: update(id, data)

@enduml
