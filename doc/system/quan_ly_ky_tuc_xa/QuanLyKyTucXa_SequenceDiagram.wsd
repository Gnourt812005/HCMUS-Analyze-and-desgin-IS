@startuml QuanLyKyTucXa_SequenceDiagram
title Sequence Diagram - UC18: Quản lý ký túc xá

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    ParticipantPadding 20
    BoxPadding 10
}

actor "Nhân viên quản lý" as Actor
participant "AdminDorm" as MainGUI
participant "AdminDormDetail" as DetailGUI
participant "Dorm" as BUS <<control>>
participant "DormDB" as DB <<entity>>

== Kịch bản 1: Xem danh sách KTX ==
Actor -> MainGUI: Mở trang Quản lý KTX
MainGUI -> BUS: getAll()
BUS -> DB: fetchAll()

== Kịch bản 2: Tìm kiếm KTX ==
Actor -> MainGUI: Nhập từ khóa & Tìm kiếm
MainGUI -> BUS: getAll(keyword)
BUS -> DB: fetchByKeyword(keyword)

== Kịch bản 3: Xem chi tiết KTX ==
Actor -> MainGUI: Chọn 1 KTX
MainGUI -> DetailGUI: Hiển thị chi tiết (id)
DetailGUI -> BUS: getById(id)
BUS -> DB: fetchById(id)

== Kịch bản 4: Thêm mới KTX ==
Actor -> MainGUI: Nhấn "Thêm cơ sở mới"
MainGUI -> DetailGUI: Mở trang thêm mới (/new)
Actor -> DetailGUI: Nhập thông tin & Nhấn Lưu
DetailGUI -> BUS: create(formData)
BUS -> DB: insert(newDorm)

== Kịch bản 5: Cập nhật KTX ==
Actor -> MainGUI: Nhấn "Sửa" trên Card (hoặc vào chi tiết rồi nhấn Sửa)
MainGUI -> DetailGUI: Mở trang chi tiết ở chế độ Edit
Actor -> DetailGUI: Chỉnh sửa thông tin & Nhấn Lưu
DetailGUI -> BUS: update(id, formData)
BUS -> DB: update(id, data)

== Kịch bản 6: Xóa KTX (Hard Delete) ==
Actor -> MainGUI: Nhấn nút Xóa
MainGUI -> Actor: Hiển thị xác nhận xóa?
Actor -> MainGUI: Xác nhận
MainGUI -> BUS: delete(id)
BUS -> DB: delete(id)

@enduml
