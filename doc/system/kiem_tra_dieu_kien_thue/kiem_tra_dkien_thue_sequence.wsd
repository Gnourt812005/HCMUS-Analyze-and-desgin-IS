@startuml KiemTraDieuKien_SequenceDiagram
title Sequence Diagram - UC15: Kiểm tra điều kiện thuê

autonumber

actor "Customer" as Actor
boundary "ScreenPolicy" as GUI <<boundary>>
control "Policy" as BUS <<control>>
database "PolicyDB" as DB <<database>>

GUI -> BUS : getLatestRegulations()
BUS -> DB : findActivePolicy()
DB --> BUS : Nội dung quy định
BUS --> GUI : displayPolicyContent()

GUI --> Actor : Hiển thị nội dung quy định

alt Khách hàng không đồng ý
    Actor -> GUI : Nhấn "Không đồng ý"
    GUI --> Actor : Thông báo lỗi ("Cần đồng ý quy định để thuê phòng")
else Khách hàng đồng ý
    Actor -> GUI : Nhấn "Đồng ý"
    GUI -> BUS : confirmAgreement(customerId)
    BUS --> GUI : Đã lưu xác nhận
    GUI --> Actor : Chuyển hướng về luồng Đặt cọc
end

@enduml