@startuml DangNhap_SequenceDiagram
title Sequence Diagram: Đăng nhập

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    ParticipantPadding 20
    BoxPadding 10
}

actor "Khách hàng / Nhân viên" as Actor
boundary "ScreenLogin" as GUI <<boundary>>
control "User" as BUS <<control>>
database "UserDB" as DAO <<database>>

autonumber

Actor -> GUI: Nhập email và mật khẩu
Actor -> GUI: Bấm nút "Đăng nhập"

activate GUI
GUI -> GUI: Kiểm tra thông tin đầu vào (validate)

alt Thông tin trống (A5.1)
    GUI --> Actor: Hiển thị thông báo lỗi (Yêu cầu nhập đủ)
else Thông tin đầy đủ
    GUI -> BUS: login(email, password)
    activate BUS
    
    BUS -> DAO: checkCredentials(email, password)
    activate DAO
    
    DAO --> BUS: Trả kết quả (True/False)
    deactivate DAO
    
    BUS --> GUI: Trả kết quả đăng nhập (True/False)
    deactivate BUS
    
    alt Kết quả = False (A5.2)
        GUI --> Actor: Hiển thị thông báo lỗi \n "Thông tin đăng nhập không chính xác"
    else Kết quả = True
        GUI --> Actor: Hiển thị thông báo "Đăng nhập thành công"
        GUI -> GUI: Điều hướng người dùng về trang chủ
    end
end
deactivate GUI

@enduml
