@startuml ThanhLyHopDong_ClassDiagram
title Class Diagram - UC25: Thanh lý hợp đồng

skinparam {
    ClassBackgroundColor White
    ArrowColor #2D3E50
    ClassBorderColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ClassBorderThickness 2
    StereotypeFontColor #2D3E50
    Padding 5
}

class "ScreenContractTermination" as ContractLiquidationScreen <<boundary>> {
  - lblContractInfo: Label
  - lblRefundInfo: Label
  - btnComplete: Button
  - btnBack: Button
  + show(requestId: string): void
  + loadCalculation(): void
  + btnCompleteClick(): void
}

class "Contract" as Contract <<control>> {
  - contractId: string
  - contractCode: string
  - userEmail: string
  - roomName: string
  - dormName: string
  - floor: number
  - bedNumbers: string
  - startDate: string
  - stayDuration: number
  - rentalFormId: string
  - status: ContractStatus
  - depositAmount: number
  - signatureUrl: string
  - createdAt: string
  + <<static>> getByContractId(contractId: string): Contract 
  + <<static>> updateStatus(contractId: string, status: ContractStatus): bool
  + <<static>> getBedsInfoByContractId(contractId: string): {roomId: string, bedIds: string[]} 
}

class "ContractDB" as ContractDB <<entity>> {
  + <<static>> updateStatus(id: string, status: string): bool
}

class "Room" as Room <<control>> {
  - id: string
  - dormId: string
  - name: string
  - block: string
  - floor: number
  - price: number
  - totalBeds: number
  - availableBeds: number
  - status: string
  - imageUrl: string
  + <<static>> updateBedStatus(roomId: string, bedIds: string[], status: string): bool
}

class "RoomDB" as RoomDB <<entity>> {
  + <<static>> markBedsStatus(roomId: string, bedIds: string[], status: string): bool
}

class "RefundCalculation" as RefundCalculation <<control>> {
  - calculationId: string
  - requestId: string
  - contractId: string
  - depositAmount: number
  - damageFee: number
  - extraFee: number
  - finalRefundAmount: number
  - notes: string
  - createdAt: string
  + <<static>> getByRequestId(requestId: string): RefundCalculation 
}

class "RefundCalculationDB" as RefundCalculationDB <<entity>> {
  + <<static>> getByRequestId(requestId: string): RefundCalculation
}

ContractLiquidationScreen --> Contract
ContractLiquidationScreen --> RefundCalculation
Contract --> ContractDB
ContractLiquidationScreen --> Room
Room --> RoomDB
RefundCalculation --> RefundCalculationDB

@enduml
