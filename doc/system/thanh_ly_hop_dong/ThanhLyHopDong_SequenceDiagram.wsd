@startuml ThanhLyHopDong_SequenceDiagram
title Sequence Diagram - UC25: Thanh lý hợp đồng

skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
}

autonumber

actor "Nhân viên" as nv
boundary "ScreenContractTermination" as screen
control "Contract" as contract
control "Room" as room
database "ContractDB" as contractDb
database "RoomDB" as roomDb

nv -> screen: show(requestId)
activate nv
deactivate nv
activate screen
deactivate screen

nv -> screen: Nhấn "Hoàn tất thanh lý"
activate nv
activate screen

screen -> contract: updateStatus(contractId, ContractStatus.LIQUIDATED)
activate contract
contract -> contractDb: updateStatus(contractId, ContractStatus.LIQUIDATED)
activate contractDb
contractDb --> contract: bool (true)
deactivate contractDb
contract --> screen: bool (true)
deactivate contract

screen -> contract: getBedsInfoByContractId(contractId)
activate contract
contract -> contractDb: getBedsInfoByContractId(contractId)
activate contractDb
contractDb --> contract: {roomId: string, bedIds: string[]}
deactivate contractDb
contract --> screen: {roomId: string, bedIds: string[]}
deactivate contract

screen -> room: updateBedStatus(roomId, bedIds, "AVAILABLE")
activate room
room -> roomDb: markBedsStatus(roomId, bedIds, "AVAILABLE")
activate roomDb
roomDb --> room: bool (true)
deactivate roomDb
room --> screen: bool (true)
deactivate room

screen --> nv: Thông báo thành công
deactivate screen
deactivate nv

@enduml
