@startuml ChinhSuaThongTinCaNhan_SequenceDiagram
title Sequence Diagram - UC27: Chỉnh sửa thông tin cá nhân

skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    ParticipantPadding 20
    BoxPadding 10
    SequenceGroupBodyBackgroundColor #F8F9FA
}

actor "Người dùng" as Actor
boundary "ScreenProfile" as GUI <<boundary>>
participant "UserProfileDTO" as DTO <<dto>>
participant "ChangePasswordDTO" as PWDTO <<dto>>
control "User" as BUS <<control>>
database "UserDB" as DB <<database>>

autonumber

group 1. Xem hồ sơ cá nhân
    Actor -> GUI: Mở trang cá nhân
    GUI -> BUS: getProfile(email)
    BUS -> DB: fetchCredentialByEmail(email)
end

group 2. Cập nhật thông tin cơ bản
    Actor -> GUI: Thay đổi thông tin & Nhấn "Cập nhật"
    GUI -> BUS: updateProfile(email, userProfileDTO)
    BUS -> DB: update(email, userProfileDTO)
    deactivate GUI
end

group 3. Đổi mật khẩu
    Actor -> GUI: Nhập MK cũ, MK mới & Nhấn "Đổi mật khẩu"
    GUI -> BUS: changePassword(email, changePasswordDTO)
    BUS -> DB: fetchCredentialByEmail(email)
    BUS -> BUS: verifyPassword(oldPassword)
    
    alt Mật khẩu cũ không khớp
        BUS --> GUI: Error("Mật khẩu cũ không chính xác")
        GUI --> Actor: Hiển thị thông báo lỗi
    else Mật khẩu cũ hợp lệ
        BUS -> DB: updatePassword(email, newPassword)
        activate DB
        DB --> BUS: true
        deactivate DB
        BUS --> GUI: true
        GUI --> Actor: Thông báo "Đổi mật khẩu thành công"
    end
    deactivate BUS
    deactivate GUI
end

@enduml

