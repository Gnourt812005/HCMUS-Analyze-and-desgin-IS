@startuml ChinhSuaThongTinCaNhan_ClassDiagram

title Class Diagram - UC27: Quản lý thông tin cá nhân

skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ProfilePage" <<boundary>> {
    - profile: UserProfileDTO
    - setProfile: void
    - isLoading: boolean
    - setIsLoading: void
    + fetchProfile(): void
    + handleUpdate(): void
    + handlePasswordChange(): void
}

' --- DTO LAYER ---
interface "UserProfileDTO" <<dto>> {
    + email: string
    + fullName: string
    + cccd: string
    + birthday: string
    + gender: string
    + phone: string
    + address: string
}

interface "ChangePasswordDTO" <<dto>> {
    + oldPassword: string
    + newPassword: string
}

' --- BUSINESS LAYER ---
class "User" <<control>> {
    - email: string
    - fullName: string
    - password: string
    - cccd: string
    - birthday: string
    - gender: string
    - phone: string
    - address: string
    - role: UserRole
    + <<static>> getProfile(email: string): UserProfileDTO
    + <<static>> updateProfile(email: string, data: UserProfileDTO): boolean
    + <<static>> changePassword(email: string, data: ChangePasswordDTO): boolean
}

' --- DATABASE LAYER ---
class "UserDB" <<entity>> {
    + <<static>> fetchCredentialByEmail(email: string): User
    + <<static>> update(email: string, data: UserProfileDTO): boolean
    + <<static>> updatePassword(email: string, newPassword: string): boolean
}

ProfilePage ..> UserProfileDTO
ProfilePage ..> ChangePasswordDTO
ProfilePage "1" --> "1" User
User "1" --> "1" UserDB

@enduml

