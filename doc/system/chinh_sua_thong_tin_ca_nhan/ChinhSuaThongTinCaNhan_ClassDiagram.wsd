@startuml ChinhSuaThongTinCaNhan_ClassDiagram
title Class Diagram - UC27: Chỉnh sửa thông tin cá nhân

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenProfile" <<boundary>> {
    - profile: UserProfileDTO
    - isLoading: boolean
    + txtFullName: Input
    + txtPhone: Input
    + txtCCCD: Input
    + txtAddress: Input
    + dpBirthday: DatePicker
    + btnSave: Button
    + txtOldPassword: Input
    + txtNewPassword: Input
    + btnChangePassword: Button
    + fetchProfile(): void
    + handleUpdate(): void
    + handlePasswordChange(): void
}

' --- DTO LAYER ---
interface "UserProfileDTO" <<dto>> {
    + email: string
    + fullName: string
    + cccd: string
    + birthday: string
    + gender: string
    + phone: string
    + address: string
    + role: string
}

interface "ChangePasswordDTO" <<dto>> {
    + oldPassword: string
    + newPassword: string
}

' --- BUSINESS LAYER ---
class "User" <<control>> {
    + <<static>> getProfile(email: string): UserProfileDTO
    + <<static>> updateProfile(email: string, data: UserProfileDTO): boolean
    + <<static>> changePassword(email: string, data: ChangePasswordDTO): boolean
}

' --- DATABASE LAYER ---
class "UserDB" <<entity>> {
    + <<static>> fetchCredentialByEmail(email: string): User
    + <<static>> update(email: string, data: UserProfileDTO): boolean
    + <<static>> updatePassword(email: string, newPassword: string): boolean
}

' --- RELATIONSHIPS ---
ScreenProfile ..> UserProfileDTO
ScreenProfile ..> ChangePasswordDTO
ScreenProfile --> User
User --> UserDB

@enduml

