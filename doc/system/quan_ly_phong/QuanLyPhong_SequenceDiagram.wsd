@startuml QuanLyPhong_SequenceDiagram
title Sequence Diagram - UC19: Quản lý phòng

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    ParticipantPadding 20
    BoxPadding 10
}

actor "Nhân viên quản lý" as Actor
boundary "AdminRooms" as MainGUI <<boundary>>
boundary "AdminRoomDetail" as DetailGUI <<boundary>>
control "Room" as BUS_Room <<control>>
control "Bed" as BUS_Bed <<control>>
control "Dorm" as BUS_Dorm <<control>>
control "Utility" as BUS_Util <<control>>
database "RoomDB" as RDB <<database>>
database "DormDB" as DDB <<database>>
database "UtilityDB" as UDB <<database>>

autonumber

== Kịch bản 1: Xem danh sách phòng (bao gồm Tìm kiếm & Phân trang) ==
Actor -> MainGUI: Mở trang Quản lý Phòng
MainGUI -> MainGUI: fetchRooms()
MainGUI -> BUS_Room: fetchAll(query)
BUS_Room -> RDB: fetchAll(query)

== Kịch bản 2: Xem chi tiết phòng ==
Actor -> MainGUI: Chọn 1 phòng
MainGUI -> DetailGUI: Chuyển hướng (/admin/rooms/:id)
DetailGUI -> DetailGUI: fetchData()
par 
    DetailGUI -> BUS_Util: fetchAll({type: 'ROOM'})
    BUS_Util -> UDB: fetchAll()
    DetailGUI -> BUS_Dorm: getAll({limit: 100})
    BUS_Dorm -> DDB: fetchAll()
end
DetailGUI -> BUS_Room: getById(id)
BUS_Room -> RDB: fetchById(id)

== Kịch bản 3: Thêm phòng mới ==
Actor -> MainGUI: Nhấn "Thêm phòng mới"
MainGUI -> DetailGUI: Mở trang (/admin/rooms/new)
DetailGUI -> DetailGUI: fetchData()
Actor -> DetailGUI: Nhập dữ liệu & Lưu
DetailGUI -> DetailGUI: handleSaveRoom()
DetailGUI -> BUS_Room: create(formData)
BUS_Room -> RDB: insert(data)

== Kịch bản 4: Cập nhật thông tin phòng ==
Actor -> DetailGUI: Chỉnh sửa & Nhấn Lưu
DetailGUI -> DetailGUI: handleSaveRoom()
DetailGUI -> BUS_Room: update(id, formData)
BUS_Room -> RDB: update(id, data)

== Kịch bản 5: Xóa phòng ==
Actor -> MainGUI: Nhấn Xóa & Xác nhận
MainGUI -> MainGUI: handleDelete(id)
MainGUI -> BUS_Room: delete(id)
BUS_Room -> RDB: fetchById(id)
alt Có giường đang có người ở (status != 'AVAILABLE')
    BUS_Room --> MainGUI: Ném lỗi (Không thể xóa)
    MainGUI --> Actor: Hiển thị thông báo lỗi
else Tất cả giường trống
    BUS_Room -> RDB: deleteBedsByRoomId(id)
    BUS_Room -> RDB: delete(id)
    RDB --> BUS_Room: Thành công
    BUS_Room --> MainGUI: Thành công
end


== Kịch bản 6 & 7: Quản lý Giường (Thêm/Sửa) ==
Actor -> DetailGUI: Nhấn Thêm/Sửa giường & Lưu
DetailGUI -> DetailGUI: handleAddBed() / handleUpdateBed()
DetailGUI -> BUS_Bed: addBed() / updateBed()
BUS_Bed -> RDB: insertBed() / updateBed()

== Kịch bản 8: Xóa giường ==
Actor -> DetailGUI: Nhấn "Xóa" giường
DetailGUI -> DetailGUI: handleDeleteBed(id)
DetailGUI -> BUS_Bed: deleteBed(id)
BUS_Bed -> RDB: fetchBedById(id)
alt Giường đang có người ở (status != 'AVAILABLE')
    BUS_Bed --> DetailGUI: Ném lỗi (Không thể xóa)
    DetailGUI --> Actor: Hiển thị lỗi
else Giường trống
    BUS_Bed -> RDB: removeBed(id)
    BUS_Bed -> RDB: syncRoomAvailability(roomId)
    BUS_Bed --> DetailGUI: Thành công
end


@enduml

