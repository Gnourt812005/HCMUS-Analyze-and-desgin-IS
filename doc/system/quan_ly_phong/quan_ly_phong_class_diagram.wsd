@startuml QuanLyPhong_ClassDiagram
title Class Diagram - UC19: Quản lý phòng

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenRoomManagement" as ScreenRM <<boundary>> {
    - dgvRoom: GridView
    - txtSearch: TextBox
    - btnAddNew: Button
    + dgvRoomLoad(): void
    + btnSearchClick(): void
    + btnAddNewClick(): void
}

class "ScreenRoomDetail" as ScreenRD <<boundary>> {
    - lblRoomId: Label
    - lblDormName: Label
    - dgvBed: GridView
    - btnUpdate: Button
    - btnDelete: Button
    - btnAddNewBed: Button
    + screenRoomDetailLoad(): void
    + btnUpdateClick(): void
    + btnDeleteClick(): void
    + btnAddNewBedClick(): void
}

class "FormRoom" as FormRoom <<boundary>> {
    - cbDorm: ComboBox
    - txtRoomId: TextBox
    - cbRoomType: ComboBox
    - clbUtilities: CheckedListBox
    - btnSave: Button
    - btnCancel: Button
    + btnSaveClick(): void
}

class "FormBed" as FormBed <<boundary>> {
    - txtBedId: TextBox
    - txtPrice: TextBox
    - btnSave: Button
    - btnCancel: Button
    + btnSaveClick(): void
}

' --- BUSINESS LAYER ---
class "Room" as Room <<control>> {
    - id: string
    - dormId: string
    - roomNumber: string
    - roomType: string
    - price: double
    - status: string
    - capacity: int
    - occupied: int
    + <<static>> getRooms(dormId: string, keyword: string): List<Room>
    + <<static>> getRoomDetail(id: string): Room
    + <<static>> createRoom(data: Room): boolean
    + <<static>> updateRoom(id: string, data: Room): boolean
    + <<static>> deleteRoom(id: string): boolean
    + <<static>> addBed(roomId: string, bedData: any): boolean
    + <<static>> updateBed(bedId: string, bedData: any): boolean
    + <<static>> deleteBed(bedId: string): boolean
}

' --- DATABASE LAYER ---
class "RoomDB" as RoomDB <<entity>> {
    + <<static>> fetchAllByDorm(dormId: string): List
    + <<static>> fetchByKeyword(keyword: string): List
    + <<static>> fetchById(id: string): Room
    + <<static>> insert(data: Room): boolean
    + <<static>> update(id: string, data: Room): boolean
    + <<static>> delete(id: string): boolean
    + <<static>> insertBed(data: any): boolean
    + <<static>> updateBed(bedId: string, bedData: any): boolean
    + <<static>> removeBed(bedId: string): boolean
    + <<static>> checkRoomIdExists(dormId: string, roomId: string): boolean
    + <<static>> checkBedInEffect(bedId: string): boolean
}

' --- RELATIONSHIPS ---
ScreenRM "1" --> "1" Room
ScreenRD "1" --> "1" Room
FormRoom "1" --> "1" Room
FormBed "1" --> "1" Room

Room "1" --> "1" RoomDB

ScreenRM ..> ScreenRD : Mở Chi tiết
ScreenRM ..> FormRoom : Mở Form Thêm Phòng
ScreenRD ..> FormRoom : Mở Form Sửa Phòng
ScreenRD ..> FormBed : Mở Form Giường

@enduml
