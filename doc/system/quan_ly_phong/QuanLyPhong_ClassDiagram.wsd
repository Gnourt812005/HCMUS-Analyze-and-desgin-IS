@startuml QuanLyPhong_ClassDiagram
title Class Diagram - UC19: Quản lý phòng

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 18
    Padding 5
}

' --- BOUNDARY LAYER ---
class "AdminRooms" as ScreenRM <<boundary>> {
    - rooms: RoomDTO[]
    - total: number
    - page: number
    - limit: number
    - searchQuery: string
    + fetchRooms(): Promise<void>
    + handleDelete(id: string): Promise<void>
}

    - room: RoomDTO | null
    - dorms: DormDTO[]
    - availableUtilities: UtilityDTO[]
    - loading: boolean
    - isEditing: boolean
    - editingBed: BedDTO | null
    - formData: any
    + fetchData(): Promise<void>
    + handleSaveRoom(): Promise<void>
    + handleAddBed(): Promise<void>
    + handleUpdateBed(bedId: string): Promise<void>
    + handleDeleteBed(bedId: string): Promise<void>
}

' --- DTO LAYER ---
interface "RoomDTO" {
    + id: string
    + dormId: string
    + name: string
    + block: string
    + floor: number
    + price: number
    + totalBeds: number
    + availableBeds: number
    + amenities: string[]
    + status: string
    + beds?: BedDTO[]
}

interface "GetRoomDto" {
    + page?: number
    + limit?: number
    + search?: string
    + dormId?: string
    + status?: string
    + totalBeds?: number
}

interface "CreateRoomDTO" {
    + dormId: string
    + name: string
    + block: string
    + floor: number
    + totalBeds: number
    + utilityIds?: string[]
}

interface "UpdateRoomDTO" {
    + name?: string
    + block?: string
    + floor?: number
    + status?: string
    + utilityIds?: string[]
}

interface "UtilityDTO" {
    + id: string
    + title: string
    + type: string
    + isLiable: boolean
    + incurredPrice: number
}

interface "GetUtilityDto" {
    + page?: number
    + limit?: number
    + search?: string
    + type?: string
}

interface "GetDormsDto" {
    + page?: number
    + limit?: number
    + keyword?: string
    + status?: string
}

interface "BedDTO" {
    + id: string
    + roomId: string
    + bedNumber: string
    + status: string
    + price: number
}

' --- BUSINESS LAYER ---
class "Room" as Room <<control>> {
    + <<static>> fetchAll(query: GetRoomDto): Promise<{rooms: RoomDTO[], total: number}>
    + <<static>> getById(id: string): Promise<RoomDTO | null>
    + <<static>> create(data: CreateRoomDTO): Promise<boolean>
    + <<static>> update(id: string, data: UpdateRoomDTO): Promise<boolean>
    + <<static>> delete(id: string): Promise<boolean>
}

class "Dorm" as Dorm <<control>> {
    + <<static>> getAll(query: GetDormsDto): Promise<{dorms: DormDTO[], total: number}>
    + <<static>> getById(id: string): Promise<DormDTO | null>
}

class "Bed" as Bed <<control>> {
    + <<static>> addBed(roomId: string, data: BedDTO): Promise<boolean>
    + <<static>> updateBed(bedId: string, data: Partial<BedDTO>): Promise<boolean>
    + <<static>> deleteBed(bedId: string): Promise<boolean>
}

class "Utility" as Utility <<control>> {
    + <<static>> fetchAll(query: GetUtilityDto): Promise<{utilities: UtilityDTO[], total: number}>
    + <<static>> fetchById(id: string): Promise<UtilityDTO | null>
}

' --- DATABASE LAYER ---
class "RoomDB" as RoomDB <<entity>> {
    + <<static>> fetchAll(query: GetRoomDto): Promise<{rooms: RoomDTO[], total: number}>
    + <<static>> fetchById(id: string): Promise<any | null>
    + <<static>> insert(data: CreateRoomDTO): Promise<boolean>
    + <<static>> update(id: string, data: UpdateRoomDTO): Promise<boolean>
    + <<static>> delete(id: string): Promise<boolean>
    + <<static>> insertBed(data: any): Promise<boolean>
    + <<static>> updateBed(bedId: string, data: any): Promise<boolean>
    + <<static>> removeBed(bedId: string): Promise<boolean>
    + <<static>> checkRoomIdExists(dormId: string, name: string): Promise<boolean>
}

class "DormDB" as DormDB <<entity>> {
    + <<static>> fetchAll(query: GetDormsDto): Promise<{dorms: Dorm[], total: number}>
    + <<static>> fetchById(id: string): Promise<Dorm | null>
}

class "UtilityDB" as UtilityDB <<entity>> {
    + <<static>> fetchAll(query: GetUtilityDto): Promise<{utilities: UtilityDTO[], total: number}>
    + <<static>> fetchById(id: string): Promise<UtilityDTO | null>
}

' --- RELATIONSHIPS ---
ScreenRM "1" --> "1" Room
ScreenRD "1" --> "1" Room
ScreenRD "1" --> "1" Bed
ScreenRD "1" --> "1" Utility

Room "1" --> "1" RoomDB 
Bed "1" --> "1" RoomDB
Utility "1" --> "1" UtilityDB

Room ..> RoomDTO 
Room ..> GetRoomDto 
Room ..> CreateRoomDTO 
Room ..> UpdateRoomDTO 
Dorm ..> DormDTO
Dorm ..> GetDormsDto
Bed ..> BedDTO
Utility ..> UtilityDTO
Utility ..> GetUtilityDto

ScreenRM ..> ScreenRD

@enduml
