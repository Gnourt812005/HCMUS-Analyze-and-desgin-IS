@startuml QuanLyPhong_ClassDiagram
title Class Diagram - UC19: Quản lý phòng

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "AdminRooms" as ScreenRM <<boundary>> {
    - rooms: RoomDTO[]
    - loading: boolean
    - searchQuery: string
    + fetchRooms(): Promise<void>
    + handleDelete(id: string): Promise<void>
}

class "AdminRoomDetail" as ScreenRD <<boundary>> {
    - room: RoomDTO | null
    - beds: BedDTO[]
    - loading: boolean
    - isEditing: boolean
    - editingBed: BedDTO | null
    - formData: any
    + setRoom(data: RoomDTO): void
    + setBeds(data: BedDTO[]): void
    + setIsEditing(edit: boolean): void
    + handleSaveRoom(): Promise<void>
    + handleAddBed(): Promise<void>
    + handleUpdateBed(bedId: string): Promise<void>
    + handleDeleteBed(bedId: string): Promise<void>
}

' --- DTO LAYER ---
interface "RoomDTO" {
    + id: string
    + dormId: string
    + name: string
    + block: string
    + tower: string
    + floor: number
    + price: number
    + totalBeds: number
    + availableBeds: number
    + amenities: string[]
    + status: string
    + beds: BedDTO[]
}

interface "CreateRoomDTO" {
    + dormId: string
    + name: string
    + block: string
    + tower: string
    + floor: number
    + price: number
    + totalBeds: number
}

interface "UpdateRoomDTO" {
    + name?: string
    + block?: string
    + tower?: string
    + floor?: number
    + price?: number
    + status?: string
}

interface "BedDTO" {
    + id: string
    + roomId: string
    + bedNumber: string
    + status: string
    + price: number
}

' --- BUSINESS LAYER ---
class "Room" as Room <<control>> {
    - id: string
    - dormId: string
    - name: string
    - block: string
    - tower: string
    - floor: number
    - price: number
    - status: string
    - totalBeds: number
    - availableBeds: number
    + <<static>> getAll(dormId?: string, keyword?: string): Promise<RoomDTO[]>
    + <<static>> getById(id: string): Promise<RoomDTO>
    + <<static>> create(data: CreateRoomDTO): Promise<boolean>
    + <<static>> update(id: string, data: UpdateRoomDTO): Promise<boolean>
    + <<static>> delete(id: string): Promise<boolean>
}

class "Bed" as Bed <<control>> {
    - id: string
    - roomId: string
    - bedNumber: string
    - status: string
    - price: number
    + <<static>> addBed(roomId: string, data: BedDTO): Promise<boolean>
    + <<static>> updateBed(bedId: string, data: BedDTO): Promise<boolean>
    + <<static>> deleteBed(bedId: string): Promise<boolean>
}

' --- DATABASE LAYER ---
class "RoomDB" as RoomDB <<entity>> {
    + <<static>> fetchAll(dormId?: string): Promise<Room[]>
    + <<static>> fetchByKeyword(keyword: string): Promise<Room[]>
    + <<static>> fetchById(id: string): Promise<Room | null>
    + <<static>> insert(data: any): Promise<boolean>
    + <<static>> update(id: string, data: any): Promise<boolean>
    + <<static>> delete(id: string): Promise<boolean>
    + <<static>> insertBed(data: any): Promise<boolean>
    + <<static>> updateBed(bedId: string, data: any): Promise<boolean>
    + <<static>> removeBed(bedId: string): Promise<boolean>
    + <<static>> checkRoomIdExists(dormId: string, name: string): Promise<boolean>
}

' --- RELATIONSHIPS ---
ScreenRM "1" --> "1" Room : Gọi xử lý
ScreenRD "1" --> "1" Room : Gọi xử lý
ScreenRD "1" --> "1" Bed : Quản lý giường

Room "1" --> "1" RoomDB : Truy cập dữ liệu
Bed "1" --> "1" RoomDB : Truy cập dữ liệu

Room ..> RoomDTO : Trả về
Room ..> CreateRoomDTO : Nhận
Room ..> UpdateRoomDTO : Nhận
Bed ..> BedDTO : Trả về/Nhận

ScreenRM ..> ScreenRD : Điều hướng (Chi tiết/Thêm mới)

@enduml
