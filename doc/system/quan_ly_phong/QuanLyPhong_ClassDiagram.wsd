@startuml QuanLyPhong_ClassDiagram
title Class Diagram - UC19: Quản lý phòng

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "AdminRooms" <<boundary>> {
    - rooms: RoomDTO[]
    - setRooms: void
    - total: number
    - setTotal: void
    - page: number
    - setPage: void
    - limit: number
    - setLimit: void
    - searchQuery: string
    - setSearchQuery: void
    + fetchRooms(): void
    + handleDelete(id: string): void
}

class "AdminRoomDetail" <<boundary>> {
    - room: RoomDTO | null
    - setRoom: void
    - dorms: DormDTO[]
    - setDorms: void
    - availableUtilities: UtilityDTO[]
    - setAvailableUtilities: void
    - loading: boolean
    - setLoading: void
    - isEditing: boolean
    - setIsEditing: void
    - editingBed: BedDTO | null
    - setEditingBed: void
    - formData: CreateRoomDTO | UpdateRoomDTO
    - setFormData: void
    + fetchData(): void
    + handleSaveRoom(): void
    + handleAddBed(): void
    + handleUpdateBed(bedId: string): void
    + handleDeleteBed(bedId: string): void
}

' --- DTO LAYER ---
interface "RoomDTO" <<dto>> {
    + id: string
    + dormId: string
    + name: string
    + block: string
    + floor: number
    + price: number
    + totalBeds: number
    + availableBeds: number
    + status: string
    + beds?: BedDTO[]
}

interface "BedDTO" <<dto>> {
    + id: string
    + roomId: string
    + bedNumber: string
    + status: string
    + price: number
}

interface "DormDTO" <<dto>> {
    + id: string
    + name: string
}

interface "UtilityDTO" <<dto>> {
    + id: string
    + title: string
}

interface "GetRoomDto" <<dto>> {
    + page: number
    + limit: number
    + search?: string
    + dormId?: string
}

interface "GetDormDto" <<dto>> {
    + page: number
    + limit: number
    + keyword?: string
}

interface "GetUtilityDto" <<dto>> {
    + page: number
    + limit: number
    + type?: string
}


interface "CreateRoomDTO" <<dto>> {
    + dormId: string
    + name: string
    + block: string
    + floor: number
    + totalBeds: number
    + utilityIds?: string[]
}

interface "UpdateRoomDTO" <<dto>> {
    + name?: string
    + block?: string
    + floor?: number
    + status?: string
    + utilityIds?: string[]
}

' --- BUSINESS LAYER ---
class "Room" <<control>> {
    - id: string
    - dormId: string
    - name: string
    - block: string
    - floor: number
    - price: number
    - status: string
    + <<static>> fetchAll(query: GetRoomDto): { rooms: RoomDTO[], total: number }
    + <<static>> getById(id: string): RoomDTO
    + <<static>> create(data: CreateRoomDTO): boolean
    + <<static>> update(id: string, data: UpdateRoomDTO): boolean
    + <<static>> delete(id: string): boolean
}

class "Bed" <<control>> {
    + <<static>> addBed(roomId: string, data: BedDTO): boolean
    + <<static>> updateBed(bedId: string, data: Partial<BedDTO>): boolean
    + <<static>> deleteBed(bedId: string): boolean
}


class "Dorm" <<control>> {
    + <<static>> getAll(query: GetDormDto): { dorms: DormDTO[], total: number }
}

class "Utility" <<control>> {
    + <<static>> fetchAll(query: GetUtilityDto): { utilities: UtilityDTO[], total: number }
}

' --- DATABASE LAYER ---
class "RoomDB" <<entity>> {
    + <<static>> fetchAll(query: GetRoomDto): { rooms: any[], total: number }
    + <<static>> fetchById(id: string): any
    + <<static>> insert(data: any): boolean
    + <<static>> update(id: string, data: any): boolean
    + <<static>> delete(id: string): boolean
    + <<static>> insertBed(data: any): boolean
    + <<static>> updateBed(id: string, data: any): boolean
    + <<static>> removeBed(id: string): boolean
}

class "DormDB" <<entity>> {
    + <<static>> fetchAll(query: GetDormDto): { dorms: any[], total: number }
}

class "UtilityDB" <<entity>> {
    + <<static>> fetchAll(query: GetUtilityDto): { utilities: any[], total: number }
}


' --- RELATIONSHIPS ---
AdminRooms --> Room
AdminRoomDetail --> Room
AdminRoomDetail --> Bed
AdminRoomDetail --> Dorm
AdminRoomDetail --> Utility
Room --> RoomDB
Bed --> RoomDB
Dorm --> DormDB
Utility --> UtilityDB
AdminRooms ..> AdminRoomDetail

@enduml

