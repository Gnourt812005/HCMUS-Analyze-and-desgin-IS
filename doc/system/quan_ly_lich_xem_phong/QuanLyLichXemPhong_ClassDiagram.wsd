@startuml QuanLyLichXemPhong_ClassDiagram_Exact
title Class Diagram - UC4, 5: Quản lý lịch xem phòng (Strict Source Code)

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 18
    Padding 5
    Nodesep 60
    Ranksep 80
}

' ==========================================
' 1. SHARED LAYER (DTOs)
' ==========================================
package "Data Transfer Objects" <<Rectangle>> {
    class "PreviewBriefDTO" as PreviewBriefDTO <<DTO>> {
        + id: string
        + roomName: string
        + dormName: string
        + dormAddress: string
        + previewDate: string
        + previewTime: string
        + status: string
    }

    class "PreviewDetailDTO" as PreviewDetailDTO <<DTO>> {
        + id: string
        + roomId: string
        + roomName: string
        + dormId: string
        + dormName: string
        + dormAddress: string
        + date: string
        + time: string
        + salesStaff: Object
        + createdAt: string
        + status: string
    }
}

' ==========================================
' 2. BOUNDARY LAYER (FRONTEND VIEWS)
' ==========================================
class "PreviewManagementScreen" as PreviewManagementScreen <<boundary>> {
    - listPreviewSchedules: ListView
    - btnCancelPreview: Button

    + showClientPreviewSchedules(): void
    + listPreviewSchedulesItemClick(formId: string): void
    + btnCancelPreviewClick(formId: string): void
}

class "PreviewScheduleDetailsView" as PreviewScheduleDetailsView <<boundary>> {
    - lblDormName: Label
    - lblRoomName: Label
    - lblAddress: Label
    - lblDate: Label
    - lblTime: Label
    - lblStaffName: Label
    - lblStaffPhone: Label

    - btnClose: IconButton

    + showPreviewScheduleDetails(formId: string): void
}

' ==========================================
' 3. CONTROL LAYER (BUSINESS LOGIC)
' ==========================================
class "PreviewForm" as PreviewForm <<control>> {
    + formId: string
    + roomId: string
    + userId: string
    + previewDatetime: string
    + status: string
    + staffId: string

    + <<static>> getPreviewsByUserId(userId: string): List<PreviewDetailDTO>
    + <<static>> getUserPreviewDetails(formId: string, userId: string): PreviewDetailDTO
    + <<static>> cancelPreviewByUser(formId: string, userId: string): void
    + <<static>> getRoomAndDormInfo(roomId: string): any
}

' ==========================================
' 4. ENTITY LAYER (DATABASE)
' ==========================================
class "PreviewFormDB" as PreviewFormDB <<entity>> {
    + <<static>> getAll(): List<PreviewForm>
    + <<static>> getById(formId: string): PreviewForm
    + <<static>> updateStatus(formId: string, status: string): boolean
}

class "RoomDB" as RoomDB <<entity>> {
    + <<static>> fetchAll(query: any): {rooms: List<any>, total: int}
}

class "DormDB" as DormDB <<entity>> {
    + <<static>> fetchAll(query: any): {dorms: List<any>, total: int}
}

class "UserDB" as UserDB <<entity>> {
    + <<static>> fetchCredentialByEmail(email: string): any
}

' ==========================================
' RELATIONSHIPS
' ==========================================

' Luồng điều hướng UI (Click vào item mở Popup)
PreviewManagementScreen ..> PreviewScheduleDetailsView : "navigates to (Modal) >"

' UI sử dụng DTO để hiển thị
PreviewManagementScreen ..> PreviewBriefDTO : "displays list >"
PreviewScheduleDetailsView ..> PreviewDetailDTO : "displays detail >"

' UI gọi API (Boundary -> Control)
PreviewManagementScreen "1" --> "1" PreviewForm : "fetch list / cancel form"
PreviewScheduleDetailsView "1" --> "1" PreviewForm : "fetch details"

' Business gọi DB (Control -> Entity) (Phản ánh chính xác theo PreviewForm.ts)
PreviewForm "1" --> "1" PreviewFormDB : "CRUD Preview Forms"
PreviewForm "1" --> "1" RoomDB : "get room mapping"
PreviewForm "1" --> "1" DormDB : "get dorm mapping"
PreviewForm "1" --> "1" UserDB : "fetch sales staff info"

@enduml