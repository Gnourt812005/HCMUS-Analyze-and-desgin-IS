@startuml QuanLyLichXemPhong_SequenceDiagram_StrictSrc
title Sequence Diagram - UC4, 5: Quản lý lịch xem phòng (Strict Execution)

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
    BoxPadding 10
}

autonumber

actor "Khách hàng" as Actor
boundary "PreviewManagementScreen" as GUI_List <<boundary>>
boundary "PreviewScheduleDetailsView" as GUI_Details <<boundary>>

control "PreviewForm" as BUS_Preview <<control>>

database "PreviewFormDB" as DAO_Preview <<entity>>
database "DormDB" as DAO_Dorm <<entity>>
database "RoomDB" as DAO_Room <<entity>>
database "UserDB" as DAO_User <<entity>>

== Mở danh sách lịch hẹn xem phòng ==
Actor -> GUI_List: Mở màn hình quản lý lịch hẹn
activate GUI_List
    GUI_List -> BUS_Preview: getPreviewsByUserId(userId)
    activate BUS_Preview
        
        BUS_Preview -> DAO_Preview: getAll()
        activate DAO_Preview
        deactivate DAO_Preview

        loop Cho từng lịch hẹn tìm được
            BUS_Preview -> BUS_Preview: getRoomAndDormInfo(roomId)
            
            BUS_Preview -> DAO_Dorm: fetchAll(query)
            activate DAO_Dorm
            deactivate DAO_Dorm
            
            loop Lặp qua từng KTX (cho đến khi tìm thấy phòng)
                BUS_Preview -> DAO_Room: fetchAll({ dormId })
                activate DAO_Room
                deactivate DAO_Room
            end
        end
    deactivate BUS_Preview
    note right of GUI_List: Hiển thị danh sách bằng PreviewBriefDTO
deactivate GUI_List

== Xem chi tiết lịch hẹn ==
Actor -> GUI_List: Bấm vào 1 lịch hẹn trên danh sách
activate GUI_List
    GUI_List -> GUI_Details: showPreviewScheduleDetails(formId)
    activate GUI_Details
        
        GUI_Details -> BUS_Preview: getUserPreviewDetails(formId, userId)
        activate BUS_Preview
            
            BUS_Preview -> DAO_Preview: getById(formId)
            activate DAO_Preview
            deactivate DAO_Preview

            BUS_Preview -> BUS_Preview: getRoomAndDormInfo(roomId)
            
            BUS_Preview -> DAO_Dorm: fetchAll(query)
            activate DAO_Dorm
            deactivate DAO_Dorm
            
            loop Lặp qua từng KTX (cho đến khi tìm thấy phòng)
                BUS_Preview -> DAO_Room: fetchAll({ dormId })
                activate DAO_Room
                deactivate DAO_Room
            end

            opt Nếu form có mã nhân viên phụ trách (staffId)
                BUS_Preview -> DAO_User: fetchCredentialByEmail(staffId)
                activate DAO_User
                deactivate DAO_User
            end

        deactivate BUS_Preview
        note right of GUI_Details: Hiển thị Modal chi tiết bằng PreviewDetailDTO
    deactivate GUI_Details
deactivate GUI_List

== Hủy lịch hẹn xem phòng ==
Actor -> GUI_List: Bấm "Hủy lịch hẹn" và Xác nhận
activate GUI_List
    GUI_List -> BUS_Preview: cancelPreviewByUser(formId, userId)
    activate BUS_Preview
        
        BUS_Preview -> DAO_Preview: getById(formId)
        activate DAO_Preview
        deactivate DAO_Preview

        BUS_Preview -> BUS_Preview: Kiểm tra trạng thái form (phải là "pending")

        BUS_Preview -> DAO_Preview: updateStatus(formId, "cancelled")
        activate DAO_Preview
        deactivate DAO_Preview

    deactivate BUS_Preview
deactivate GUI_List

@enduml