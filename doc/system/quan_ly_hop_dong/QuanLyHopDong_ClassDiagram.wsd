@startuml QuanLyHopDong_ClassDiagram
title Class Diagram - UC20: Quản lý hợp đồng

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenContractManagement" as ScreenCM <<boundary>> {
    - dgvContract: GridView
    - txtSearch: TextBox
    - btnSearch: Button
    - btnAddNew: Button
    + dgvContract_Load(): void
    + btnSearch_Click(): void
    + btnAddNew_Click(): void
}

class "ScreenContractDetail" as ScreenCD <<boundary>> {
    - lblCustomerName: Label
    - lblBedId: Label
    - lblStatus: Label
    - btnUpdate: Button
    - btnCancelContract: Button
    + ScreenContractDetail_Load(): void
    + btnUpdate_Click(): void
    + btnCancelContract_Click(): void
}

class "FormContract" as FormContract <<boundary>> {
    - txtStartDate: TextBox
    - txtEndDate: TextBox
    - txtNumberOfCustomer: TextBox
    - panelBedSelection: Panel
    - btnSave: Button
    - btnCancel: Button
    + txtNumberOfCustomer_Changed(): void
    + cbRoom_SelectedIndexChanged(): void
    + btnSave_Click(): void
}

' --- BUSINESS LAYER ---
class "Contract" as Contract <<control>> {
    - id: string
    - customer_id: string
    - bed_id: string
    - branch_manager_id: string
    - start_date: date
    - end_date: date
    - status: string
    - number_of_customer: int
    - file_id: string
    - selected_beds: List<string>
    + <<static>> getContracts(keyword: string): List<Contract>
    + <<static>> getContractDetail(id: string): Contract
    + <<static>> getRooms(): List<Room>
    + <<static>> getAvailableBedsByRoom(roomId: string): List<Bed>
    + <<static>> createContract(data: Contract, bedList: List<string>): boolean
    + <<static>> updateContract(id: string, data: Contract): boolean
    + <<static>> cancelContract(id: string): boolean
}

' --- DATABASE LAYER ---
class "ContractDB" as ContractDB <<entity>> {
    + <<static>> fetchAll(): List
    + <<static>> fetchByKeyword(keyword: string): List
    + <<static>> fetchById(id: string): Contract
    + <<static>> fetchRooms(): List
    + <<static>> fetchAvailableBeds(roomId: string): List
    + <<static>> insertContract(data: Contract): string
    + <<static>> insertContractDetails(contractId: string, bedId: string): boolean
    + <<static>> update(id: string, data: Contract): boolean
    + <<static>> updateStatus(id: string, status: string): boolean
}

' --- RELATIONSHIPS ---
ScreenCM "1" --> "1" Contract
ScreenCD "1" --> "1" Contract
FormContract "1" --> "1" Contract
Contract "1" --> "1" ContractDB
ScreenCM ..> ScreenCD : Mở Chi tiết
ScreenCM ..> FormContract : Mở Form Thêm
ScreenCD ..> FormContract : Mở Form Sửa

@enduml