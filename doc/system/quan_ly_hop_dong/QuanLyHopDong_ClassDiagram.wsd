@startuml QuanLyHopDong_ClassDiagram
title Class Diagram - UC20: Quản lý hợp đồng

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 18
    Padding 5
    Nodesep 60
    Ranksep 80
}

' ==========================================
' 1. SHARED LAYER (DTOs)
' ==========================================
package "Data Transfer Objects" <<Rectangle>> {
    class "ContractDTO" as ContractDTO <<DTO>> {
        + contractId: string
        + contractCode: string
        + userEmail: string
        + rentalFormId: string
        + roomId: string
        + roomName: string
        + dormName: string
        + floor: number
        + bedNumbers: string
        + monthlyRent: number
        + startDate: string
        + depositAmount: number
        + stayDuration: number
        + status: string
        + signatureUrl: string
        + createdAt: string
    }

    class "ContractAdminDTO" as ContractAdminDTO <<DTO>> {
        + id: string
        + contractCode: string
        + userEmail: string
        + rentalFormId: string
        + startDate: string
        + stayDuration: number
        + status: string
        + signatureUrl: string
        + createdAt: string
        + customerName: string
        + phone: string
        + cccd: string
        + roomName: string
        + bedNumbers: string[]
        + monthlyRent: number
    }

    class "DormFeesDTO" as DormFeesDTO <<DTO>> {
        + electricityFee: number
        + waterFee: number
        + wifiFee: number
        + cleaningFee: number
    }

    class "RentalFormOptionDTO" as RentalFormOptionDTO <<DTO>> {
        + id: string
        + customerName: string
        + phone: string
        + cccd: string
        + roomName: string
        + bedNumbers: string[]
        + monthlyRent: number
        + rentalMonths: number
        + totalAmount: number
        + createdAt: string
    }
}

' ==========================================
' 2. BOUNDARY LAYER (FRONTEND VIEWS)
' ==========================================
class "UserContractPage" as UserContractPage <<boundary>> {
    - contractList: ContractDTO[]
    - selectedContract: ContractDTO
    - feesInfo: DormFeesDTO
    - activeTab: string

    + loadContracts(): void
    + selectContract(contractId: string): void
    + loadFees(contractId: string): void
}

class "AdminContracts" as AdminContracts <<boundary>> {
    - contractList: ContractAdminDTO[]
    - searchKeyword: string
    - statusFilter: string

    + loadAll(): void
    + handleSearch(): void
    + openCreateModal(): void
    + openDetailModal(contractId: string): void
}

class "CreateContractModal" as CreateContractModal <<boundary>> {
    - rentalFormOptions: RentalFormOptionDTO[]
    - rentalFormId: string
    - startDate: string
    - stayDuration: number

    + loadRentalForms(): void
    + handleSubmit(): void
}

class "ContractDetailModal" as ContractDetailModal <<boundary>> {
    - contract: ContractAdminDTO
    - feesInfo: DormFeesDTO
    - editMode: boolean

    + handleUpdate(): void
    + handleCancel(): void
}

' ==========================================
' 3. CONTROL LAYER (BUSINESS LOGIC)
' ==========================================
class "Contract" as Contract <<control>> {
    - id: string
    - contractCode: string
    - userEmail: string
    - rentalFormId: string
    - startDate: string
    - stayDuration: number
    - status: string
    - signatureUrl: string
    - feesSnapshot: DormFeesDTO
    - createdAt: string

    + <<static>> getByUserEmail(email: string): ContractDTO
    + <<static>> getByContractId(id: string): ContractDTO
    + <<static>> getByRentalFormId(rentalFormId: string): ContractDTO
    + <<static>> getActiveByUserEmail(email: string): ContractDTO[]
    + <<static>> getAllByUserEmail(email: string): ContractDTO[]
    + <<static>> getAll(dormId: string): ContractAdminDTO[]
    + <<static>> getRentalFormsWithoutContract(dormId: string): RentalFormOptionDTO[]
    + <<static>> getBedsInfoByContractId(id: string): object
    + <<static>> getFeesByContractId(id: string): DormFeesDTO
    + <<static>> insert(rentalFormId: string, startDate: string, stayDuration: number): string
    + <<static>> adminUpdate(id: string, startDate: string, stayDuration: number): boolean
    + <<static>> cancel(id: string): boolean
    + <<static>> updateStatus(id: string, status: string): boolean
}

' ==========================================
' 4. ENTITY LAYER (DATABASE)
' ==========================================
class "ContractDB" as ContractDB <<entity>> {
    + <<static>> getAll(dormId: string): ContractAdminDTO[]
    + <<static>> getRentalFormsWithoutContract(dormId: string): RentalFormOptionDTO[]
    + <<static>> insert(rentalFormId: string, startDate: string, stayDuration: number): string
    + <<static>> adminUpdate(id: string, startDate: string, stayDuration: number): boolean
    + <<static>> cancel(id: string): boolean
    + <<static>> getByContractId(id: string): ContractDTO
    + <<static>> getByRentalFormId(rentalFormId: string): ContractDTO
    + <<static>> getByUserEmail(email: string): ContractDTO
    + <<static>> getAllByUserEmail(email: string): ContractDTO[]
    + <<static>> getActiveByUserEmail(email: string): ContractDTO[]
    + <<static>> getBedsInfoByContractId(id: string): object
    + <<static>> getFeesByContractId(id: string): DormFeesDTO
    + <<static>> updateStatus(id: string, status: string): boolean
}

' ==========================================
' RELATIONSHIPS
' ==========================================

' Luồng điều hướng UI
AdminContracts ..> CreateContractModal : "Mở Form Thêm >"
AdminContracts ..> ContractDetailModal : "Mở Form Chi tiết >"

' UI sử dụng DTO để hiển thị
UserContractPage ..> ContractDTO : "hiển thị danh sách hợp đồng >"
UserContractPage ..> DormFeesDTO : "hiển thị phí dịch vụ >"
AdminContracts ..> ContractAdminDTO : "hiển thị danh sách (admin) >"
CreateContractModal ..> RentalFormOptionDTO : "hiển thị phiếu đăng ký >"
ContractDetailModal ..> ContractAdminDTO : "hiển thị chi tiết hợp đồng >"
ContractDetailModal ..> DormFeesDTO : "hiển thị phí dịch vụ >"

' UI gọi Business (Boundary -> Control)
UserContractPage "1" --> "1" Contract : "xem hợp đồng / lấy phí"
AdminContracts "1" --> "1" Contract : "lấy danh sách / tạo / cập nhật / huỷ"
CreateContractModal "1" --> "1" Contract : "lấy phiếu ĐK / tạo hợp đồng"
ContractDetailModal "1" --> "1" Contract : "cập nhật / huỷ hợp đồng"

' Business gọi DB (Control -> Entity)
Contract "1" --> "1" ContractDB : "CRUD contracts"

' Business trả về DTO (Control -> DTO)
Contract ..> ContractDTO : "returns >"
Contract ..> ContractAdminDTO : "returns >"
Contract ..> DormFeesDTO : "returns >"
Contract ..> RentalFormOptionDTO : "returns >"

@enduml
