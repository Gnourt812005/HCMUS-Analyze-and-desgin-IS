@startuml QuanLyHopDong_SequenceDiagram
title Sequence Diagram - UC20: Quản lý hợp đồng

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
    BoxPadding 10
}

autonumber

actor "Nhân viên phụ trách" as Admin
actor "Khách hàng" as User

boundary "ContractManagementScreen" as GUI_Admin <<boundary>>
boundary "ContractFormScreen" as GUI_Create <<boundary>>
boundary "ContractDetailScreen" as GUI_Detail <<boundary>>
boundary "UserContractScreen" as GUI_User <<boundary>>

control "Contract" as BUS <<control>>

database "ContractDB" as DAO <<entity>>

' ============================================================
== Kịch bản 1: Admin xem danh sách hợp đồng ==
' ============================================================

Admin -> GUI_Admin: Mở trang Quản lý hợp đồng
activate GUI_Admin
    GUI_Admin -> BUS: getAll(dormId)
    activate BUS
        BUS -> DAO: getAll(dormId)
        activate DAO
        deactivate DAO
    deactivate BUS
    note right of GUI_Admin: Hiển thị danh sách bằng ContractAdminDTO\n(Mã HD, Khách hàng, Phòng, Giường, Trạng thái)
deactivate GUI_Admin

' ============================================================
== Kịch bản 2: Admin lập hợp đồng mới ==
' ============================================================

Admin -> GUI_Admin: Nhấn "Lập hợp đồng mới"
activate GUI_Admin
    GUI_Admin -> GUI_Create: openCreateModal()
    activate GUI_Create

        GUI_Create -> BUS: getRentalFormsWithoutContract(dormId)
        activate BUS
            BUS -> DAO: getRentalFormsWithoutContract(dormId)
            activate DAO
            deactivate DAO
        deactivate BUS
        note right of GUI_Create: Hiển thị danh sách phiếu ĐK bằng RentalFormOptionDTO\n

    deactivate GUI_Create
deactivate GUI_Admin

Admin -> GUI_Create: Chọn phiếu ĐK, nhập ngày bắt đầu & thời hạn (tháng) rồi nhấn "Lưu"
activate GUI_Create
    GUI_Create -> GUI_Create: Kiểm tra tính hợp lệ\n(startDate >= ngày hiện tại, stayDuration >= 1)

    alt Hợp lệ
        GUI_Create -> BUS: insert(rentalFormId, startDate, stayDuration)
        activate BUS
            BUS -> DAO: insert(rentalFormId, startDate, stayDuration)
            activate DAO
        
            deactivate DAO
        deactivate BUS
        GUI_Create --> Admin: Thông báo "Lập hợp đồng thành công"
        GUI_Create -> GUI_Admin: Tải lại danh sách
    end
deactivate GUI_Create

' ============================================================
== Kịch bản 3: Admin cập nhật hợp đồng ==
' ============================================================

Admin -> GUI_Admin: Chọn một hợp đồng trong danh sách
activate GUI_Admin
    GUI_Admin -> GUI_Detail: openDetailModal(contractId)
    activate GUI_Detail
        note right of GUI_Detail: Hiển thị chi tiết bằng ContractAdminDTO\n& phí dịch vụ bằng DormFeesDTO

        GUI_Detail -> BUS: getFeesByContractId(contractId)
        activate BUS
            BUS -> DAO: getFeesByContractId(contractId)
            activate DAO
            deactivate DAO
        deactivate BUS

    deactivate GUI_Detail
deactivate GUI_Admin

Admin -> GUI_Detail: Chỉnh ngày bắt đầu / thời hạn & nhấn "Lưu thay đổi"
activate GUI_Detail
    GUI_Detail -> GUI_Detail: Kiểm tra tính hợp lệ (startDate >= ngày hiện tại)

    alt Hợp lệ
        GUI_Detail -> BUS: adminUpdate(contractId, startDate, stayDuration)
        activate BUS
            BUS -> DAO: adminUpdate(contractId, startDate, stayDuration)
            activate DAO
            deactivate DAO
        deactivate BUS
        GUI_Detail --> Admin: Thông báo "Cập nhật thành công"
        GUI_Detail -> GUI_Admin: Tải lại danh sách
    end
deactivate GUI_Detail

' ============================================================
== Kịch bản 4: Admin huỷ hợp đồng ==
' ============================================================

Admin -> GUI_Detail: Nhấn nút "Huỷ hợp đồng"
activate GUI_Detail
    GUI_Detail -> GUI_Detail: Hiển thị hộp thoại xác nhận

    Admin -> GUI_Detail: Xác nhận huỷ
    GUI_Detail -> BUS: cancel(contractId)
    activate BUS
        BUS -> DAO: cancel(contractId)
        activate DAO
            note right of DAO: UPDATE contracts\nSET status = 'TERMINATED'
        deactivate DAO
    deactivate BUS
    GUI_Detail --> Admin: Thông báo "Đã huỷ hợp đồng"
    GUI_Detail -> GUI_Admin: Tải lại danh sách
deactivate GUI_Detail

' ============================================================
== Kịch bản 5: Khách hàng xem hợp đồng của mình ==
' ============================================================

User -> GUI_User: Mở trang Hợp đồng của tôi
activate GUI_User
    GUI_User -> BUS: getAllByUserEmail(email)
    activate BUS
        BUS -> DAO: getAllByUserEmail(email)
        activate DAO
        deactivate DAO
    deactivate BUS
    note right of GUI_User: Hiển thị danh sách tất cả hợp đồng bằng ContractDTO\n
deactivate GUI_User

User -> GUI_User: Chọn một hợp đồng & chuyển tab "Phí dịch vụ"
activate GUI_User
    GUI_User -> BUS: getFeesByContractId(contractId)
    activate BUS
        BUS -> DAO: getFeesByContractId(contractId)
        activate DAO
        deactivate DAO
    deactivate BUS
    note right of GUI_User: Hiển thị phí dịch vụ bằng DormFeesDTO\n(điện, nước, wifi, vệ sinh)
deactivate GUI_User

@enduml
