@startuml DangKyTaiKhoan_ClassDiagram
title Class Diagram - UC11: Đăng ký tài khoản

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenRegister" as ScreenRegister <<boundary>> {
    - txtEmail: TextBox
    - txtPassword: TextBox
    - txtConfirmPassword: TextBox
    - btnRegister: Button
    + btnRegisterClick(): void
}

' --- BUSINESS LAYER ---
class "User" <<control>> {
    - username: string
    - password: string
    + <<static>> register(data: User): boolean
}

class "UserDB" <<entity>> {
    + <<static>> insert(data: User): boolean
}

' --- RELATIONSHIPS ---
ScreenRegister "1" --> "1" User
User "1" --> "1" UserDB

@enduml
