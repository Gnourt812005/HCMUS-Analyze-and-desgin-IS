@startuml DangKyTaiKhoan_ClassDiagram
title Class Diagram - UC11: Đăng ký tài khoản

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "Register" as Register <<boundary>> {
    - showPassword: boolean
    - setShowPassword: void
    + txtEmail: Input
    + txtPassword: Input
    + txtConfirmPassword: Input
    + btnTogglePassword: Button
    + btnRegister: Button
    + handleRegister(): void
}

' --- DTO LAYER ---
interface "SignUpDTO" as SignUpDTO <<dto>> {
    + email: string
    + password: string
}

' --- BUSINESS LAYER ---
class "User" as User <<control>> {
    - email: string
    - fullName: string
    - password: string
    - cccd: string
    - birthday: string
    - gender: string
    - phone: string
    - address: string
    - role: UserRole
    + <<static>> signUp(data: SignUpDTO): boolean
}

' --- DATABASE LAYER ---
class "UserDB" as UserDB <<entity>> {
    + <<static>> checkEmailExists(email: string): boolean
    + <<static>> insert(data: User): boolean
}

' --- RELATIONSHIPS ---
Register ..> SignUpDTO
Register "1" --> "1" User
User "1" --> "1" UserDB

@enduml

