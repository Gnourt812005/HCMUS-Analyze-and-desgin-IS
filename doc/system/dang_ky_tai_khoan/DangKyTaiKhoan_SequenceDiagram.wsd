@startuml DangKyTaiKhoan_SequenceDiagram
title Sequence Diagram - UC11: Đăng ký tài khoản

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    ParticipantPadding 20
    BoxPadding 10
}

actor "Khách hàng" as Actor
boundary "Register" as GUI <<boundary>>
participant "SignUpDTO" as DTO <<dto>>
control "User" as BUS <<control>>
database "UserDB" as DB <<database>>

autonumber

Actor -> GUI: Nhập thông tin & Click "Đăng ký"
GUI -> GUI: handleRegister()
GUI -> DTO **: new SignUpDTO(email, password)
GUI -> BUS: signUp(signUpDTO)
BUS -> DB: checkEmailExists(signUpDTO.email)
alt Email đã tồn tại
    DB --> BUS: true
    BUS --> GUI: Error("Email đã tồn tại")
    GUI --> Actor: Hiển thị lỗi
else Email chưa tồn tại
    DB --> BUS: false
    BUS -> BUS: userModel = new User(signUpDTO, defaultValues)
    BUS -> DB: insert(userModel)
    DB --> BUS: true
    BUS --> GUI: true
    GUI --> Actor: Thông báo đăng ký thành công
end
deactivate GUI

@enduml

