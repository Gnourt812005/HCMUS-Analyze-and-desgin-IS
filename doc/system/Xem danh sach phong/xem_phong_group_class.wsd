@startuml XemDanhSach&ChiTietPhong_ClassDiagram
title Class Diagram: Xem danh sách phòng và Chi tiết phòng

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenDormsView" as ScreenDormsView <<boundary>> {
    ' - txtEmail: TextBox
    ' - txtPassword: TextBox
    ' - btnLogin: Button
    ' + btnLogin_Click(): void

    - gridDorms: GridView

    + showDormsList(): void
    + gridDorms_CellClick(): int ' returns selected dorm ID
}

class "ScreenRoomsView" as ScreenRoomsView <<boundary>> {
    - gridRooms: GridView
    - cbbBlockSelect: ComboBox
    - sliderPriceRange: RangeSlider
    - numRommateCount: NumericUpDown
    - checkboxHasAC: CheckBox
    - checkboxHasPrivateBathroom: CheckBox
    - btnSearchRoom: Button
    - btnBack: IconButton
    - btnNextPage: IconButton
    - btnPreviousPage: IconButton

    + showRoomsList(): void
    + btnBack_Click(): void
    + btnNextPage_Click(): void
    + btnPreviousPage_Click(): void
    + btnSearchRoom_Click(): void
    + gridRooms_CellClick(): int ' returns selected room ID
}
note right of ScreenRoomsView
    May include more filters options in the future.
end note

class "ScreenRoomDetailsView" as ScreenRoomDetailsView <<boundary>> {
    - imageRoom: PictureBox
    - lblRoomID: Label
    - lblDormName: Label
    - lblBlock: Label
    - lbleachBedPrice: Label
    - lblRoommateCount: Label
    - lblAvailSlots: Label
    - lblFavoriteCount: Label
    - txtblockUltilities: TextBlock
    - txtblockSpecialDescription: TextBlock

    - btnPreviewRequest: Button
    - btnFavorite: IconButton

    - btnBack: IconButton

    + showRoomDetails(roomID: int): void
    + btnBack_Click(): void

    + btnPreviewRequest_Click(): void
    + btnFavorite_Click(): void
}

class "ScreenPreviewRequestView" as ScreenPreviewRequestView <<boundary>> {
    - datepickerPreviewDate: DateTimePicker
    - btnConfirmPreviewDate: Button

    - btnBack: IconButton

    + showPreviewRequestScreen(): void
    + btnBack_Click(): void
    + btnConfirmPreviewDate_Click(): void
}

' --- BUSINESS LAYER ---
class "Dorm" as Dorm <<control>> {
    - dormImage: byte[]
    - dormID: int
    - dormName: string
    - address: string
    - specialDescription: string
    - dormStatus: string

    + getDormsList(): List<Dorm>
}

class "RoomSearchCriteria" as RoomSearchCriteria <<control>> {
    - block: string
    - priceRange: Tuple<decimal, decimal>
    - roommateCount: int
    - hasAC: bool
    - hasPrivateBathroom: bool
}

class "Room" as Room <<control>> {
    - roomImage: byte[]
    - roomID: int
    - dormID: int
    - roomNumber: string
    - eachBedPrice: decimal
    - roommateCount: int
    - availSlots: int
    - roomUtilities: string
    - specialDescription: string

    + getRoomsList(dormID: int, criteria: RoomSearchCriteria): List<Room>
}

class "FavoriteRequest" as FavoriteRequest <<control>> {
    - roomID: int
    - userID: int

    + addFavoriteRoom(roomID: int, userID: int): void
    + removeFavoriteRoom(roomID: int, userID: int): void
}

class "PreviewRequest" as PreviewRequest <<control>> {
    - roomID: int
    - userID: int
    - previewDate: DateTime
    - employeeID: int

    + addPreviewForm(roomID: int, userID: int, previewDate: DateTime): bool
    + assignSalesEmployee(previewDate: DateTime): bool
}

' --- DATABASE LAYER ---
class "DormDB" as DormDB <<entity>> {
    + <<static>>getDormsList(): List<Dorm>
}

class "RoomDB" as RoomDB <<entity>> {
    + <<static>>getRoomsList(dormID: int, criteria: RoomSearchCriteria): List<Room>
}

class "UtilitiesDB" as UtilitiesDB <<entity>> {
    + <<static>>getUtilitiesByRoomID(roomID: int): string
}

class "BedDB" as BedDB <<entity>> {
    + <<static>>getBedPrice(roomID: int): decimal
}

class "FavoriteRoomDB" as FavoriteDB <<entity>> {
    + <<static>>addFavoriteRoom(roomID: int, userID: int): void
    + <<static>>removeFavoriteRoom(roomID: int, userID: int): void
}

class "PreviewFormDB" as PreviewDB <<entity>> {
    + <<static>>addPreviewForm(roomID: int, userID: int, previewDate: DateTime, employeeID: int): bool

    + <<static>>checkUsersDuplicatedPreviewDate(userID: int, previewDate: DateTime): bool
    + <<static>>checkRoomsDuplicatedPreviewDate(roomID: int, previewDate: DateTime): bool
}

class "SalesEmployeeDB" as SalesEmployeeDB <<entity>> {
    + <<static>>getAvailableSalesEmployee(previewDate: DateTime): int ' returns employee ID
}

' --- RELATIONSHIPS ---
ScreenDormsView "1" --> "many" Dorm
ScreenRoomsView "1" --> "many" Room
ScreenRoomDetailsView "1" --> "1" Room

Dorm "1" --> "1" DormDB
Room "1" --> "1" RoomDB

Dorm "1" *-- "many" Room : contains
RoomSearchCriteria  <.. Room
RoomSearchCriteria ..>  ScreenRoomsView

RoomDB "1" *-- "many" UtilitiesDB : contains
RoomDB "1" *-- "many" BedDB : contains

@enduml
