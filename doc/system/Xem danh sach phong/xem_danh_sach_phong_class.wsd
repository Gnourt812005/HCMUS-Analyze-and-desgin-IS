@startuml XemDanhSachPhong_ClassDiagram
title Class Diagram: Xem danh sách phòng

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenDormsView" as ScreenDormsView <<boundary>> {
    ' - txtEmail: TextBox
    ' - txtPassword: TextBox
    ' - btnLogin: Button
    ' + btnLogin_Click(): void
}

' --- BUSINESS LAYER ---
class "Dorm" as Dorm <<control>> {
    ' - email: string
    ' - password: string
    ' + login(email: string, password: string): boolean
}

' --- DATABASE LAYER ---
class "DormDB" as DormDB <<entity>> {
    ' + checkCredentials(email: string, password: string): boolean
}

' --- RELATIONSHIPS ---
' ScreenLogin "1" --> "1" User
' User "1" --> "1" UserDB

@enduml
