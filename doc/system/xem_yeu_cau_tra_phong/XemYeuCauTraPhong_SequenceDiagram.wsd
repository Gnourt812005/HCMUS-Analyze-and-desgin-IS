@startuml XemYeuCauTraPhong_SequenceDiagram
title Sequence Diagram - UC23: Xem yêu cầu trả phòng

skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
}

autonumber

actor "Khách hàng" as customer
boundary "ScreenCheckoutRequestList" as listScreen
boundary "ScreenCheckoutRequestDetail" as detailScreen
control "CheckoutRequest" as checkoutCtrl
control "Contract" as contractCtrl
control "RefundCalculation" as refundCtrl
database "CheckoutRequestDB" as checkoutDb
database "ContractDB" as contractDb
database "RefundCalculationDB" as refundDb

customer -> listScreen: show()
activate listScreen
listScreen -> checkoutCtrl: getListByUserEmail(userEmail)
activate checkoutCtrl
checkoutCtrl -> checkoutDb: getByUserEmail(userEmail)
activate checkoutDb
checkoutDb --> checkoutCtrl: CheckoutRequest[]
deactivate checkoutDb
checkoutCtrl --> listScreen: CheckoutRequest[]
deactivate checkoutCtrl

listScreen --> customer: Hiển thị danh sách
deactivate listScreen

customer -> listScreen: Chọn yêu cầu
activate listScreen
listScreen -> detailScreen: show(requestId)
activate detailScreen
deactivate listScreen
detailScreen -> checkoutCtrl: getById(requestId)
activate checkoutCtrl
checkoutCtrl -> checkoutDb: getById(requestId)
activate checkoutDb
checkoutDb --> checkoutCtrl: CheckoutRequest
deactivate checkoutDb
checkoutCtrl --> detailScreen: CheckoutRequest
deactivate checkoutCtrl

detailScreen -> contractCtrl: getByContractId(contractId)
activate contractCtrl
contractCtrl -> contractDb: getByContractId(contractId)
activate contractDb
contractDb --> contractCtrl: Contract
deactivate contractDb
contractCtrl --> detailScreen: Contract
deactivate contractCtrl

alt Đã tính hoàn cọc và khấu trừ
    detailScreen -> refundCtrl: getByRequestId(requestId)
    activate refundCtrl
    refundCtrl -> refundDb: getByRequestId(requestId)
    activate refundDb
    refundDb --> refundCtrl: RefundCalculation 
    deactivate refundDb
    refundCtrl --> detailScreen: RefundCalculation 
    deactivate refundCtrl
end

detailScreen --> customer: Hiển thị chi tiết
deactivate detailScreen
deactivate listScreen

@enduml
