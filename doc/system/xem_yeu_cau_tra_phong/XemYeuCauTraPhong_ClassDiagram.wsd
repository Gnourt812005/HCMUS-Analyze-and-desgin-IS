@startuml XemYeuCauTraPhong_ClassDiagram
title Class Diagram - UC23: Xem yêu cầu trả phòng

skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    BorderColor #2D3E50
    ClassBackgroundColor #F5F7F9
    ClassBorderThickness 2
    StereotypeFontColor #2D3E50
    Padding 5
}

class ScreenCheckoutRequestList <<boundary>> {
    - dgvRequests: DataGridView
    - btnViewDetail: Button
    + show(): void
    + loadRequests(): void
    + btnViewDetail_Click(): void
}

class ModalCheckoutRequestDetail <<boundary>> {
    - lblContractInfo: Label
    - lblRefundInfo: Label
    - btnProcess: Button
    - btnReject: Button
    - btnBack: Button
    + show(requestId: string): void
    + loadDetail(): void
}

class CheckoutRequest <<control>> {
    - requestId: string
    - userEmail: string
    - userFullName: string
    - rentalFormId: string
    - dormName: string
    - roomName: string
    - floor: number
    - bedNumbers: string
    - expectedDate: string
    - status: CheckoutStatus
    - createdAt: string
    + <<static>> getListByUserEmail(userEmail: string): CheckoutRequest[]
    + <<static>> getById(requestId: string): CheckoutRequest
}

class RefundCalculation <<control>> {
    - calculationId: string
    - requestId: string
    - rentalFormId: string
    - depositAmount: number
    - damageFee: number
    - extraFee: number
    - finalRefundAmount: number
    - notes: string
    - createdAt: string
    + <<static>> getByRequestId(requestId: string): RefundCalculation
}

class Rental <<control>> {
    - rentalFormId: string
    - userEmail: string
    - roomName: string
    - dormName: string
    - floor: number
    - bedNumbers: string
    - type: string
    - totalAmount: number
    - createdAt: string
    + <<static>> getRentalFormById(rentalFormId: string): Rental
}

' --- DATABASE LAYER ---
class CheckoutRequestDB <<entity>> {
    + <<static>> getByUserEmail(userEmail: string): CheckoutRequest[]
    + <<static>> getById(requestId: string): CheckoutRequest
}

class RefundCalculationDB <<entity>> {
    + <<static>> getByRequestId(requestId: string): RefundCalculation
}

class RentalDB <<entity>> {
    + <<static>> getRentalFormById(rentalFormId: string): Rental
}

ScreenCheckoutRequestList --> CheckoutRequest 
ModalCheckoutRequestDetail --> CheckoutRequest 
ModalCheckoutRequestDetail --> Rental 
ModalCheckoutRequestDetail --> RefundCalculation 

CheckoutRequest --> CheckoutRequestDB 
RefundCalculation --> RefundCalculationDB 
Rental --> RentalDB 

@enduml
