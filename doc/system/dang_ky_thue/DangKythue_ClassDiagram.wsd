@startuml DangKyThue_ClassDiagram

skinparam classAttributeIconSize 0
skinparam style strictuml
title Class Diagram - UC28: Đăng ký thuê

' --- BOUNDARY LAYER ---
class "ScreenRoomList" as ScreenRoomList <<boundary>> {
    + showRooms()
    + handleRegisterRental()
    + showPreviewModal()
}

' --- BUSINESS LAYER ---
class "Rental" as Rental <<control>> {
    - registrationId: String
    - roomId: String
    - bedIds: String[]
    - customerName: String
    - idCard: String
    - phone: String
    - email: String
    - roomPrice: Double
    - alreadyDeposited: Boolean
    - action: String
    + <<static>> register(payload)
    + <<static>> checkEligibility(payload)
    + <<static>> previewPayment(payload)
}

class "Policy" as Policy <<control>> {
    - policyId: String
    - title: String
    - content: String
    - updatedAt: Date
    + <<static>> hasConfirmed(idCard)
}

class "RentalDB" as RentalDB <<entity>> {
    + <<static>> createRegistration(record, action)
    + <<static>> getRegistration(registrationId)
    + <<static>> hasDeposit(roomId, idCard)
    + <<static>> getBedsTotalPrice(roomId, bedIds)
}

class "RoomDB" as RoomDB <<entity>> {
    + <<static>> syncRoomAvailability(roomId)
}

"ScreenRoomList" ..> "Rental"
"Rental" ..> "RentalDB"
"Rental" ..> "Policy"
"Rental" ..> "RoomDB"

@enduml
