@startuml DangKythue_ClassDiagram

skinparam classAttributeIconSize 0
skinparam style strictuml
title Class Diagram - UC28: Đăng ký thuê

' --- BOUNDARY LAYER ---
class "ScreenRent" as ScreenDeposit <<boundary>> {
    + showRooms()
    + inputCustomerInfo()
    + lockQuantityUI()
    + showTotalAmount(amount)
}

' --- BUSINESS LAYER ---
class "Customer" as Customer <<control>> {
    - idCard: String
    - fullName: String
    - birthday: Date
    - phone: String
}

class "Room" as Room <<control>> {
    - roomId: String
    - roomType: String
}

class "Bed" as Bed <<control>> {
    - bedId: String
    - status: String
    - price: Double
}

class "Rent" as Rent <<control>> {
    - roomId: String
    - isAlreadyDeposited: Boolean
    - amount: Double
    + <<static>> validateInfo(data)
    + <<static>> calculateAmount(isAlreadyDeposited)
    + <<static>> createTempInvoice()
    + <<static>> checkDepositHistory(roomId, idCard)
}

class "RoomDB" as RoomDB <<entity>> {
    + <<static>> updateStatus()
}

class "BedDB" as BedDB <<entity>> {
    + <<static>> getPrice()
    + <<static>> checkAvailable()
}

"ScreenDeposit" ..> "Rent"
"Rent" ..> "Customer"
"Rent" ..> "Room"
"Rent" ..> "Bed"
"Customer" ..> "CustomerDB"
"Room" ..> "RoomDB"
"Bed" ..> "BedDB"

@enduml