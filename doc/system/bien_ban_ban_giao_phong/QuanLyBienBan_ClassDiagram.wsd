@startuml QuanLyBienBan_ClassDiagram
title Class Diagram - UC21: Lập biên bản bàn giao phòng

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenContractDetail" as ScreenCD <<boundary>> {
    - btnHandoverReport: Button
    + btnHandoverReportClick(): void
}

class "ScreenReportList" as ScreenRL <<boundary>> {
    - dgvReports: GridView
    - btnAddNew: Button
    + loadReports(contractId: string): void
    + btnAddNewClick(): void
}

class "FormReport" as FormReport <<boundary>> {
    - chkBed: CheckBox
    - chkMattress: CheckBox
    - chkCabinet: CheckBox
    - chkKey: CheckBox
    - txtNote: TextBox
    - btnSaveAndSign: Button
    - btnCancel: Button
    + btnSaveAndSignClick(): void
}

' --- BUSINESS LAYER ---
class "Report" as Report <<control>> {
    - id: string
    - contractId: string
    - bedStatus: string
    - mattressStatus: string
    - cabinetStatus: string
    - keyStatus: string
    - note: string
    - createdDate: date
    - createdBy: string
    + <<static>> getReportsByContract(contractId: string): List<Report>
    + <<static>> createHandoverReport(data: Report, bedId: string): boolean
}

' --- DATABASE LAYER ---
class "ReportDB" as ReportDB <<entity>> {
    + <<static>> fetchByContractId(contractId: string): List<Report>
    + <<static>> insert(data: Report): boolean
    + <<static>> updateBedStatus(bedId: string, status: string): boolean
}

' --- RELATIONSHIPS ---
ScreenCD ..> ScreenRL : Open Report List
ScreenRL "1" --> "1" Report
FormReport "1" --> "1" Report
Report "1" --> "1" ReportDB
ScreenRL ..> FormReport : Open New Form

@enduml