@startuml QuanLyBienBan_SequenceDiagram
title Sequence Diagram - UC21: Lập biên bản bàn giao phòng

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
    BoxPadding 10
}

autonumber

actor "Nhân viên phụ trách" as Admin

boundary "HandoverManagementScreen" as GUI_List <<boundary>>
boundary "HandoverFormScreen" as GUI_Form <<boundary>>

control "Handover" as BUS <<control>>

database "HandoverDB" as DAO <<entity>>

' ============================================================
== Kịch bản 1: Admin xem danh sách biên bản bàn giao ==
' ============================================================

Admin -> GUI_List: Mở trang Quản lý biên bản bàn giao
activate GUI_List
    GUI_List -> BUS: getAll()
    activate BUS
        BUS -> DAO: getAll()
        activate DAO
        deactivate DAO
    deactivate BUS
    note right of GUI_List: Hiển thị danh sách bằng HandoverReportDTO\n(Mã biên bản, Hợp đồng, Khách hàng, Loại IN/OUT, Ngày lập)
deactivate GUI_List

' ============================================================
== Kịch bản 2: Admin lập biên bản bàn giao mới ==
' ============================================================

Admin -> GUI_List: Nhấn "Lập biên bản mới"
activate GUI_List
    GUI_List -> GUI_Form: openCreateModal()
    activate GUI_Form

        GUI_Form -> BUS: getActiveContracts()
        activate BUS
            BUS -> DAO: getActiveContracts()
            activate DAO
                note right of DAO: Lấy hợp đồng ACTIVE kèm\ndanh sách giường & thiết bị (bed_utilities)
            deactivate DAO
        deactivate BUS
    deactivate GUI_Form
deactivate GUI_List

Admin -> GUI_Form: Chọn hợp đồng
activate GUI_Form
    GUI_Form -> GUI_Form: handleSelectContract(contractId)\nTự động điền danh sách giường & thiết bị
deactivate GUI_Form

Admin -> GUI_Form: Chọn loại biên bản (IN / OUT),\ntick tình trạng thiết bị & nhập ghi chú, nhấn "Lưu"
activate GUI_Form
    GUI_Form -> GUI_Form: Kiểm tra tính hợp lệ\n(contractId bắt buộc, beds.length >= 1)

    alt Hợp lệ
        GUI_Form -> BUS: create(CreateHandoverDTO)
        activate BUS
            BUS -> DAO: insert(contractId, type, beds, note)
            activate DAO
            deactivate DAO
        deactivate BUS
        GUI_Form --> Admin: Thông báo "Tạo biên bản thành công"
        GUI_Form -> GUI_List: Tải lại danh sách
    end
deactivate GUI_Form

' ============================================================
== Kịch bản 3: Admin xem chi tiết biên bản ==
' ============================================================

Admin -> GUI_List: Chọn một biên bản trong danh sách
activate GUI_List
    GUI_List -> BUS: getById(id)
    activate BUS
        BUS -> DAO: getById(id)
        activate DAO
        deactivate DAO
    deactivate BUS
    note right of GUI_List: Hiển thị chi tiết biên bản bằng HandoverReportDTO\n(từng giường, từng thiết bị, trạng thái, ghi chú)
deactivate GUI_List

@enduml
