@startuml DangNhap_SequenceDiagram
title Sequence Diagram - UC12: Đăng nhập

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    ParticipantPadding 20
    BoxPadding 10
}

actor "Khách hàng / Nhân viên" as Actor
boundary "Login" as GUI <<boundary>>
participant "SignInDTO" as DTO <<dto>>
control "User" as BUS <<control>>
database "UserDB" as DB <<database>>
participant "SignInResponseDTO" as RES <<dto>>

autonumber

Actor -> GUI: Nhập thông tin & Click "Đăng nhập"
GUI -> GUI: handleLogin()
GUI -> DTO **: new SignInDTO(email, password)
GUI -> BUS: signIn(signInDTO)
BUS -> DB: fetchCredentialByEmail(signInDTO.email)
DB --> BUS: User (Model)
BUS -> BUS: verifyPassword()
alt Mật khẩu hợp lệ
    BUS -> BUS: generateJWT()
    BUS -> RES **: new SignInResponseDTO(token)
    BUS --> GUI: SignInResponseDTO
    GUI -> GUI: Lưu Token vào LocalStorage
    GUI -> GUI: Chuyển hướng đến trang chủ
else Mật khẩu không hợp lệ
    BUS --> GUI: null
    GUI --> Actor: Hiển thị thông báo "Sai mật khẩu"
end
deactivate GUI

@enduml

