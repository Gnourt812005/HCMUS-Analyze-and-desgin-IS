@startuml DangNhap_ClassDiagram
title Class Diagram - UC12: Đăng nhập

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenLogin" as ScreenLogin <<boundary>> {
    - txtEmail: TextBox
    - txtPassword: TextBox
    - btnLogin: Button
    + btnLoginClick(): void
}

' --- DTO LAYER ---
class "SignInDTO" as SignInDTO <<dto>> {
    + email: string
    + password: string
}

class "SignInResponseDTO" as SignInResponseDTO <<dto>> {
    + token: string
}

' --- BUSINESS LAYER ---
class "User" as User <<control>> {
    - email: string
    - fullName: string
    - password: string
    - cccd: string
    - birthday: string
    - gender: string
    - phone: string
    - address: string
    + <<static>> signIn(data: SignInDTO): SignInResponseDTO
    + toDTO(): UserDTO
}

' --- DATABASE LAYER ---
class "UserDB" as UserDB <<entity>> {
    + <<static>> fetchCredentialByEmail(email: string): User
}

' --- RELATIONSHIPS ---
ScreenLogin ..> SignInDTO : <<creates>>
ScreenLogin "1" --> "1" User
User ..> SignInResponseDTO : <<creates>>
User "1" --> "1" UserDB

@enduml
