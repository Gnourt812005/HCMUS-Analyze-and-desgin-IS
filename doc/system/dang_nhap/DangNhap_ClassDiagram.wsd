@startuml DangNhap_ClassDiagram
title Class Diagram - UC12: Đăng nhập

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenLogin" as ScreenLogin <<boundary>> {
    - txtEmail: TextBox
    - txtPassword: TextBox
    - btnLogin: Button
    + btnLoginClick(): void
}

' --- BUSINESS LAYER ---
class "User" as User <<control>> {
    - email: string
    - password: string
    + <<static>> login(email: string, password: string): boolean
}

' --- DATABASE LAYER ---
class "UserDB" as UserDB <<entity>> {
    + <<static>> checkCredentials(email: string, password: string): boolean
}

' --- RELATIONSHIPS ---
ScreenLogin "1" --> "1" User
User "1" --> "1" UserDB

@enduml
