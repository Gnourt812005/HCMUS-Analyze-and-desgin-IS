@startuml Dormarch_ClassDiagram_XemPhong_Perfect
title Class Diagram - UC1, 2, 3, 6: Xem KTX, Lọc Phòng và Đặt Lịch (Strict BCE)

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 18
    Padding 5
    Nodesep 60
    Ranksep 80
}

' ==========================================
' 1. SHARED LAYER (DTOs)
' ==========================================
package "Data Transfer Objects" <<Rectangle>> {
    class "DormSelectionDTO" as DormSelectionDTO <<DTO>> {
        + id: string
        + name: string
        + address: string
        + status: string
        + availableRooms: int
        + totalRooms: int
    }

    class "RoomBriefDTO" as RoomBriefDTO <<DTO>> {
        + id: string
        + name: string
        + block: string
        + price: decimal
        + availableBeds: int
        + totalBeds: int
        + imageUrl: string
    }

    class "RoomDetailDTO" as RoomDetailDTO <<DTO>> {
        + id: string
        + dormId: string
        + name: string
        + block: string
        + floor: int
        + price: decimal
        + totalBeds: int
        + availableBeds: int
        + amenities: List<string>
        + favoriteCount: int
        + isFavorite: bool
    }

    class "LocalRoomFilterCriteria" as LocalRoomFilterCriteria <<DTO>> {
        + priceRange: Tuple<decimal, decimal>
        + block: string
        + availableBeds: int
        + totalBeds: int
    }
}

' ==========================================
' 2. BOUNDARY LAYER (FRONTEND VIEWS)
' ==========================================
class "ScreenDormsView" as ScreenDormsView <<boundary>> {
    - gridDorms: GridView
    + showDormsList(): void
    + gridDormsCellClick(dormId: string): void
}

class "ScreenRoomsView" as ScreenRoomsView <<boundary>> {
    - gridRooms: GridView
    - sliderPriceRange: RangeSlider
    - cbbBlockSelect: ComboBox
    - numAvailableBeds: NumericUpDown
    - numTotalBeds: ComboBox
    - btnApplyFilter: Button

    + showRoomsList(dormId: string): void
    + btnApplyFilterClick(): void
    + gridRoomsCellClick(roomId: string): void
}

class "ScreenRoomDetailsView" as ScreenRoomDetailsView <<boundary>> {
    - imgRoom: PictureBox
    - lblRoomName: Label
    - lblPrice: Label
    - lblBlock: Label
    - lblFloor: Label
    - lblTotalBeds: Label
    - lblAvailableBeds: Label
    - txtAmenities: TextBlock
    
    - btnFavorite: IconButton
    - btnOpenPreviewForm: Button

    + showRoomDetails(roomData: RoomDetailDTO): void
    + btnFavoriteClick(): void
    + btnOpenPreviewFormClick(): void
}

class "ScreenPreviewRequestView" as ScreenPreviewRequestView <<boundary>> {
    - datepickerPreviewDate: DateTimePicker
    - timepickerPreviewTime: TimePicker
    - btnConfirmPreview: Button

    + showPreviewRequestScreen(): void
    + btnConfirmPreviewClick(date: string, time: string): void
}

' ==========================================
' 3. CONTROL LAYER (BUSINESS LOGIC / DOMAIN MODELS)
' ==========================================
class "Dorm" as Dorm <<control>> {
    + id: string
    + name: string
    + address: string
    + phone: string
    + status: string
    + totalRooms: int
    + availableRooms: int

    + <<static>> getAll(query: any): {dorms: List<DormDTO>, total: int}
}

class "Room" as Room <<control>> {
    + id: string
    + dormId: string
    + name: string
    + block: string
    + floor: int
    + price: decimal
    + totalBeds: int
    + availableBeds: int
    + amenities: List<string>
    + imageUrl: string

    + <<static>> fetchAll(query: any): {rooms: List<RoomDTO>, total: int}
}

class "Favourite" as Favourite <<control>> {
    + userId: string
    + roomId: string
    + createdAt: string

    + <<static>> addFavourite(userId: string, roomId: string): int
    + <<static>> deleteFavourite(userId: string, roomId: string): int
}

class "PreviewForm" as PreviewForm <<control>> {
    + id: string
    + roomId: string
    + userId: string
    + previewDatetime: string
    + status: string
    + staffId: string

    + <<static>> createPreviewForm(userId: string, roomId: string, previewDatetime: string): {code: int, data: any}
}

' ==========================================
' 4. ENTITY LAYER (DATABASE)
' ==========================================
class "DormDB" as DormDB <<entity>> {
    + <<static>> fetchAll(query: any): {dorms: List<any>, total: int}
}

class "RoomDB" as RoomDB <<entity>> {
    + <<static>> fetchAll(query: any): {rooms: List<any>, total: int}
}

class "FavouriteRoomsDB" as FavouriteRoomsDB <<entity>> {
    + <<static>> insert(userId: string, roomId: string): boolean
    + <<static>> delete(userId: string, roomId: string): boolean
}

class "PreviewFormDB" as PreviewFormDB <<entity>> {
    + <<static>> getAll(): List<any>
    + <<static>> insert(data: any): boolean
}

class "UserDB (Staff)" as UserDB <<entity>> {
    + <<static>> fetchEmployeesByRole(role: string): List<any>
}

' ==========================================
' RELATIONSHIPS
' ==========================================

' 1. Luồng điều hướng UI (UI Flow)
ScreenDormsView ..> ScreenRoomsView : "navigates to >"
ScreenRoomsView ..> ScreenRoomDetailsView : "navigates to (Modal) >"
ScreenRoomDetailsView ..> ScreenPreviewRequestView : "navigates to (Modal) >"

' 2. DTO Usage
ScreenDormsView ..> DormSelectionDTO : "displays list >"
ScreenRoomsView ..> RoomBriefDTO : "displays list >"
ScreenRoomDetailsView ..> RoomDetailDTO : "displays detail >"

' 3. Sử dụng Filter cục bộ (Theo src code RoomList.tsx)
ScreenRoomsView ..> LocalRoomFilterCriteria : "uses local filter >"

' 4. Boundary gọi Control (Backend Calls)
ScreenDormsView "1" --> "1" Dorm : "fetch dorms"
ScreenRoomsView "1" --> "1" Room : "fetch rooms"
ScreenRoomDetailsView "1" --> "1" Favourite : "add/delete favorite"
ScreenPreviewRequestView "1" --> "1" PreviewForm : "submit preview form"

' 5. Control gọi Entity (Database Operations)
Dorm "1" --> "1" DormDB
Room "1" --> "1" RoomDB
Favourite "1" --> "1" FavouriteRoomsDB

PreviewForm "1" --> "1" PreviewFormDB : "CRUD forms"
PreviewForm "1" --> "1" UserDB : "fetch sales staff"

@enduml
