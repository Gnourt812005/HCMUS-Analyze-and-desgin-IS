@startuml DangXuat_ClassDiagram
title Class Diagram - UC13: Đăng xuất

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenHome" as ScreenHome <<boundary>> {
    - btnLogout: Button
    + btnLogoutClick(): void
}

' --- BUSINESS LAYER ---
class "User" <<control>> {
    + <<static>> logout(): boolean
}

' --- RELATIONSHIPS ---
ScreenHome "1" --> "1" User

@enduml
