@startuml TinhHoanCocKhauTru_SequenceDiagram
title Sequence Diagram - UC24: Tính khoản hoàn cọc và khấu trừ

skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
}

autonumber

actor "Quản lý" as manager
boundary "ScreenRefundCalculation" as screen
control "CheckoutRequest" as request
control "Rental" as rental
control "Contract" as contract
control "RefundCalculation" as refund
database "CheckoutRequestDB" as requestDb
database "RentalDB" as rentalDb
database "ContractDB" as contractDb
database "RefundCalculationDB" as refundDb

manager -> screen: show(requestId)
activate screen
activate manager
screen -> request: getById(requestId)
activate request
request -> requestDb: getById(requestId)
activate requestDb
requestDb --> request: CheckoutRequest
deactivate requestDb
request --> screen: CheckoutRequest
deactivate request

screen -> rental: getRentalFormById(rentalFormId)
activate rental
rental -> rentalDb: getRentalFormById(rentalFormId)
activate rentalDb
rentalDb --> rental: Rental
deactivate rentalDb
rental --> screen: Rental
deactivate rental

screen -> contract: getByRentalFormId(rentalFormId)
activate contract
contract -> contractDb: getByRentalFormId(rentalFormId)
activate contractDb
contractDb --> contract: Contract | null
deactivate contractDb
contract --> screen: Contract | null
deactivate contract
deactivate screen
deactivate manager

manager -> screen: Nhập hư hỏng và phí phát sinh
activate screen
manager -> screen: Nhấn "Tính toán"
deactivate screen

manager -> screen: Nhấn "Lưu bảng đối soát"
activate screen

alt Cập nhật bảng tính hiện tại
  screen -> refund: update(calculationId, data)
  activate refund
  refund -> refundDb: update(calculationId, data)
  activate refundDb
  refundDb --> refund: RefundCalculation
  deactivate refundDb
  refund --> screen: RefundCalculation
  deactivate refund
else Tạo bảng tính mới
  screen -> refund: create(data)
  activate refund
  refund -> refundDb: create(data)
  activate refundDb
  refundDb --> refund: RefundCalculation
  deactivate refundDb
  refund --> screen: RefundCalculation
  deactivate refund
end

screen --> manager: Thông báo thành công
deactivate screen

@enduml
