@startuml TinhHoanCocKhauTru_SequenceDiagram
title Sequence Diagram - UC24: Tính khoản hoàn cọc và khấu trừ

skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
}

autonumber

actor "Quản lý" as manager
boundary "ScreenRefundCalculation" as screen
control "Contract" as contract
control "RefundCalculation" as refund
control "CheckoutRequest" as request
database "ContractDB" as contractDb
database "RefundCalculationDB" as refundDb
database "CheckoutRequestDB" as requestDb

manager -> screen: show(requestId)
activate screen
screen -> contract: getByContractId(contractId)
activate contract
contract -> contractDb: getByContractId(contractId)
activate contractDb
contractDb --> contract: Contract
deactivate contractDb
contract --> screen: Contract
deactivate contract
deactivate screen

manager -> screen: Nhập hư hỏng và phí phát sinh
activate screen
manager -> screen: Nhấn "Tính toán"
deactivate screen

manager -> screen: Nhấn "Lưu bảng đối soát"
activate screen
screen -> refund: create(data)
activate refund
refund -> refundDb: create(data)
activate refundDb
refundDb --> refund: RefundCalculation
deactivate refundDb
refund --> screen: RefundCalculation
deactivate refund

screen --> manager: Thông báo thành công
deactivate screen

@enduml
