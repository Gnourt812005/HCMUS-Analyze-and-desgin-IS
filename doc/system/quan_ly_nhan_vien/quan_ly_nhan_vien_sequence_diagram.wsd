@startuml QuanLyNhanVien_SequenceDiagram
title Sequence Diagram - UC17: Quản lý nhân viên (UC17)

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    ParticipantPadding 20
    BoxPadding 10
}

actor "Nhân viên quản lý" as Actor
boundary "ScreenEmployeeManagement" as MainGUI <<boundary>>
boundary "ScreenEmployeeDetail" as DetailGUI <<boundary>>
boundary "PopupConfirm" as Popup <<boundary>>
control "Employee" as BUS <<control>>
database "EmployeeDB" as DB <<database>>

autonumber

== Kịch bản 1: Xem danh sách nhân viên ==
Actor -> MainGUI: Chọn tab "Nhân viên"
MainGUI -> BUS: getEmployees()
BUS -> DB: fetchAll()
DB --> BUS: Danh sách nhân viên
BUS --> MainGUI: Dữ liệu
MainGUI --> Actor: Hiển thị danh sách

== Kịch bản 2: Thêm mới nhân viên ==
Actor -> MainGUI: Nhấn "Thêm nhân viên"
MainGUI -> DetailGUI: showForm("Thêm mới")

Actor -> DetailGUI: Nhập thông tin (Email, Mật khẩu, Tên...)
Actor -> DetailGUI: Nhấn "Lưu" (btnSaveClick)

DetailGUI -> DetailGUI: validate()
alt Dữ liệu không hợp lệ
    DetailGUI --> Actor: Hiển thị thông báo lỗi
else Hợp lệ
    DetailGUI -> BUS: createEmployee(data)
    BUS -> DB: checkEmailExists(email)
    alt Email đã tồn tại
        DB --> BUS: Trả về true
        BUS --> DetailGUI: Thông báo lỗi ("Email đã tồn tại")
    else Email chưa tồn tại
        DB --> BUS: Trả về false
        BUS -> DB: insert(data)
        DB --> BUS: Thành công
        BUS --> DetailGUI: Trả về kết quả (Thành công)
        DetailGUI --> Actor: Thông báo thành công
        DetailGUI -> MainGUI: refreshList()
    end
end

== Kịch bản 3: Cập nhật thông tin nhân viên ==
Actor -> MainGUI: Nhấn biểu tượng "Sửa"
MainGUI -> BUS: getEmployeeDetail(id)
BUS -> DB: fetchById(id)
DB --> BUS: Dữ liệu nhân viên
BUS --> MainGUI: Trả về kết quả
MainGUI -> DetailGUI: showForm("Cập nhật", data)

Actor -> DetailGUI: Chỉnh sửa thông tin
Actor -> DetailGUI: Nhấn "Cập nhật" (btnUpdateClick)
DetailGUI -> DetailGUI: validate()

alt Dữ liệu không hợp lệ
    DetailGUI --> Actor: Hiển thị thông báo lỗi
else Hợp lệ
    DetailGUI -> BUS: updateEmployee(id, data)
    BUS -> DB: update(id, data)
    DB --> BUS: Thành công
    BUS --> DetailGUI: Thành công
    DetailGUI --> Actor: Thông báo thành công
    DetailGUI -> MainGUI: refreshRow()
end

== Kịch bản 4: Xóa nhân viên ==
Actor -> MainGUI: Nhấn biểu tượng "Xóa"
MainGUI -> Popup: showConfirm()
Actor -> Popup: Nhấn "Xác nhận" (btnConfirmClick)

Popup -> BUS: deleteEmployee(id)
BUS -> DB: remove(id)
DB --> BUS: Thành công
BUS --> Popup: Thành công

Popup --> Actor: Hiển thị thông báo thành công
Popup -> MainGUI: removeRow()


@enduml
