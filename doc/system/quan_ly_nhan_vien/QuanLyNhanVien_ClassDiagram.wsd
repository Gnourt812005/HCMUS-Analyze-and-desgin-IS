@startuml QuanLyNhanVien_ClassDiagram
title Class Diagram - UC17: Quản lý nhân viên

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "AdminStaff" <<boundary>> {
    - staff: UserProfileDTO[]
    - setStaff: void
    - loading: boolean
    - setLoading: void
    - searchQuery: string
    - setSearchQuery: void
    + fetchStaff(): void
    + handleDelete(email: string): void
}

class "AdminStaffDetail" <<boundary>> {
    - formData: UserDTO
    - setFormData: void
    - loading: boolean
    - setLoading: void
    - isSubmitting: boolean
    - setIsSubmitting: void
    + fetchStaff(): void
    + handleSubmit(): void
}

' --- DTO LAYER ---
interface "UserProfileDTO" <<dto>> {
    + email: string
    + fullName: string
    + phone: string
    + role: string
    + address: string
}

interface "UserDTO" <<dto>> {
    + email: string
    + fullName: string
    + role: string
    + phone?: string
    + address?: string
    + cccd?: string
    + gender?: string
    + birthday?: string
    + password?: string
}

' --- BUSINESS LAYER ---
class "User" <<control>> {
    - email: string
    - fullName: string
    - role: string
    + <<static>> getAllEmployees(query: any): UserProfileDTO[]
    + <<static>> getEmployeeByEmail(email: string): UserProfileDTO
    + <<static>> upsertEmployee(data: UserDTO): boolean
    + <<static>> deleteEmployee(email: string): boolean
}

' --- DATABASE LAYER ---
class "UserDB" <<entity>> {
    + <<static>> fetchAllStaff(query: any): User[]
    + <<static>> fetchCredentialByEmail(email: string): User
    + <<static>> delete(email: string): boolean
    + <<static>> update(email: string, data: any): boolean
    + <<static>> insert(data: User): boolean
}

' --- RELATIONSHIPS ---
AdminStaff --> User
AdminStaffDetail --> User
User --> UserDB
AdminStaff ..> AdminStaffDetail

@enduml

