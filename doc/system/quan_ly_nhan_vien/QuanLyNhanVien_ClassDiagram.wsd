@startuml QuanLyNhanVien_ClassDiagram
title Class Diagram - UC17: Quản lý nhân viên

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "AdminStaff" <<boundary>> {
    - staff: UserProfileDTO[]
    - setStaff: void
    - loading: boolean
    - setLoading: void
    - searchQuery: string
    - setSearchQuery: void
    + btnAddStaff: Button
    + txtSearch: Input
    + tblStaff: Table
    + btnEdit: Button
    + btnDelete: Button
    + fetchStaff(): void
    + handleDelete(email: string): void
}

class "AdminStaffDetail" <<boundary>> {
    - staff: UserProfileDTO | null
    - setStaff: void
    - loading: boolean
    - setLoading: void
    - isEditing: boolean
    - setIsEditing: void
    - formData: UserProfileDTO
    - setFormData: void
    + lblStaffName: Label
    + btnBack: Button
    + txtFullName: Input
    + txtEmail: Input
    + txtPhone: Input
    + selRole: Select
    + txtAddress: Input
    + btnSave: Button
    + fetchData(): void
    + handleSave(): void
}

' --- DTO LAYER ---
interface "UserProfileDTO" <<dto>> {
    + email: string
    + fullName: string
    + phone: string
    + role: string
    + address: string
    + dormId?: string
}

interface "UserDTO" <<dto>> {
    + email: string
    + fullName: string
    + role: string
    + phone?: string
    + address?: string
    + cccd?: string
    + gender?: string
    + birthday?: string
    + password?: string
    + dormId?: string
}

interface "DormDTO" <<dto>> {
    + id: string
    + name: string
}

' --- BUSINESS LAYER ---
class "User" <<control>> {
    - email: string
    - fullName: string
    - role: string
    - dormId?: string
    + <<static>> getAllEmployees(query: any): UserProfileDTO[]
    + <<static>> getEmployeeByEmail(email: string): UserProfileDTO
    + <<static>> upsertEmployee(data: UserDTO): boolean
    + <<static>> deleteEmployee(email: string): boolean
}

class "Dorm" <<control>> {
    + <<static>> getAll(query: any): DormDTO[]
}


' --- DATABASE LAYER ---
class "UserDB" <<entity>> {
    + <<static>> fetchAllStaff(query: any): User[]
    + <<static>> fetchCredentialByEmail(email: string): User
    + <<static>> delete(email: string): boolean
    + <<static>> update(email: string, data: any): boolean
    + <<static>> insert(data: User): boolean
}

' --- RELATIONSHIPS ---
AdminStaff --> User
AdminStaffDetail --> User
AdminStaffDetail --> Dorm
User --> UserDB
AdminStaff ..> AdminStaffDetail

@enduml

