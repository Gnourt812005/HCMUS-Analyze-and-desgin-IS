@startuml QuanLyNhanVien_ClassDiagram
title Class Diagram - UC17: Quản lý nhân viên

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "ScreenEmployeeManagement" as ScreenEM <<boundary>> {
    - dgvEmployee: GridView
    - txtSearch: TextBox
    - btnAddNew: Button
    - btnEdit: Button
    - btnDelete: Button
    + dgvEmployeeLoad(): void
    + btnSearchClick(): void
    + btnAddNewClick(): void
    + btnEditClick(): void
    + btnDeleteClick(): void
}

class "ScreenEmployeeDetail" as ScreenED <<boundary>> {
    - txtEmail: TextBox
    - txtPassword: TextBox
    - txtName: TextBox
    - txtRole: TextBox
    - txtPhone: TextBox
    - btnSave: Button
    - btnCancel: Button
    + btnSaveClick(): void
    + btnCancelClick(): void
}

class "PopupConfirm" as Popup <<boundary>> {
    - lblMessage: Label
    - btnConfirm: Button
    - btnCancel: Button
    + btnConfirmClick(): void
}

' --- BUSINESS LAYER ---
class "Employee" as Employee <<control>> {
    - id: string
    - fullName: string
    - phone: string
    - role: string
    - email: string
    - status: string
    + <<static>> getEmployees(keyword: string): List<Employee>
    + <<static>> getEmployeeDetail(id: string): Employee
    + <<static>> createEmployee(data: Employee): boolean
    + <<static>> updateEmployee(id: string, data: Employee): boolean
    + <<static>> deleteEmployee(id: string): boolean
}

' --- DATABASE LAYER ---
class "EmployeeDB" as EmployeeDB <<entity>> {
    + <<static>> fetchAll(): List
    + <<static>> fetchByKeyword(keyword: string): List
    + <<static>> fetchById(id: string): Employee
    + <<static>> insert(data: Employee): boolean
    + <<static>> update(id: string, data: Employee): boolean
    + <<static>> delete(id: string): boolean
    + <<static>> checkEmailExists(email: string): boolean
}

' --- RELATIONSHIPS ---
ScreenEM "1" --> "1" Employee
ScreenED "1" --> "1" Employee
Employee "1" --> "1" EmployeeDB
ScreenEM ..> ScreenED : Mở Form 
ScreenEM ..> Popup : Mở Popup 

@enduml
