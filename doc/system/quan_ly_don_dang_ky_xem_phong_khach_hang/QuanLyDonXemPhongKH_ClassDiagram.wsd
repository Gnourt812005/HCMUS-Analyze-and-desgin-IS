@startuml QuanLyDonXemPhongKH_ClassDiagram_Perfect
title Class Diagram - UC8, 9, 10: Quản lý đơn phòng khách hàng (Strict BCE)

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 18
    Padding 5
    Nodesep 60
    Ranksep 80
}

' ==========================================
' 1. SHARED LAYER (DTOs)
' ==========================================
package "Data Transfer Objects" <<Rectangle>> {
    class "PreviewBriefDTO" as PreviewBriefDTO <<DTO>> {
        + id: string
        + roomName: string
        + dormName: string
        + dormAddress: string
        + previewDate: string
        + previewTime: string
        + status: string
    }

    class "ClientPreviewDetailDTO" as ClientPreviewDetailDTO <<DTO>> {
        + id: string
        + roomId: string
        + roomName: string
        + dormId: string
        + dormName: string
        + dormAddress: string
        + date: string
        + time: string
        + customerInfo: Object
        + createdAt: string
    }
}

' ==========================================
' 2. BOUNDARY LAYER (UI CONCEPTS)
' ==========================================
class "EmployeePreviewScheduleManagementScreen" as PreviewManagementScreen <<boundary>> {
    - listPreviewSchedules: ListView

    + showEmployeePreviewSchedules(): void
    + listPreviewSchedulesItemClick(formId: string): void
}

class "ScreenPreviewScheduleDetailsView" as PreviewScheduleDetailsView <<boundary>> {
    - lblDormName: Label
    - lblRoomName: Label
    - lblAddress: Label
    - lblDate: Label
    - lblTime: Label
    - lblCustomerName: Label
    - lblCustomerPhone: Label

    - btnReschedule: Button
    - btnClose: IconButton

    + showPreviewScheduleDetails(formId: string): void
    + btnRescheduleClick(): void
}

class "ReschedulePreviewScreen" as ReschedulePreviewScreen <<boundary>> {
    - datepickerWantedDate: DateTimePicker
    - timepickerWantedTime: TimePicker
    
    - btnConfirmReschedule: Button
    - btnCancel: Button

    + showReschedulePreviewScreen(): void
    + btnConfirmRescheduleClick(wantedDate: string, wantedTime: string): void
}

' ==========================================
' 3. CONTROL LAYER (BUSINESS LOGIC)
' ==========================================
class "PreviewForm" as PreviewForm <<control>> {
    + formId: string
    + roomId: string
    + userId: string
    + previewDatetime: string
    + createdDatetime: string
    + status: string
    + staffId: string

    + <<static>> getPreviewsByStaffId(staffId: string): {code: int, data: any}
    + <<static>> getStaffPreviewDetails(formId: string, staffId: string): {code: int, data: any}
    + <<static>> reschedulePreviewByStaff(formId: string, staffId: string, wantedDate: string, wantedTime: string): {code: int, data: any}
    + <<static>> getRoomAndDormInfo(roomId: string): any
}

' ==========================================
' 4. ENTITY LAYER (DATABASE)
' ==========================================
class "PreviewFormDB" as PreviewFormDB <<entity>> {
    + <<static>> getAll(): List<PreviewForm>
    + <<static>> getById(formId: string): PreviewForm
    + <<static>> updateDatetime(formId: string, previewDatetime: string): boolean
}

class "RoomDB" as RoomDB <<entity>> {
    + <<static>> fetchAll(query: any): {rooms: List<any>, total: int}
}

class "DormDB" as DormDB <<entity>> {
    + <<static>> fetchAll(query: any): {dorms: List<any>, total: int}
}

class "UserDB" as UserDB <<entity>> {
    + <<static>> fetchCredentialByEmail(email: string): any
}

' ==========================================
' RELATIONSHIPS
' ==========================================

' UI Navigation 
PreviewManagementScreen ..> PreviewScheduleDetailsView : "navigates to (Modal) >"
PreviewScheduleDetailsView ..> ReschedulePreviewScreen : "navigates to (UI Form) >"

' DTO Usage
PreviewManagementScreen ..> PreviewBriefDTO : "displays list >"
PreviewScheduleDetailsView ..> ClientPreviewDetailDTO : "displays detail >"

' Boundary -> Control (Backend Calls)
PreviewManagementScreen "1" --> "1" PreviewForm : "fetch assigned list"
PreviewScheduleDetailsView "1" --> "1" PreviewForm : "fetch form details"
ReschedulePreviewScreen "1" --> "1" PreviewForm : "submit reschedule"

' Control -> Entity (Database Calls - Phản ánh đúng logic trong PreviewForm.ts)
PreviewForm "1" --> "1" PreviewFormDB : "CRUD forms"
PreviewForm "1" --> "1" RoomDB : "get room info"
PreviewForm "1" --> "1" DormDB : "get dorm info"
PreviewForm "1" --> "1" UserDB : "fetch customer info"

@enduml