@startuml QuanLyDonXemPhongKH_ClassDiagram
title Class Diagram: Quản lý đơn đăng ký xem phòng khách hàng

' --- STYLE CONFIGURATION ---
skinparam {
    ClassBackgroundColor White
    ClassBorderColor #2D3E50
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 24
    Padding 5
}

' --- BOUNDARY LAYER ---
class "EmployeePreviewScheduleManagementScreen" as PreviewManagementScreen <<boundary>> {
    - listPreviewSchedules: ListView
    - btnCreatePreviewSchedule: Button

    + showEmployeePreviewSchedules(EmployeeID: int): void
    + listPreviewSchedules_ItemClick(): int ' returns selected  PreviewFormID
    + btnCreatePreviewSchedule_Click(EmployeeID: int): void
}

class "ScreenPreviewScheduleDetailsView" as PreviewScheduleDetailsView <<boundary>> {
    - ClientID: int
    - EmployeeID: int
    - lblPreviewDate: Label

    - lblRoomID: Label
    - lblDormName: Label
    - lblBlock: Label
    - lblRoommateCount: Label
    - lblAvailSlots: Label
    - lblFavoriteCount: Label
    - txtblockUltilities: TextBlock
    - txtblockSpecialDescription: TextBlock

    - btnReschedulePreviewSchedule: Button
    - btnBack: IconButton

    + showPreviewScheduleDetails(PreviewScheduleID: int): void
    + btnBack_Click(): void
    + btnReschedulePreviewSchedule_Click(): void
}

class "CreatePreviewScheduleScreen" as CreatePreviewScreen <<boundary>> {
    - txtUserID: TextBox
    - txtRoomID: TextBox
    - datepickerPreviewDate: DateTimePicker
    - btnConfirmCreate: Button
    - btnBack: Button

    + showCreatePreviewScreen(): void
    + btnBack_Click(): void
    + btnConfirmCreate_Click(newForm: PreviewForm): bool
}

class "ReschedulePreviewScreen" as ReschedulePreviewScreen <<boundary>> {
    - datepickerPreviewDate: DateTimePicker
    - btnConfirmReschedule: Button
    - btnBack: Button

    + showReschedulePreviewScreen(): void
    + btnBack_Click(): void
    + btnConfirmReschedule_Click(newForm: PreviewForm): bool
}

' --- BUSINESS LAYER ---
class "PreviewForm" as PreviewForm <<control>> {
    - roomID: int
    - userID: int
    - previewDate: DateTime
    - employeeID: int

    + getPreviewFormsByEmployeeID(employeeID: int): List<PreviewForm>

    + getPreviewFormDetails(previewFormID: int): PreviewForm

    + createEmployeePreviewForm(roomID: int, userID: int, employeeID: int, previewDate: DateTime): bool
    + reschedulePreviewForm(previewFormID: int, newPreviewDate: DateTime): bool
}

class "Room" as Room <<control>> {
    - roomImage: byte[]
    - roomID: int
    - dormID: int
    - roomNumber: string
    - eachBedPrice: decimal
    - roommateCount: int
    - availSlots: int
    - roomUtilities: string
    - specialDescription: string

    + getRoomsList(List<int>): List<Room>
}

' --- DATABASE LAYER ---
class "PreviewFormDB" as PreviewDB <<entity>> {
    + <<static>>getPreviewFormsByEmployeeID(employeeID: int): List<PreviewForm>

    + <<static>>createEmployeePreviewForm(roomID: int, userID: int, previewDate: DateTime, employeeID: int): bool
    + <<static>>reschedulePreviewForm(previewFormID: int, newPreviewDate: DateTime): bool

    + <<static>>checkEmployeesDuplicatedPreviewDate(employeeID: int, previewDate: DateTime): bool
    + <<static>>checkRoomsDuplicatedPreviewDate(roomID: int, previewDate: DateTime): bool
}

class "RoomDB" as RoomDB <<entity>> {
    + <<static>>getRoomList(roomIDs: List<int>): List<Room>
}

class "UtilitiesDB" as UtilitiesDB <<entity>> {
    + <<static>>getUtilitiesByRoomID(roomID: int): string
}

class "BedDB" as BedDB <<entity>> {
    + <<static>>getBedPrice(roomID: int): decimal
}

' --- RELATIONSHIPS ---
' 1. Screen flows (Navigation)
PreviewManagementScreen ..> PreviewScheduleDetailsView : "navigates on item click >"
PreviewManagementScreen ..> CreatePreviewScreen : "navigates on create click >"
PreviewScheduleDetailsView ..> ReschedulePreviewScreen : "navigates on reschedule click >"

' 2. Boundary to Business connections
PreviewManagementScreen "1" --> "1" PreviewForm : "bulk fetches forms"
PreviewManagementScreen "1" --> "1" Room : "bulk fetches associated rooms"

PreviewScheduleDetailsView "1" --> "1" PreviewForm : "fetches in-memory details"
PreviewScheduleDetailsView "1" --> "1" Room : "fetches in-memory room info"

CreatePreviewScreen "1" --> "1" PreviewForm : "creates >"
ReschedulePreviewScreen "1" --> "1" PreviewForm : "reschedules >"

' 3. Business Dependencies
PreviewForm ..> Room : "extracts roomIDs to load"

' 4. Business to Database connections
PreviewForm "1" --> "1" PreviewDB : "queries/updates"
Room "1" --> "1" RoomDB : "mass fetches by IDs"

' 5. Entity / Database connections
RoomDB "1" *-- "many" UtilitiesDB : "contains >"
RoomDB "1" *-- "many" BedDB : "contains >"

@enduml
