@startuml QuanLyDonXemPhongKH_SequenceDiagram_StrictSrc
title Sequence Diagram - UC8, 9, 10: Quản lý đơn phòng KH (Strict Source Code)

' --- STYLE CONFIGURATION ---
skinparam {
    BackgroundColor White
    ArrowColor #2D3E50
    DefaultFontName "Arial"
    DefaultFontSize 16
    ParticipantPadding 15
    BoxPadding 10
}

autonumber

actor "Nhân viên Sale" as Actor
boundary "PreviewManagementScreen" as GUI_List <<boundary>>
boundary "PreviewScheduleDetailsView" as GUI_Details <<boundary>>
boundary "ReschedulePreviewScreen" as GUI_Reschedule <<boundary>>

control "PreviewForm" as BUS_Preview <<control>>

database "PreviewFormDB" as DAO_Preview <<entity>>
database "DormDB" as DAO_Dorm <<entity>>
database "RoomDB" as DAO_Room <<entity>>
database "UserDB" as DAO_User <<entity>>

== Mở danh sách đơn phòng được phân công ==
Actor -> GUI_List: Yêu cầu xem danh sách
activate GUI_List
    GUI_List -> BUS_Preview: getPreviewsByStaffId(staffId)
    activate BUS_Preview
        
        BUS_Preview -> DAO_Preview: getAll()
        activate DAO_Preview
        deactivate DAO_Preview

        loop Cho từng đơn phòng của nhân viên
            BUS_Preview -> BUS_Preview: getRoomAndDormInfo(roomId)
            
            BUS_Preview -> DAO_Dorm: fetchAll(query)
            activate DAO_Dorm
            deactivate DAO_Dorm
            
            loop Lặp qua từng KTX (cho đến khi tìm thấy phòng)
                BUS_Preview -> DAO_Room: fetchAll({ dormId })
                activate DAO_Room
                deactivate DAO_Room
            end
        end

    deactivate BUS_Preview
deactivate GUI_List

== Xem chi tiết đơn phòng ==
Actor -> GUI_List: Bấm chọn 1 đơn phòng
activate GUI_List
    GUI_List -> GUI_Details: Hiển thị màn hình chi tiết (truyền formId)
deactivate GUI_List

activate GUI_Details
    GUI_Details -> BUS_Preview: getStaffPreviewDetails(formId, staffId)
    activate BUS_Preview
        
        BUS_Preview -> DAO_Preview: getById(formId)
        activate DAO_Preview
        deactivate DAO_Preview

        BUS_Preview -> BUS_Preview: getRoomAndDormInfo(roomId)
        
        BUS_Preview -> DAO_Dorm: fetchAll(query)
        activate DAO_Dorm
        deactivate DAO_Dorm
        
        loop Lặp qua từng KTX (cho đến khi tìm thấy phòng)
            BUS_Preview -> DAO_Room: fetchAll({ dormId })
            activate DAO_Room
            deactivate DAO_Room
        end

        opt Nếu có mã khách hàng (userId)
            BUS_Preview -> DAO_User: fetchCredentialByEmail(userId)
            activate DAO_User
            deactivate DAO_User
            note right of DAO_User: Lấy Tên và Số điện thoại khách hàng
        end

    deactivate BUS_Preview
deactivate GUI_Details

== Dời lịch xem phòng ==
Actor -> GUI_Details: Bấm "Dời lịch"
activate GUI_Details
    GUI_Details -> GUI_Reschedule: Hiển thị form dời lịch
deactivate GUI_Details

activate GUI_Reschedule
    Actor -> GUI_Reschedule: Nhập ngày/giờ mới & "Xác nhận dời"
    GUI_Reschedule -> BUS_Preview: reschedulePreviewByStaff(formId, staffId, wantedDate, wantedTime)
    
    activate BUS_Preview
        BUS_Preview -> DAO_Preview: getById(formId)
        activate DAO_Preview
        deactivate DAO_Preview

        BUS_Preview -> BUS_Preview: Kiểm tra trạng thái form (phải là 'pending')

        BUS_Preview -> DAO_Preview: updateDatetime(formId, newDatetime)
        activate DAO_Preview
        deactivate DAO_Preview
    deactivate BUS_Preview
    
deactivate GUI_Reschedule

@enduml